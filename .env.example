# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_erp?schema=public
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=4000
UPLOAD_DIR=./uploads

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Mobile (use your machine's LAN IP so a phone can reach the API)
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api

# Notifications (API)
# Secret presented by Vercel Cron / curl to run the daily jobs; jobs are disabled when unset
CRON_SECRET=change-me-too
# IANA zone used for "today" in the DPR reminder and digest
NOTIFICATION_TIMEZONE=Asia/Kolkata
# Email digest: set RESEND_API_KEY to send through Resend; unset = digest is logged only
# RESEND_API_KEY=
# EMAIL_FROM=Construction ERP <no-reply@yourdomain.com>
# Link used in digest emails
WEB_URL=http://localhost:3000
# Optional: Expo access token when push security is enforced on the Expo project
# EXPO_ACCESS_TOKEN=
# Run the jobs inside the API process (Docker / Railway); on Vercel use the crons in apps/api/vercel.json
# NOTIFICATION_JOBS_INPROCESS=true
# DPR_REMINDER_TIME=17:00
# APPROVAL_DIGEST_TIME=09:00
