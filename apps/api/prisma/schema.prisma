// Construction ERP - MVP data model
// Multi-tenant from day one: every tenant-scoped table carries organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (mirrored as string unions in packages/shared) ----------

enum ProjectType {
  ROAD
  BUILDING
  WATER_SUPPLY
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum MaterialPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// RECEIPT = goods received (GRN) against an approved material request, ISSUE = handed out for use at site,
/// ADJUSTMENT = opening stock or a physical-count correction (either sign).
enum StockEntryType {
  RECEIPT
  ISSUE
  ADJUSTMENT
}

enum EquipmentOwnership {
  OWNED
  HIRED
}

/// What the equipment's rate is quoted per (hire rate for hired machines, internal charge-out rate for owned ones).
enum EquipmentRateUnit {
  HOUR
  DAY
  MONTH
}

/// Site expense heads. Kept short so the accounts team can map them to ledgers.
enum ExpenseCategory {
  FUEL
  TRANSPORT
  REPAIRS
  MATERIAL_LOCAL
  LABOUR
  FOOD_WELFARE
  TRAVEL
  RENT_UTILITIES
  OFFICE
  SAFETY
  OTHER
}

enum VendorKind {
  SUPPLIER
  HIRE_AGENCY
  SUBCONTRACTOR
  LABOUR_CONTRACTOR
  SERVICE
}

/// MSME (Udyam) category; bills of micro and small enterprises are due within 45 days
enum MsmeCategory {
  MICRO
  SMALL
  MEDIUM
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CARD
  CREDIT
}

enum Weather {
  SUNNY
  CLOUDY
  RAINY
  WINDY
  HOT
}

enum NotificationType {
  SUBMISSION_SUBMITTED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SUBMISSION_CHANGES_REQUESTED
  DPR_REMINDER
  APPROVAL_DIGEST
  LOW_STOCK
  RISK_RAISED
}

/// DELAY = has held up work (days lost, responsible party); RISK = might (probability × impact).
enum RiskKind {
  DELAY
  RISK
}

enum RiskCategory {
  LAND
  DESIGN
  CLIENT
  MATERIAL
  LABOUR
  EQUIPMENT
  WEATHER
  FINANCE
  STATUTORY
  SAFETY
  UTILITY
  OTHER
}

enum RiskStatus {
  OPEN
  MONITORING
  CLOSED
}

/// Who a delay is attributable to (decides whether an extension of time can be claimed).
enum DelayParty {
  CLIENT
  CONTRACTOR
  THIRD_PARTY
  FORCE_MAJEURE
}

enum PasswordTokenPurpose {
  INVITE
  RESET
}

/// Where an approved RA bill is with the client: prepared and approved (NOT_SENT), sent, certified, paid.
enum BillStage {
  NOT_SENT
  SENT
  CERTIFIED
  PAID
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

// ---------- Tenancy, users, roles ----------

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  roles             Role[]
  projects          Project[]
  boqItems          BoqItem[]
  activities        Activity[]
  progressEntries   ProgressEntry[]
  dailyReports      DailyReport[]
  materialRequests  MaterialRequest[]
  attachments       Attachment[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  attendanceSheets  AttendanceSheet[]
  items             Item[]
  stockEntries      StockEntry[]
  stockTxns         StockTxn[]
  stockMinLevels    StockMinLevel[]
  equipment         Equipment[]
  machineryLogs     MachineryLog[]
  expenses          Expense[]
  risks             Risk[]
  activityTemplates ActivityTemplate[]
  approvalRules     ApprovalRule[]
  passwordTokens    PasswordToken[]
  measurements      MeasurementSheet[]
  labourRates       LabourRate[]
  clients           Client[]
  vendors           Vendor[]
  quotations        Quotation[]
  purchaseOrders    PurchaseOrder[]
  vendorBills       VendorBill[]
  workOrders        WorkOrder[]
  subcontractBills  SubcontractBill[]
  raBills           RaBill[]
  receipts          Receipt[]
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// System role key, e.g. ADMIN, PROJECT_MANAGER. Permissions derive from this in code.
  key            String
  name           String
  createdAt      DateTime     @default(now())

  users         User[]
  approvalRules ApprovalRule[]

  @@unique([organizationId, key])
}

/// Approval matrix row: users with this role may approve this submission type up to `maxAmount` (null = no limit).
/// An organisation with no rows uses the fixed rule (APPROVER_ROLES, no limit). Admin can always approve.
model ApprovalRule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// SubmissionType: PROGRESS | DPR | MATERIAL_REQUEST | MACHINERY | EXPENSE | MEASUREMENT | BILL | PURCHASE_ORDER | VENDOR_BILL
  submissionType String
  maxAmount      Decimal?     @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([roleId, submissionType])
  @@index([organizationId])
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  email          String
  passwordHash   String
  fullName       String
  phone          String?
  isActive       Boolean      @default(true)
  /// Set when invited; cleared once the user chooses a password.
  invitedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships          ProjectMember[]
  managedProjects      Project[]          @relation("ProjectManager")
  responsibleFor       Activity[]         @relation("ActivityResponsible")
  submittedProgress    ProgressEntry[]    @relation("ProgressSubmitter")
  reviewedProgress     ProgressEntry[]    @relation("ProgressReviewer")
  submittedReports     DailyReport[]      @relation("DprSubmitter")
  reviewedReports      DailyReport[]      @relation("DprReviewer")
  submittedRequests    MaterialRequest[]  @relation("MrSubmitter")
  reviewedRequests     MaterialRequest[]  @relation("MrReviewer")
  uploadedAttachments  Attachment[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  pushTokens           PushToken[]
  passwordTokens       PasswordToken[]
  recordedAttendance   AttendanceSheet[]  @relation("AttendanceRecorder")
  updatedAttendance    AttendanceSheet[]  @relation("AttendanceUpdater")
  stockEntries         StockEntry[]
  stockMinLevels       StockMinLevel[]
  submittedMachinery   MachineryLog[]     @relation("MachinerySubmitter")
  reviewedMachinery    MachineryLog[]     @relation("MachineryReviewer")
  submittedExpenses    Expense[]          @relation("ExpenseSubmitter")
  reviewedExpenses     Expense[]          @relation("ExpenseReviewer")
  submittedMeasures    MeasurementSheet[] @relation("MeasurementSubmitter")
  reviewedMeasures     MeasurementSheet[] @relation("MeasurementReviewer")
  submittedBills       RaBill[]           @relation("BillSubmitter")
  reviewedBills        RaBill[]           @relation("BillReviewer")
  receiptsRecorded     Receipt[]          @relation("ReceiptCreator")
  quotationsEntered    Quotation[]        @relation("QuotationCreator")
  submittedPos         PurchaseOrder[]    @relation("PoSubmitter")
  reviewedPos          PurchaseOrder[]    @relation("PoReviewer")
  submittedVendorBills VendorBill[]       @relation("VendorBillSubmitter")
  reviewedVendorBills  VendorBill[]       @relation("VendorBillReviewer")
  submittedWorkOrders  WorkOrder[]        @relation("WorkOrderSubmitter")
  reviewedWorkOrders   WorkOrder[]        @relation("WorkOrderReviewer")
  submittedSubBills    SubcontractBill[]  @relation("SubBillSubmitter")
  reviewedSubBills     SubcontractBill[]  @relation("SubBillReviewer")
  raisedRisks          Risk[]             @relation("RiskRaiser")
  ownedRisks           Risk[]             @relation("RiskOwner")

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ---------- Projects ----------

model Project {
  id                    String        @id @default(uuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id])
  code                  String
  name                  String
  type                  ProjectType
  status                ProjectStatus @default(PLANNED)
  clientName            String?
  consultantName        String?
  location              String?
  workOrderNo           String?
  description           String?
  startDate             DateTime?     @db.Date
  endDate               DateTime?     @db.Date
  contractValue         Decimal?      @db.Decimal(18, 2)
  projectManagerId      String?
  projectManager        User?         @relation("ProjectManager", fields: [projectManagerId], references: [id])
  /// Client from the client master; `clientName` keeps a copy of its name (and stays free text without one)
  clientId              String?
  client                Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // ----- Contract terms (what RA bills are built on) -----
  agreementNo           String?
  agreementDate         DateTime?     @db.Date
  /// Retention money deducted from each bill, % of the work value; released after the defect liability period
  retentionPct          Decimal       @default(0) @db.Decimal(5, 2)
  /// Security deposit deducted from each bill, % of the work value
  securityDepositPct    Decimal       @default(0) @db.Decimal(5, 2)
  /// Mobilisation advance paid by the client, recovered from bills
  mobilisationAdvance   Decimal       @default(0) @db.Decimal(18, 2)
  /// Advance recovered from each bill, % of the work value, until all of it is recovered
  advanceRecoveryPct    Decimal       @default(0) @db.Decimal(5, 2)
  defectLiabilityMonths Int?
  /// The contract has a price variation (escalation) clause
  priceVariation        Boolean       @default(false)
  /// GST charged on bills, % of the work value
  gstRate               Decimal       @default(18) @db.Decimal(5, 2)
  /// Income-tax TDS the client deducts (section 194C), % of the work value
  tdsPct                Decimal       @default(0) @db.Decimal(5, 2)
  /// GST TDS a government client deducts, % of the work value
  gstTdsPct             Decimal       @default(0) @db.Decimal(5, 2)
  /// Building and other construction workers' welfare cess, % of the work value
  labourCessPct         Decimal       @default(0) @db.Decimal(5, 2)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  members          ProjectMember[]
  boqItems         BoqItem[]
  activities       Activity[]
  progressEntries  ProgressEntry[]
  dailyReports     DailyReport[]
  materialRequests MaterialRequest[]
  notifications    Notification[]
  attendanceSheets AttendanceSheet[]
  stockEntries     StockEntry[]
  stockTxns        StockTxn[]
  stockMinLevels   StockMinLevel[]
  equipment        Equipment[]
  machineryLogs    MachineryLog[]
  expenses         Expense[]
  risks            Risk[]
  measurements     MeasurementSheet[]
  raBills          RaBill[]
  receipts         Receipt[]
  quotations       Quotation[]
  purchaseOrders   PurchaseOrder[]
  vendorBills      VendorBill[]
  workOrders       WorkOrder[]
  subcontractBills SubcontractBill[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

/// A client (employer) the organisation builds for: a government department or a private owner.
model Client {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  /// Department, division or circle that issues the work orders, e.g. "Roads Division, Khordha"
  department     String?
  gstin          String?
  pan            String?
  billingAddress String?
  /// GST state code (first two digits of the GSTIN, or set by hand)
  stateCode      String?
  contactPerson  String?
  email          String?
  phone          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projects Project[]

  @@unique([organizationId, name])
}

/// Vendor master: suppliers, hire agencies, subcontractors, labour contractors and service providers.
/// Expenses, machines and GRNs link to a vendor and keep a copy of its name.
model Vendor {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  name            String
  kinds           VendorKind[]
  gstin           String?
  pan             String?
  /// GST state code (first two digits of the GSTIN, or set by hand)
  stateCode       String?
  address         String?
  contactPerson   String?
  email           String?
  phone           String?
  bankAccountName String?
  bankAccountNo   String?
  bankIfsc        String?
  bankName        String?
  msmeCategory    MsmeCategory?
  /// Udyam registration number, UDYAM-XX-00-0000000
  udyamNo         String?
  remarks         String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  expenses       Expense[]
  equipment      Equipment[]
  stockEntries   StockEntry[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]
  workOrders     WorkOrder[]
  attendance     AttendanceLine[]

  @@unique([organizationId, name])
}

/// A vendor's quotation for an approved material request: a rate per request line. The comparative statement puts
/// the quotations of one request side by side.
model Quotation {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  /// The vendor's own quotation number
  quoteRef          String?
  quoteDate         DateTime        @db.Date
  validUntil        DateTime?       @db.Date
  deliveryDays      Int?
  paymentTerms      String?
  freight           Decimal         @default(0) @db.Decimal(18, 2)
  remarks           String?
  createdById       String
  createdBy         User            @relation("QuotationCreator", fields: [createdById], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lines          QuotationLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([materialRequestId, vendorId])
  @@index([organizationId])
}

model QuotationLine {
  id                    String              @id @default(uuid())
  quotationId           String
  quotation             Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  materialRequestItemId String
  materialRequestItem   MaterialRequestItem @relation(fields: [materialRequestItemId], references: [id], onDelete: Cascade)
  /// Rate per unit before GST
  rate                  Decimal             @db.Decimal(18, 2)
  gstRate               Decimal             @default(0) @db.Decimal(5, 2)
  remarks               String?

  @@unique([quotationId, materialRequestItemId])
}

/// Purchase order to a vendor, approved through the approval matrix (submission type PURCHASE_ORDER). GRNs receive
/// against its lines and vendor bills are matched to it.
model PurchaseOrder {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor           @relation(fields: [vendorId], references: [id])
  /// PO-<year>-0001 per organisation
  poNo              String
  poDate            DateTime         @db.Date
  materialRequestId String?
  materialRequest   MaterialRequest? @relation(fields: [materialRequestId], references: [id], onDelete: SetNull)
  quotationId       String?
  quotation         Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  deliveryBy        DateTime?        @db.Date
  deliveryAddress   String?
  paymentTerms      String?
  /// Days from the vendor's invoice to payment; micro and small enterprises are capped at 45
  paymentDays       Int?
  freight           Decimal          @default(0) @db.Decimal(18, 2)
  /// Sum of line amounts (quantity × rate)
  subtotal          Decimal          @default(0) @db.Decimal(18, 2)
  gstAmount         Decimal          @default(0) @db.Decimal(18, 2)
  /// subtotal + freight + GST
  total             Decimal          @default(0) @db.Decimal(18, 2)
  remarks           String?
  /// Short-closed: no more GRNs or bills against it
  closedAt          DateTime?
  closeNote         String?
  status            SubmissionStatus @default(DRAFT)
  submittedById     String
  submittedBy       User             @relation("PoSubmitter", fields: [submittedById], references: [id])
  submittedAt       DateTime?
  reviewedById      String?
  reviewedBy        User?            @relation("PoReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  lines        PurchaseOrderLine[]
  stockEntries StockEntry[]
  vendorBills  VendorBill[]
  attachments  Attachment[]

  @@unique([organizationId, poNo])
  @@index([organizationId, status])
  @@index([projectId, status])
}

model PurchaseOrderLine {
  id                    String               @id @default(uuid())
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  /// The material request line it orders, when raised from a request
  materialRequestItemId String?
  materialRequestItem   MaterialRequestItem? @relation(fields: [materialRequestItemId], references: [id], onDelete: SetNull)
  itemName              String
  specification         String?
  unit                  String
  quantity              Decimal              @db.Decimal(18, 3)
  rate                  Decimal              @db.Decimal(18, 2)
  gstRate               Decimal              @default(0) @db.Decimal(5, 2)
  amount                Decimal              @db.Decimal(18, 2)
  gstAmount             Decimal              @db.Decimal(18, 2)
  sortOrder             Int                  @default(0)

  stockTxns StockTxn[]
  billLines VendorBillLine[]

  @@index([purchaseOrderId])
}

/// A vendor's invoice against a purchase order, matched three ways: rates to the PO, quantities to what GRNs received.
/// Approved through the approval matrix (submission type VENDOR_BILL); paid in payables.
model VendorBill {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  /// VB-<year>-0001 per organisation
  billNo          String
  /// The vendor's invoice number and date
  invoiceNo       String
  invoiceDate     DateTime         @db.Date
  /// When payment falls due: invoice date + the PO's payment days (45 at most for micro and small enterprises)
  dueDate         DateTime         @db.Date
  freight         Decimal          @default(0) @db.Decimal(18, 2)
  subtotal        Decimal          @default(0) @db.Decimal(18, 2)
  gstAmount       Decimal          @default(0) @db.Decimal(18, 2)
  total           Decimal          @default(0) @db.Decimal(18, 2)
  /// Three-way match: no exceptions
  matched         Boolean          @default(true)
  /// What does not match (quantity over received, rate over PO, ...), one line each
  exceptions      String[]
  remarks         String?
  status          SubmissionStatus @default(DRAFT)
  submittedById   String
  submittedBy     User             @relation("VendorBillSubmitter", fields: [submittedById], references: [id])
  submittedAt     DateTime?
  reviewedById    String?
  reviewedBy      User?            @relation("VendorBillReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lines       VendorBillLine[]
  attachments Attachment[]

  @@unique([organizationId, billNo])
  @@unique([vendorId, invoiceNo])
  @@index([organizationId, status])
  @@index([projectId, status])
}

model VendorBillLine {
  id                  String            @id @default(uuid())
  billId              String
  bill                VendorBill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  quantity            Decimal           @db.Decimal(18, 3)
  rate                Decimal           @db.Decimal(18, 2)
  gstRate             Decimal           @default(0) @db.Decimal(5, 2)
  amount              Decimal           @db.Decimal(18, 2)
  gstAmount           Decimal           @db.Decimal(18, 2)
  sortOrder           Int               @default(0)

  @@index([purchaseOrderLineId])
}

/// Work order to a subcontractor or labour contractor (v3 item 22): rates per BOQ item or for its own items, with the
/// retention, advance and TDS their bills are made with. Approved through the approval matrix (submission type WORK_ORDER).
model WorkOrder {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId           String
  vendor             Vendor           @relation(fields: [vendorId], references: [id])
  /// WO-<year>-0001 per organisation
  woNo               String
  woDate             DateTime         @db.Date
  /// What the work order is for, e.g. "Brickwork and plaster, Block A"
  title              String
  startDate          DateTime?        @db.Date
  endDate            DateTime?        @db.Date
  /// GST the subcontractor charges on their bills (0 when they are not registered)
  gstRate            Decimal          @default(0) @db.Decimal(5, 2)
  retentionPct       Decimal          @default(0) @db.Decimal(5, 2)
  /// Mobilisation advance paid to them, recovered from their bills at advanceRecoveryPct
  advanceAmount      Decimal          @default(0) @db.Decimal(18, 2)
  advanceRecoveryPct Decimal          @default(0) @db.Decimal(5, 2)
  /// Income-tax TDS on their bills (section 194C: 1% for an individual or HUF, 2% otherwise)
  tdsPct             Decimal          @default(0) @db.Decimal(5, 2)
  /// Days from their bill to payment; micro and small enterprises are capped at 45
  paymentDays        Int?
  /// Sum of line amounts (quantity × rate), before GST
  value              Decimal          @default(0) @db.Decimal(18, 2)
  terms              String?
  remarks            String?
  /// Closed: no more measurements, issues or bills against it
  closedAt           DateTime?
  closeNote          String?
  status             SubmissionStatus @default(DRAFT)
  submittedById      String
  submittedBy        User             @relation("WorkOrderSubmitter", fields: [submittedById], references: [id])
  submittedAt        DateTime?
  reviewedById       String?
  reviewedBy         User?            @relation("WorkOrderReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  lines        WorkOrderLine[]
  bills        SubcontractBill[]
  measurements MeasurementSheet[]
  issues       StockEntry[]
  attachments  Attachment[]

  @@unique([organizationId, woNo])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([vendorId])
}

/// One item of a work order: a BOQ item of the project (measured in the measurement book) or the work order's own item
/// (quantity entered on each bill).
model WorkOrderLine {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  boqItemId   String?
  boqItem     BoqItem?  @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  description String
  unit        String
  quantity    Decimal   @db.Decimal(18, 3)
  rate        Decimal   @db.Decimal(18, 2)
  amount      Decimal   @db.Decimal(18, 2)
  sortOrder   Int       @default(0)

  billLines SubcontractBillLine[]

  @@unique([workOrderId, boqItemId])
  @@index([boqItemId])
}

/// Running bill N of a subcontractor under a work order: measured work (or quantities entered for the work order's own
/// items) at the work order rates, GST, and the recoveries: retention, advance, TDS, material issued to them. Approved
/// through the approval matrix (submission type SUBCONTRACT_BILL); paid in payables.
model SubcontractBill {
  id                    String           @id @default(uuid())
  organizationId        String
  organization          Organization     @relation(fields: [organizationId], references: [id])
  projectId             String
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workOrderId           String
  workOrder             WorkOrder        @relation(fields: [workOrderId], references: [id])
  /// 1, 2, 3 ... per work order
  billNo                Int
  isFinal               Boolean          @default(false)
  billDate              DateTime         @db.Date
  /// Approved measurements and material issues up to this day, not taken by an earlier bill
  measuredUpTo          DateTime         @db.Date
  /// The subcontractor's own invoice number, when they give one
  invoiceNo             String?
  /// Bill date + the work order's payment days (45 at most for micro and small enterprises)
  dueDate               DateTime         @db.Date
  grossPrevious         Decimal          @db.Decimal(18, 2)
  grossAmount           Decimal          @db.Decimal(18, 2)
  grossUpto             Decimal          @db.Decimal(18, 2)
  gstRate               Decimal          @db.Decimal(5, 2)
  gstAmount             Decimal          @db.Decimal(18, 2)
  retentionPct          Decimal          @db.Decimal(5, 2)
  advanceRecoveryPct    Decimal          @db.Decimal(5, 2)
  tdsPct                Decimal          @db.Decimal(5, 2)
  retentionAmount       Decimal          @db.Decimal(18, 2)
  advanceRecoveryAmount Decimal          @db.Decimal(18, 2)
  tdsAmount             Decimal          @db.Decimal(18, 2)
  /// Material issued to them from stock, at the item's rate
  materialRecovery      Decimal          @db.Decimal(18, 2)
  otherDeduction        Decimal          @default(0) @db.Decimal(18, 2)
  otherDeductionNote    String?
  totalDeductions       Decimal          @db.Decimal(18, 2)
  /// gross + GST - deductions
  netPayable            Decimal          @db.Decimal(18, 2)
  remarks               String?
  status                SubmissionStatus @default(DRAFT)
  submittedById         String
  submittedBy           User             @relation("SubBillSubmitter", fields: [submittedById], references: [id])
  submittedAt           DateTime?
  reviewedById          String?
  reviewedBy            User?            @relation("SubBillReviewer", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  lines        SubcontractBillLine[]
  materials    SubcontractBillMaterial[]
  measurements MeasurementSheet[]
  issues       StockEntry[]
  attachments  Attachment[]

  @@unique([workOrderId, billNo])
  @@index([organizationId, status])
  @@index([projectId, status])
}

/// One work order item on a subcontractor bill: quantity up to the previous bill, in this bill and up to date.
model SubcontractBillLine {
  id              String          @id @default(uuid())
  billId          String
  bill            SubcontractBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  workOrderLineId String
  workOrderLine   WorkOrderLine   @relation(fields: [workOrderLineId], references: [id], onDelete: Restrict)
  rate            Decimal         @db.Decimal(18, 2)
  prevQty         Decimal         @db.Decimal(18, 3)
  thisQty         Decimal         @db.Decimal(18, 3)
  uptoQty         Decimal         @db.Decimal(18, 3)
  amount          Decimal         @db.Decimal(18, 2)
  sortOrder       Int             @default(0)

  @@unique([billId, workOrderLineId])
  @@index([workOrderLineId])
}

/// Material issued to the subcontractor and recovered in a bill: quantity of one item at its rate when the bill was made.
model SubcontractBillMaterial {
  id       String          @id @default(uuid())
  billId   String
  bill     SubcontractBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item            @relation(fields: [itemId], references: [id])
  quantity Decimal         @db.Decimal(18, 3)
  rate     Decimal         @db.Decimal(18, 2)
  amount   Decimal         @db.Decimal(18, 2)

  @@unique([billId, itemId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------- Planning: BOQ and activities ----------

model BoqItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemNo         String
  description    String
  unit           String
  rate           Decimal      @db.Decimal(18, 2)
  originalQty    Decimal      @db.Decimal(18, 3)
  revisedQty     Decimal?     @db.Decimal(18, 3)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  activities     Activity[]
  measurements   MeasurementSheet[]
  billItems      RaBillItem[]
  workOrderLines WorkOrderLine[]

  @@unique([projectId, itemNo])
  @@index([organizationId])
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId      String?
  boqItem        BoqItem?     @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  name           String
  unit           String
  plannedQty     Decimal      @db.Decimal(18, 3)
  plannedStart   DateTime?    @db.Date
  plannedEnd     DateTime?    @db.Date
  responsibleId  String?
  responsible    User?        @relation("ActivityResponsible", fields: [responsibleId], references: [id])
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  progressEntries ProgressEntry[]
  stockEntries    StockEntry[]
  machineryLogs   MachineryLog[]
  expenses        Expense[]
  risks           Risk[]

  @@index([projectId])
  @@index([organizationId])
}

/// One line of an organisation's standard activity list for a project type. Applied when a project is created
/// (or later from the Activities tab); an organisation without rows for a type uses the built-in list in packages/shared.
model ActivityTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectType    ProjectType
  name           String
  unit           String
  /// Planned start in days from the project start
  startDay       Int
  durationDays   Int
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, projectType, name])
  @@index([organizationId, projectType])
}

// ---------- Site submissions (all share the same approval lifecycle) ----------

model ProgressEntry {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId     String
  activity       Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  quantity       Decimal          @db.Decimal(18, 3)
  remarks        String?
  location       String?
  manpowerCount  Int?
  machineryUsed  String?
  status         SubmissionStatus @default(DRAFT)
  submittedById  String
  submittedBy    User             @relation("ProgressSubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("ProgressReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments Attachment[]

  @@index([projectId, status])
  @@index([activityId, status])
  @@index([organizationId, status])
}

model DailyReport {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date               DateTime         @db.Date
  weather            Weather?
  siteCondition      String?
  /// [{ category: string, count: number }]
  manpower           Json             @default("[]")
  /// [{ name: string, hours: number }]
  machinery          Json             @default("[]")
  materialReceived   String?
  workExecuted       String
  testsConducted     String?
  safetyObservations String?
  issues             String?
  nextDayPlan        String?
  status             SubmissionStatus @default(DRAFT)
  submittedById      String
  submittedBy        User             @relation("DprSubmitter", fields: [submittedById], references: [id])
  submittedAt        DateTime?
  reviewedById       String?
  reviewedBy         User?            @relation("DprReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  attachments Attachment[]

  @@index([projectId, date])
  @@index([organizationId, status])
}

model MaterialRequest {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestNo      String
  requiredDate   DateTime         @db.Date
  priority       MaterialPriority @default(NORMAL)
  remarks        String?
  status         SubmissionStatus @default(DRAFT)
  submittedById  String
  submittedBy    User             @relation("MrSubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("MrReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items          MaterialRequestItem[]
  attachments    Attachment[]
  stockEntries   StockEntry[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, requestNo])
  @@index([projectId, status])
}

model MaterialRequestItem {
  id            String          @id @default(uuid())
  requestId     String
  request       MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemName      String
  specification String?
  unit          String
  quantity      Decimal         @db.Decimal(18, 3)
  sortOrder     Int             @default(0)

  stockTxns      StockTxn[]
  quotationLines QuotationLine[]
  poLines        PurchaseOrderLine[]
}

// ---------- Attendance (daily register, not an approval submission) ----------

/// Workers present on one project on one day, recorded by the site supervisor. One sheet per project per day.
/// The day's DPR takes its manpower from here; the sheet locks once that DPR is approved.
model AttendanceSheet {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  remarks        String?
  /// Sum of the lines' counts, kept in step on every save so lists can sort and total without a join.
  totalWorkers   Int          @default(0)
  recordedById   String
  recordedBy     User         @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  updatedById    String?
  updatedBy      User?        @relation("AttendanceUpdater", fields: [updatedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines AttendanceLine[]

  @@unique([projectId, date])
  @@index([organizationId, date])
}

/// Head count of one trade (category) from one contractor on the sheet's day.
model AttendanceLine {
  id         String          @id @default(uuid())
  sheetId    String
  sheet      AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  /// Labour contractor, or "Departmental" for the company's own workers
  contractor String
  /// The labour contractor in the vendor master, linked by name (null for departmental workers or a name not in it)
  vendorId   String?
  vendor     Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Trade, e.g. Mason, Helper (MANPOWER_CATEGORIES in shared; free text allowed)
  category   String
  count      Int
  sortOrder  Int             @default(0)

  @@index([sheetId])
  @@index([vendorId])
}

// ---------- Attachments and audit ----------

// ---------- Stock ----------

/// Material master per organisation. Receipts create items from the material request lines (same name and unit).
model Item {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  unit           String
  category       String?
  /// Standard rate per unit; values issues in the project cost view
  rate           Decimal?     @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  txns       StockTxn[]
  minLevels  StockMinLevel[]
  recoveries SubcontractBillMaterial[]

  @@unique([organizationId, name, unit])
}

/// One document in the store register: a GRN, an issue slip or a stock adjustment. Its lines are StockTxn rows.
model StockEntry {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type              StockEntryType
  /// GRN-2026-0001, ISS-2026-0001 or ADJ-2026-0001, numbered per organisation and type
  entryNo           String
  date              DateTime         @db.Date
  /// Receipts: the approved material request this GRN is against
  materialRequestId String?
  materialRequest   MaterialRequest? @relation(fields: [materialRequestId], references: [id])
  /// Receipts: the approved purchase order this GRN is against
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  supplier          String?
  vendorId          String?
  vendor            Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  challanNo         String?
  vehicleNo         String?
  /// Issues: who took the material (contractor, gang or person)
  issuedTo          String?
  /// Issues: the activity the material is for
  activityId        String?
  activity          Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  /// Issues: the subcontractor's work order the material went to; recovered in their next bill
  workOrderId       String?
  workOrder         WorkOrder?       @relation(fields: [workOrderId], references: [id])
  /// Issues against a work order: the subcontractor bill that recovered it
  subcontractBillId String?
  subcontractBill   SubcontractBill? @relation(fields: [subcontractBillId], references: [id], onDelete: SetNull)
  remarks           String?
  createdById       String
  createdBy         User             @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  lines       StockTxn[]
  attachments Attachment[]

  @@unique([organizationId, entryNo])
  @@index([projectId, date])
  @@index([organizationId, type, date])
}

/// Stock movement of one item in one project. Quantity is signed: receipts positive, issues negative.
/// The balance of an item in a project is the sum of its rows.
model StockTxn {
  id                    String               @id @default(uuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id])
  projectId             String
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entryId               String
  entry                 StockEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item                 @relation(fields: [itemId], references: [id])
  /// Copy of the entry's type so balances can be summed by kind without a join
  type                  StockEntryType
  date                  DateTime             @db.Date
  quantity              Decimal              @db.Decimal(18, 3)
  /// Receipts: the material request line this quantity was received against
  materialRequestItemId String?
  materialRequestItem   MaterialRequestItem? @relation(fields: [materialRequestItemId], references: [id])
  /// Receipts against a PO: the PO line received
  purchaseOrderLineId   String?
  purchaseOrderLine     PurchaseOrderLine?   @relation(fields: [purchaseOrderLineId], references: [id])
  sortOrder             Int                  @default(0)

  @@index([projectId, itemId])
  @@index([entryId])
  @@index([materialRequestItemId])
  @@index([purchaseOrderLineId])
}

/// Minimum stock of an item at a project. Falling below it raises a low-stock alert.
model StockMinLevel {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  minQty         Decimal      @db.Decimal(18, 3)
  updatedById    String
  updatedBy      User         @relation(fields: [updatedById], references: [id])
  updatedAt      DateTime     @updatedAt

  @@unique([projectId, itemId])
}

/// A machine or vehicle: owned by the company or hired. `projectId` is where it is deployed now (null = yard / unassigned).
model Equipment {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  category       String?
  ownership      EquipmentOwnership @default(OWNED)
  /// Hire agency for hired machines
  supplier       String?
  vendorId       String?
  vendor         Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  registrationNo String?
  rate           Decimal?           @db.Decimal(18, 2)
  rateUnit       EquipmentRateUnit  @default(HOUR)
  projectId      String?
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  logs MachineryLog[]

  @@unique([organizationId, code])
  @@index([organizationId, projectId])
}

/// One machine's day at one project: hours worked / idle / breakdown, diesel and hour-meter. Goes through approval.
model MachineryLog {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipmentId    String
  equipment      Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  hoursWorked    Decimal          @db.Decimal(18, 2)
  idleHours      Decimal          @default(0) @db.Decimal(18, 2)
  breakdownHours Decimal          @default(0) @db.Decimal(18, 2)
  dieselLitres   Decimal?         @db.Decimal(18, 3)
  meterStart     Decimal?         @db.Decimal(18, 2)
  meterEnd       Decimal?         @db.Decimal(18, 2)
  operatorName   String?
  activityId     String?
  activity       Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  workDone       String?
  breakdownNote  String?
  remarks        String?
  status         SubmissionStatus @default(DRAFT)
  submittedById  String
  submittedBy    User             @relation("MachinerySubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("MachineryReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments Attachment[]

  @@index([projectId, status])
  @@index([equipmentId, date])
  @@index([organizationId, status])
}

/// A site expense paid at the project (bill with GST), approved like other submissions. Approved expenses are project cost.
model Expense {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// EXP-<year>-0001 per organisation
  expenseNo      String
  date           DateTime         @db.Date
  category       ExpenseCategory
  description    String
  vendor         String?
  vendorGstin    String?
  vendorId       String?
  vendorRef      Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  billNo         String?
  /// Taxable value
  amount         Decimal          @db.Decimal(18, 2)
  gstRate        Decimal          @default(0) @db.Decimal(5, 2)
  gstAmount      Decimal          @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal          @db.Decimal(18, 2)
  paymentMode    PaymentMode      @default(CASH)
  activityId     String?
  activity       Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  remarks        String?
  status         SubmissionStatus @default(DRAFT)
  submittedById  String
  submittedBy    User             @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments Attachment[]

  @@unique([organizationId, expenseNo])
  @@index([projectId, status])
  @@index([organizationId, status])
  @@index([projectId, date])
}

/// Delay and risk register entry. Not an approval submission: it stays open, is reviewed and closed.
/// A DELAY records days lost and who caused them (for extension-of-time claims); a RISK is scored probability × impact.
model Risk {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// RISK-<year>-0001 per organisation
  riskNo           String
  kind             RiskKind
  category         RiskCategory
  title            String
  description      String?
  activityId       String?
  activity         Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  /// Who is following it up
  ownerId          String?
  owner            User?        @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// 1 (very low) to 5 (very high)
  probability      Int
  impact           Int
  /// probability × impact, stored for sorting and the heat map
  score            Int
  mitigation       String?
  /// Target date for the mitigation / next review
  dueDate          DateTime?    @db.Date
  status           RiskStatus   @default(OPEN)
  /// Delay only: when work was held up and when it resumed (null while it is still holding work up)
  delayStart       DateTime?    @db.Date
  delayEnd         DateTime?    @db.Date
  /// Delay only: days lost as agreed; computed from the dates when not given
  daysLost         Int?
  responsibleParty DelayParty?
  /// An extension of time has been claimed from the client for this delay
  eotClaimed       Boolean      @default(false)
  /// Days of extension the client granted for this delay (adds to the project's completion date)
  eotGrantedDays   Int?
  closedAt         DateTime?
  closureNote      String?
  raisedById       String
  raisedBy         User         @relation("RiskRaiser", fields: [raisedById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  attachments Attachment[]

  @@unique([organizationId, riskNo])
  @@index([projectId, status])
  @@index([organizationId, status])
}

/// A measurement book (MB) entry: one BOQ item measured at one location on one day, as dimension lines.
/// Approved sheets roll up into the BOQ item's measured (billable) quantity.
model MeasurementSheet {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId         String
  boqItem           BoqItem          @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  /// MB-<year>-0001 per organisation
  mbNo              String
  date              DateTime         @db.Date
  /// Chainage, grid, floor, zone
  location          String
  remarks           String?
  /// Sum of the lines (deductions negative), in the BOQ item's unit
  totalQty          Decimal          @db.Decimal(18, 3)
  status            SubmissionStatus @default(DRAFT)
  submittedById     String
  submittedBy       User             @relation("MeasurementSubmitter", fields: [submittedById], references: [id])
  submittedAt       DateTime?
  reviewedById      String?
  reviewedBy        User?            @relation("MeasurementReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNote        String?
  /// The RA bill this measurement was billed in (set when a bill takes it; it cannot go into another bill)
  raBillId          String?
  raBill            RaBill?          @relation(fields: [raBillId], references: [id], onDelete: SetNull)
  /// Work done by a subcontractor under this work order (the same measurement also goes to the client's RA bill)
  workOrderId       String?
  workOrder         WorkOrder?       @relation(fields: [workOrderId], references: [id])
  /// The subcontractor bill this measurement was paid in
  subcontractBillId String?
  subcontractBill   SubcontractBill? @relation(fields: [subcontractBillId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  lines       MeasurementLine[]
  attachments Attachment[]

  @@unique([organizationId, mbNo])
  @@index([projectId, status])
  @@index([boqItemId, status])
  @@index([organizationId, status])
  @@index([workOrderId])
}

/// One row of a measurement: nos × length × breadth × depth (blank dimensions count as 1); a deduction is negative.
model MeasurementLine {
  id          String           @id @default(uuid())
  sheetId     String
  sheet       MeasurementSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  description String
  nos         Decimal?         @db.Decimal(18, 3)
  length      Decimal?         @db.Decimal(18, 3)
  breadth     Decimal?         @db.Decimal(18, 3)
  depth       Decimal?         @db.Decimal(18, 3)
  deduct      Boolean          @default(false)
  quantity    Decimal          @db.Decimal(18, 3)
  sortOrder   Int              @default(0)

  @@index([sheetId])
}

/// Running account (RA) bill N of a project to its client, built from approved measurements (v3 item 18).
/// A submission like the others (six status columns, approval matrix); once approved it is sent, certified, paid.
/// Amounts are on the claimed quantities until the client certifies, then on the certified ones (claimed* keep the claim).
model RaBill {
  id                    String           @id @default(uuid())
  organizationId        String
  organization          Organization     @relation(fields: [organizationId], references: [id])
  projectId             String
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 ... per project
  billNo                Int
  isFinal               Boolean          @default(false)
  billDate              DateTime         @db.Date
  /// Approved measurements dated up to this day and not in an earlier bill are billed
  measuredUpTo          DateTime         @db.Date
  remarks               String?
  /// Value of work up to the previous bill / in this bill (taxable) / up to date
  grossPrevious         Decimal          @db.Decimal(18, 2)
  grossAmount           Decimal          @db.Decimal(18, 2)
  grossUpto             Decimal          @db.Decimal(18, 2)
  gstRate               Decimal          @db.Decimal(5, 2)
  gstAmount             Decimal          @db.Decimal(18, 2)
  // Contract percentages taken when the bill was prepared, and the deductions they give
  retentionPct          Decimal          @db.Decimal(5, 2)
  securityDepositPct    Decimal          @db.Decimal(5, 2)
  advanceRecoveryPct    Decimal          @db.Decimal(5, 2)
  tdsPct                Decimal          @db.Decimal(5, 2)
  gstTdsPct             Decimal          @db.Decimal(5, 2)
  labourCessPct         Decimal          @db.Decimal(5, 2)
  retentionAmount       Decimal          @db.Decimal(18, 2)
  securityDepositAmount Decimal          @db.Decimal(18, 2)
  advanceRecoveryAmount Decimal          @db.Decimal(18, 2)
  tdsAmount             Decimal          @db.Decimal(18, 2)
  gstTdsAmount          Decimal          @db.Decimal(18, 2)
  labourCessAmount      Decimal          @db.Decimal(18, 2)
  otherDeduction        Decimal          @default(0) @db.Decimal(18, 2)
  otherDeductionNote    String?
  totalDeductions       Decimal          @db.Decimal(18, 2)
  /// gross + GST - deductions
  netPayable            Decimal          @db.Decimal(18, 2)
  /// What was claimed, kept when the client certifies a different amount
  claimedGross          Decimal?         @db.Decimal(18, 2)
  claimedNet            Decimal?         @db.Decimal(18, 2)
  stage                 BillStage        @default(NOT_SENT)
  sentDate              DateTime?        @db.Date
  certifiedDate         DateTime?        @db.Date
  /// The client's certificate / measurement check reference
  certificateNo         String?
  paidDate              DateTime?        @db.Date
  status                SubmissionStatus @default(DRAFT)
  submittedById         String
  submittedBy           User             @relation("BillSubmitter", fields: [submittedById], references: [id])
  submittedAt           DateTime?
  reviewedById          String?
  reviewedBy            User?            @relation("BillReviewer", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  items        RaBillItem[]
  measurements MeasurementSheet[]
  attachments  Attachment[]
  receipts     Receipt[]

  @@unique([projectId, billNo])
  @@index([organizationId, status])
  @@index([projectId, status])
}

/// One BOQ item on an RA bill: quantity up to the previous bill, in this bill and up to date, at the BOQ rate.
model RaBillItem {
  id           String   @id @default(uuid())
  billId       String
  bill         RaBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  boqItemId    String
  boqItem      BoqItem  @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  /// BOQ quantity (revised, else original) and rate when the bill was prepared
  boqQty       Decimal  @db.Decimal(18, 3)
  rate         Decimal  @db.Decimal(18, 2)
  prevQty      Decimal  @db.Decimal(18, 3)
  /// Claimed in this bill (up to date measured - previous bills)
  thisQty      Decimal  @db.Decimal(18, 3)
  uptoQty      Decimal  @db.Decimal(18, 3)
  /// This bill's quantity as the client certified it (null until certified)
  certifiedQty Decimal? @db.Decimal(18, 3)
  /// (certifiedQty ?? thisQty) × rate
  amount       Decimal  @db.Decimal(18, 2)
  sortOrder    Int      @default(0)

  @@unique([billId, boqItemId])
  @@index([boqItemId])
}

/// What a receipt is for: a bill, or the release of retention or security deposit the client held
enum ReceiptKind {
  BILL
  RETENTION_RELEASE
  DEPOSIT_RELEASE
}

/// Money received from the client, with the deductions it actually made (v3 item 19)
model Receipt {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  projectId             String
  project               Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind                  ReceiptKind  @default(BILL)
  /// The bill paid (kind BILL only)
  billId                String?
  bill                  RaBill?      @relation(fields: [billId], references: [id], onDelete: Restrict)
  receiptDate           DateTime     @db.Date
  /// Credited to the bank
  amount                Decimal      @db.Decimal(18, 2)
  mode                  PaymentMode  @default(BANK)
  /// UTR, cheque or advice number
  reference             String?
  // Deducted by the client on this payment (kind BILL)
  tdsAmount             Decimal      @default(0) @db.Decimal(18, 2)
  gstTdsAmount          Decimal      @default(0) @db.Decimal(18, 2)
  retentionAmount       Decimal      @default(0) @db.Decimal(18, 2)
  securityDepositAmount Decimal      @default(0) @db.Decimal(18, 2)
  advanceRecoveryAmount Decimal      @default(0) @db.Decimal(18, 2)
  labourCessAmount      Decimal      @default(0) @db.Decimal(18, 2)
  otherDeduction        Decimal      @default(0) @db.Decimal(18, 2)
  otherDeductionNote    String?
  remarks               String?
  createdById           String
  createdBy             User         @relation("ReceiptCreator", fields: [createdById], references: [id])
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([organizationId, receiptDate])
  @@index([projectId])
  @@index([billId])
}

model Attachment {
  id                String            @id @default(uuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  fileName          String
  mimeType          String
  size              Int
  /// Storage key: absolute URL (object storage), "db:<id>" (stored in `data`), or relative path served under /uploads
  storagePath       String
  /// File bytes when stored in the database (serverless hosts without a disk or object store)
  data              Bytes?
  uploadedById      String
  uploadedBy        User              @relation(fields: [uploadedById], references: [id])
  progressEntryId   String?
  progressEntry     ProgressEntry?    @relation(fields: [progressEntryId], references: [id], onDelete: Cascade)
  dailyReportId     String?
  dailyReport       DailyReport?      @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  materialRequestId String?
  materialRequest   MaterialRequest?  @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  stockEntryId      String?
  stockEntry        StockEntry?       @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  machineryLogId    String?
  machineryLog      MachineryLog?     @relation(fields: [machineryLogId], references: [id], onDelete: Cascade)
  expenseId         String?
  expense           Expense?          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  measurementId     String?
  measurement       MeasurementSheet? @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  riskId            String?
  risk              Risk?             @relation(fields: [riskId], references: [id], onDelete: Cascade)
  raBillId          String?
  raBill            RaBill?           @relation(fields: [raBillId], references: [id], onDelete: Cascade)
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendorBillId      String?
  vendorBill        VendorBill?       @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  workOrderId       String?
  workOrder         WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  subcontractBillId String?
  subcontractBill   SubcontractBill?  @relation(fields: [subcontractBillId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())

  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     String
  entityId       String
  action         String
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id])
  note           String?
  createdAt      DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}

// ---------- Notifications ----------

/// In-app notification for one user. Push and email are delivery channels for the same row.
model Notification {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  body           String
  projectId      String?
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Submission type (PROGRESS | DPR | MATERIAL_REQUEST) when the notification points at an entry
  entityType     String?
  entityId       String?
  readAt         DateTime?
  /// When the Expo push was handed to the push service (null = not pushed / no device)
  pushedAt       DateTime?
  /// When the email for this notification was handed to the email provider
  emailedAt      DateTime?
  /// Scheduled jobs set e.g. "DPR_REMINDER:<projectId>:<date>" so a re-run never notifies twice
  dedupeKey      String?
  createdAt      DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([organizationId, type, createdAt])
}

/// One-time set-password link (invite or reset). Only a SHA-256 of the token is stored.
model PasswordToken {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        PasswordTokenPurpose
  tokenHash      String               @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime             @default(now())

  @@index([userId])
  @@index([organizationId])
}

/// Expo push token of one device of one user. A user may have several devices.
model PushToken {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String       @unique
  platform   PushPlatform
  deviceName String?
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  @@index([userId])
}

// ---------- Cost ----------

/// Daily wage per trade (attendance category), used to value attendance in the project cost view.
model LabourRate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// Matches AttendanceLine.category (case-insensitive)
  category       String
  dailyRate      Decimal      @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, category])
}
