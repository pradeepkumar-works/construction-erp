  @@index([clientId])
}

/// Money an RMC customer paid, against a bill or on account.
model RmcReceipt {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  invoiceId      String?
  invoice        RmcInvoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  date           DateTime     @db.Date
  amount         Decimal      @db.Decimal(18, 2)
  mode           PaymentMode
  reference      String?
  tallyExportId  String?
  tallyExport    TallyExport? @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User         @relation("RmcReceiptCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([clientId])
}

// ---------- Supplier portal (v6 item 105) ----------

enum SupplierInvoiceStatus {
  SUBMITTED
  RETURNED
  WITHDRAWN
}

enum SupplierChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What a supplier sent against a purchase order: their challan, the truck and the quantities. The store's GRN is
/// filled from it and then points back at it.
model SupplierDispatch {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  /// The supplier's own challan or dispatch number
  dispatchNo      String
  date            DateTime      @db.Date
  vehicleNo       String?
  /// Lorry receipt number, when a transporter carries it
  lrNo            String?
  transporter     String?
  remarks         String?
  cancelledAt     DateTime?
  createdById     String
  createdBy       User          @relation("SupplierDispatchCreator", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  lines SupplierDispatchLine[]
  grn   StockEntry?

  @@unique([vendorId, dispatchNo])
  @@index([organizationId])
  @@index([purchaseOrderId])
}

model SupplierDispatchLine {
  id                  String            @id @default(uuid())
  organizationId      String
  dispatchId          String
  dispatch            SupplierDispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  quantity            Decimal           @db.Decimal(18, 3)

  @@index([dispatchId])
  @@index([purchaseOrderLineId])
}

/// A supplier's invoice sent on the portal, waiting for accounts. A bill recorded with the same vendor and invoice
/// number is the bill made from it (so it shows as billed, then paid); accounts can also return it with a reason.
model SupplierInvoice {
  id              String                @id @default(uuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id])
  vendorId        String
  vendor          Vendor                @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  workOrderId     String?
  workOrder       WorkOrder?            @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  invoiceNo       String
  invoiceDate     DateTime              @db.Date
  /// With GST, as on the invoice
  amount          Decimal               @db.Decimal(18, 2)
  gstAmount       Decimal?              @db.Decimal(18, 2)
  notes           String?
  status          SupplierInvoiceStatus @default(SUBMITTED)
  returnNote      String?
  decidedById     String?
  decidedBy       User?                 @relation("SupplierInvoiceDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  createdById     String
  createdBy       User                  @relation("SupplierInvoiceSender", fields: [createdById], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  attachments Attachment[]

  @@unique([vendorId, invoiceNo])
  @@index([organizationId, status])
}

/// A supplier asks for their details to change; the change is made only when the company approves it.
model SupplierChangeRequest {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  vendorId       String
  vendor         Vendor               @relation(fields: [vendorId], references: [id])
  /// { field: new value } for the fields in SUPPLIER_PROFILE_FIELDS; the old values are kept in `previous`
  changes        Json
  previous       Json
  status         SupplierChangeStatus @default(PENDING)
  note           String?
  decisionNote   String?
  decidedById    String?
  decidedBy      User?                @relation("SupplierChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  createdById    String
  createdBy      User                 @relation("SupplierChangeAsker", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())

  @@index([organizationId, status])
  @@index([vendorId])
}

// ---------- Machine finance (v6 item 108) ----------

/// What the lender did with a machine loan: paid the dealer for the machine, or credited the company's bank.
enum LoanDisbursal {
  MACHINE_COST
  BANK
}

enum EquipmentLoanStatus {
  ACTIVE
  CLOSED
}

/// A loan on a financed machine (v6 item 108): its terms and the EMI schedule built from them (`loan-rules.ts`). Posts
/// to the books as a journal (Dr Plant and Machinery or the bank, Cr the loan's own ledger under Secured Loans).
model EquipmentLoan {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  equipmentId    String
  equipment      Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  /// The bank or finance company, as on the sanction letter
  lenderName     String
  /// The lender in the vendor master, when it is one
  vendorId       String?
  vendor         Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// The lender's loan account number
  loanNo         String
  sanctionDate   DateTime            @db.Date
  amount         Decimal             @db.Decimal(18, 2)
  /// Yearly rate, %
  ratePct        Decimal             @db.Decimal(6, 3)
  tenureMonths   Int
  emi            Decimal             @db.Decimal(18, 2)
  firstEmiDate   DateTime            @db.Date
  disbursal      LoanDisbursal       @default(MACHINE_COST)
  status         EquipmentLoanStatus @default(ACTIVE)
  closedOn       DateTime?           @db.Date
  note           String?
  createdById    String
  createdBy      User                @relation("EquipmentLoanCreator", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  /// The Tally export that took the loan's journal
  tallyExportId  String?
  tallyExport    TallyExport?        @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)

  emis LoanEmi[]

  @@unique([organizationId, loanNo])
  @@index([organizationId, equipmentId])
  @@index([tallyExportId])
}

/// One EMI of a machine loan's schedule: interest on what is owed at the month's start, the rest repaying the loan. Paid
/// in order; a paid EMI posts as a payment (Dr the loan with the principal, Dr interest, Cr bank or cash).
model LoanEmi {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  loanId         String
  loan           EquipmentLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  no             Int
  dueDate        DateTime      @db.Date
  opening        Decimal       @db.Decimal(18, 2)
  principal      Decimal       @db.Decimal(18, 2)
  interest       Decimal       @db.Decimal(18, 2)
  emi            Decimal       @db.Decimal(18, 2)
  closing        Decimal       @db.Decimal(18, 2)
  paidOn         DateTime?     @db.Date
  mode           PaymentMode?
  reference      String?
  paidById       String?
  paidBy         User?         @relation("LoanEmiPayer", fields: [paidById], references: [id])
  /// The Tally export that took the payment
  tallyExportId  String?
  tallyExport    TallyExport?  @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)

  @@unique([loanId, no])
  @@index([organizationId, dueDate])
  @@index([tallyExportId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Tender bidding (v6 item 110)

/// Where a schedule of rates comes from.
enum SorBookKind {
  STATE
  CPWD
  OWN
  OTHER
}

/// PREPARING while the bid is priced; SUBMITTED once it is in; then WON, LOST, DROPPED (decided not to bid) or
/// CANCELLED (the client called it off).
enum TenderStatus {
  PREPARING
  SUBMITTED
  WON
  LOST
  DROPPED
  CANCELLED
}

/// PERCENTAGE: one percentage above or below the SOR on every item; ITEM_RATE: a rate quoted for each item.
enum TenderBidType {
  PERCENTAGE
  ITEM_RATE
}

enum TenderLineKind {
  MATERIAL
  LABOUR
  EQUIPMENT
}

/// A schedule of rates: a state SOR, the CPWD DSR or the company's own rates, imported from Excel.
model SorBook {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  kind           SorBookKind
  /// Year or edition, e.g. 2024-25
  edition        String?
  /// The state or circle it applies in
  region         String?
  note           String?
  createdById    String
  createdBy      User         @relation("SorBookCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items   SorItem[]
  tenders Tender[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model SorItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  bookId         String
  book           SorBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// The item's number in the schedule, e.g. 4.1.3
  code           String
  chapter        String?
  description    String
  unit           String
  rate           Decimal      @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenderItems TenderItem[]

  @@unique([bookId, code])
  @@index([organizationId])
}

/// A tender the company bids or considers: the notice, dates, EMD, the priced bid BOQ, the bids read out at opening and
/// the result. A won tender becomes a project (projectId).
model Tender {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  /// Our own number, e.g. TND-2026-007
  tenderNo         String
  /// The client's notice inviting tender (NIT) number
  nitNo            String?
  title            String
  clientId         String?
  client           Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// The client's name (a copy of the client master's, or free text without one)
  clientName       String?
  location         String?
  bidType          TenderBidType  @default(PERCENTAGE)
  sorBookId        String?
  sorBook          SorBook?       @relation(fields: [sorBookId], references: [id], onDelete: SetNull)
  /// Put-to-tender value: the client's estimate
  estimatedValue   Decimal?       @db.Decimal(18, 2)
  /// Time for completion, in months
  completionMonths Int?
  publishedOn      DateTime?      @db.Date
  /// Last date to submit the bid
  submitBy         DateTime       @db.Date
  submittedOn      DateTime?      @db.Date
  /// When the price bids were opened
  openedOn         DateTime?      @db.Date
  /// Percentage tenders: the quote above (+) or below (-) the SOR rates, in %
  quotedPct        Decimal?       @db.Decimal(7, 2)
  /// Added to the cost of each item's rate analysis
  overheadPct      Decimal        @default(10) @db.Decimal(5, 2)
  profitPct        Decimal        @default(8) @db.Decimal(5, 2)
  tenderFee        Decimal?       @db.Decimal(18, 2)
  /// The EMD paid with the bid, kept with the guarantees
  emdDocId         String?        @unique
  emdDoc           ComplianceDoc? @relation("TenderEmd", fields: [emdDocId], references: [id], onDelete: SetNull)
  status           TenderStatus   @default(PREPARING)
  resultOn         DateTime?      @db.Date
  resultNote       String?
  projectId        String?        @unique
  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  note             String?
  createdById      String
  createdBy        User           @relation("TenderCreator", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items       TenderItem[]
  bids        TenderBid[]
  attachments Attachment[]

  @@unique([organizationId, tenderNo])
  @@index([organizationId, status, submitBy])
}

/// A line of the bid BOQ, priced from its rate analysis (TenderItemLine) or quoted against the SOR.
model TenderItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tenderId       String
  tender         Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  itemNo         String
  description    String
  unit           String
  qty            Decimal      @db.Decimal(18, 3)
  sorItemId      String?
  sorItem        SorItem?     @relation(fields: [sorItemId], references: [id], onDelete: SetNull)
  /// The SOR (estimate) rate, from the SOR item or the client's BOQ
  sorRate        Decimal?     @db.Decimal(18, 2)
  /// Item-rate tenders: the rate quoted, when not the built-up rate
  quotedRate     Decimal?     @db.Decimal(18, 2)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines TenderItemLine[]

  @@unique([tenderId, itemNo])
  @@index([organizationId])
}

/// What one unit of a bid item takes: a material (with its wastage), labour man-days or machine hours, at a rate.
model TenderItemLine {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  tenderItemId   String
  tenderItem     TenderItem     @relation(fields: [tenderItemId], references: [id], onDelete: Cascade)
  kind           TenderLineKind
  /// The store item of a material, carried to the project's material norms when the tender is won
  itemId         String?
  item           Item?          @relation(fields: [itemId], references: [id], onDelete: SetNull)
  /// The material, the trade (as labour rates keep it) or the equipment category
  name           String
  unit           String
  qtyPerUnit     Decimal        @db.Decimal(18, 6)
  wastagePct     Decimal        @default(0) @db.Decimal(5, 2)
  rate           Decimal?       @db.Decimal(18, 2)
  sortOrder      Int            @default(0)

  @@index([tenderItemId])
  @@index([organizationId])
}

/// Another bidder's price as read out when the bids were opened.
model TenderBid {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tenderId       String
  tender         Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  bidderName     String
  amount         Decimal      @db.Decimal(18, 2)
  note           String?
  createdAt      DateTime     @default(now())

  @@unique([tenderId, bidderName])
  @@index([organizationId])
}

// ---------- Subcontract enquiries (v6 item 111) ----------

enum ScEnquiryStatus {
  OPEN
  AWARDED
  CANCELLED
}

/// Subcontract enquiry SCE-<year>-0001 (v6 item 111): chosen items of a project's BOQ (or its own items) sent to several
/// subcontractors; their rates are compared item by item and in total, and the chosen quote becomes a draft work order.
model SubcontractEnquiry {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  enquiryNo      String
  title          String
  /// What the rates must include, sent with the enquiry
  scope          String?
  /// Last day to quote
  closesOn       DateTime?         @db.Date
  status         ScEnquiryStatus   @default(OPEN)
  awardedQuoteId String?           @unique
  awardedQuote   SubcontractQuote? @relation("ScAwardedQuote", fields: [awardedQuoteId], references: [id], onDelete: SetNull)
  workOrderId    String?           @unique
  workOrder      WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  /// Why this quote (not always the lowest), or why the enquiry was cancelled
  decisionNote   String?
  decidedAt      DateTime?
  createdById    String
  createdBy      User              @relation("ScEnquiryCreator", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  items  SubcontractEnquiryItem[]
  quotes SubcontractQuote[]       @relation("ScEnquiryQuotes")

  @@unique([organizationId, enquiryNo])
  @@index([organizationId, status])
  @@index([projectId])
}

/// One item asked for: a BOQ item of the project or the enquiry's own item, with the quantity to price.
model SubcontractEnquiryItem {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  enquiryId      String
  enquiry        SubcontractEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  boqItemId      String?
  boqItem        BoqItem?           @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  description    String
  unit           String
  quantity       Decimal            @db.Decimal(18, 3)
  sortOrder      Int                @default(0)

  lines SubcontractQuoteLine[]

  @@unique([enquiryId, boqItemId])
  @@index([organizationId])
}

/// A subcontractor asked to quote, and their quote once received: a rate for each item, GST on top.
model SubcontractQuote {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  enquiryId      String
  enquiry        SubcontractEnquiry @relation("ScEnquiryQuotes", fields: [enquiryId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor             @relation(fields: [vendorId], references: [id])
  /// Null until their rates are in
  receivedOn     DateTime?          @db.Date
  gstRate        Decimal            @default(0) @db.Decimal(5, 2)
  validUntil     DateTime?          @db.Date
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines     SubcontractQuoteLine[]
  awardedOn SubcontractEnquiry?    @relation("ScAwardedQuote")

  @@unique([enquiryId, vendorId])
  @@index([organizationId])
  @@index([vendorId])
}

model SubcontractQuoteLine {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  quoteId        String
  quote          SubcontractQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  itemId         String
  item           SubcontractEnquiryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  rate           Decimal                @db.Decimal(18, 2)
  note           String?

  @@unique([quoteId, itemId])
  @@index([itemId])
  @@index([organizationId])
}

/// v6 item 112: a meeting's kind, for the register and the minutes' heading.
enum MeetingKind {
  PROGRESS
  CLIENT
  SUBCONTRACTOR
  DESIGN
  SAFETY
  QUALITY
  OTHER
}

/// Minutes are a draft until issued; issued minutes are fixed and sent to those present.
enum MeetingStatus {
  DRAFT
  ISSUED
}

enum MeetingPointKind {
  NOTE
  DECISION
}

enum MeetingActionStatus {
  OPEN
  DONE
  DROPPED
}

/// A meeting on a project and its minutes (v6 item 112): who came, what was noted and decided, and the actions.
model Meeting {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// MOM-2026-0001
  meetingNo      String
  title          String
  kind           MeetingKind   @default(PROGRESS)
  heldOn         DateTime      @db.Date
  /// HH:mm
  startTime      String?
  venue          String?
  chairedBy      String?
  agenda         String?
  /// The next meeting, printed at the foot of the minutes
  nextOn         DateTime?     @db.Date
  status         MeetingStatus @default(DRAFT)
  issuedAt       DateTime?
  issuedById     String?
  issuedBy       User?         @relation("MeetingIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User          @relation("MeetingCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attendees MeetingAttendee[]
  points    MeetingPoint[]
  actions   MeetingAction[]

  @@unique([organizationId, meetingNo])
  @@index([organizationId, projectId, heldOn])
}

/// Someone at (or asked to) the meeting: one of our users, or someone from outside with their organisation.
model MeetingAttendee {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  meetingId      String
  meeting        Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation("MeetingAttendeeUser", fields: [userId], references: [id], onDelete: SetNull)
  name           String
  /// Their side: the client, the consultant, a subcontractor
  organisation   String?
  email          String?
  phone          String?
  present        Boolean      @default(true)
  sortOrder      Int          @default(0)

  @@index([meetingId])
  @@index([organizationId])
}

/// A line of the minutes: something noted, or a decision.
model MeetingPoint {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  meetingId      String
  meeting        Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind           MeetingPointKind @default(NOTE)
  text           String
  sortOrder      Int              @default(0)

  @@index([meetingId])
  @@index([organizationId])
}

/// An action from a meeting: what, whose, by when, and what it is about. It stays open, and comes up at the next
/// meetings, until it is done or dropped.
model MeetingAction {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  meetingId      String
  meeting        Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text           String
  /// One of our users, who sees it in My work; or someone from outside, by name
  ownerUserId    String?
  ownerUser      User?               @relation("MeetingActionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerName      String
  dueOn          DateTime?           @db.Date
  status         MeetingActionStatus @default(OPEN)
  doneOn         DateTime?           @db.Date
  /// How it was closed, or why dropped
  closeNote      String?
  closedById     String?
  closedBy       User?               @relation("MeetingActionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  rfiId          String?
  rfi            Rfi?                @relation(fields: [rfiId], references: [id], onDelete: SetNull)
  ncrId          String?
  ncr            Ncr?                @relation(fields: [ncrId], references: [id], onDelete: SetNull)
  variationId    String?
  variation      Variation?          @relation(fields: [variationId], references: [id], onDelete: SetNull)
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, projectId, status])
  @@index([ownerUserId, status])
  @@index([meetingId])
}

/// Material approvals (v6 item 113): a material or a sample put up to the client's engineer or consultant for approval.
enum MaterialApprovalKind {
  /// Catalogue, data sheet and test certificates of a make
  MATERIAL
  /// A physical sample or mock-up, kept on site once approved
  SAMPLE
}

enum MaterialApprovalStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  APPROVED_AS_NOTED
  REVISE_RESUBMIT
  REJECTED
  WITHDRAWN
}

/// What the reviewer said of one submission.
enum MaterialReviewOutcome {
  APPROVED
  APPROVED_AS_NOTED
  REVISE_RESUBMIT
  REJECTED
}

/// Where an approved make comes from: the contract's list of approved makes, or an approval request.
enum ApprovedMakeSource {
  CONTRACT
  APPROVAL
}

/// A request to approve a make (or a sample) for a material on a project. Each time it goes to the reviewer is a
/// revision (R0, R1…) with its outcome; its status is the latest outcome.
model MaterialApproval {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// MAR-2026-0001 per organisation
  marNo          String
  kind           MaterialApprovalKind   @default(MATERIAL)
  /// The material, e.g. "Vitrified floor tiles 600 x 600"
  material       String
  itemId         String?
  item           Item?                  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  boqItemId      String?
  boqItem        BoqItem?               @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  make           String
  /// Model, grade or range, e.g. "Fe 550D", "Endura series"
  model          String?
  /// The supplier offering it
  vendorId       String?
  vendor         Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Where it goes, e.g. "Wards and corridors, all floors"
  usedFor        String?
  /// Why this make, what it meets: specification clause, IS code, equal to a listed make
  note           String?
  /// Addressed to, as written: the client's engineer or the consultant
  toParty        String
  /// When the reviewer is asked to answer the current revision by
  replyBy        DateTime?              @db.Date
  status         MaterialApprovalStatus @default(DRAFT)
  /// The current revision: 0 for the first submission
  revision       Int                    @default(0)
  createdById    String
  createdBy      User                   @relation("MaterialApprovalCreator", fields: [createdById], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  revisions     MaterialApprovalRevision[]
  attachments   Attachment[]
  approvedMakes ApprovedMake[]

  @@unique([organizationId, marNo])
  @@index([organizationId, projectId, status])
}

/// One submission of a request to the reviewer, and what came back.
model MaterialApprovalRevision {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  approvalId     String
  approval       MaterialApproval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  revision       Int
  submittedOn    DateTime               @db.Date
  submittedById  String
  submittedBy    User                   @relation("MaterialRevSubmitter", fields: [submittedById], references: [id])
  /// What changed from the last revision, or the covering note
  submitNote     String?
  outcome        MaterialReviewOutcome?
  reviewedOn     DateTime?              @db.Date
  /// Who reviewed, as written
  reviewerName   String?
  comments       String?
  /// Their letter or mail reference
  reviewRef      String?
  recordedById   String?
  recordedBy     User?                  @relation("MaterialRevRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())

  @@unique([approvalId, revision])
  @@index([organizationId])
}

/// A make approved for a material on a project: from the contract's list, or from an approval request. A purchase
/// order line for that material in another make is flagged.
model ApprovedMake {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material       String
  itemId         String?
  item           Item?              @relation(fields: [itemId], references: [id], onDelete: SetNull)
  make           String
  model          String?
  source         ApprovedMakeSource @default(CONTRACT)
  approvalId     String?
  approval       MaterialApproval?  @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  note           String?
  createdById    String
  createdBy      User               @relation("ApprovedMakeCreator", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())

  @@index([organizationId, projectId])
  @@index([approvalId])
}

/// A comment on a record (v6 item 116). A thread's first comment has no parent and holds whether the thread is resolved;
/// replies point at it. Staff only: guests and suppliers neither see nor write them.
model Comment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// A `CommentKind`: a submission type, MEETING or MATERIAL_APPROVAL
  entityType     String
  entityId       String
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]    @relation("CommentReplies")
  authorId       String
  author         User         @relation("CommentAuthor", fields: [authorId], references: [id])
  body           String
  /// Users mentioned, each written as @Full Name in the body
  mentions       String[]     @default([])
  editedAt       DateTime?
  /// Removed by its author or an admin: the body is cleared, the row stays while it has replies
  removedAt      DateTime?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?        @relation("CommentResolver", fields: [resolvedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([parentId])
}

/// The plans' module sets (v6 item 117): MODULE_TIER_MODULES in @erp/shared
enum ModuleTier {
  ESSENTIALS
  BUSINESS
  ENTERPRISE
}
