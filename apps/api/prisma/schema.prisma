  PRESENT
  HALF_DAY
  ABSENT
}

/// HR records (v6 item 99)
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  PERMANENT
  PROBATION
  CONTRACT
  TRAINEE
  CONSULTANT
}

/// What happened in an employee's service: each is dated, numbered and can print its letter.
enum EmployeeEventType {
  JOINED
  CONFIRMED
  TRANSFERRED
  PROMOTED
  INCREMENT
  WARNING
  RESIGNED
  TERMINATED
  RETIRED
}

/// Payroll (v6 item 100): which tax regime an employee's TDS is worked out under.
enum TaxRegime {
  NEW
  OLD
}

/// Days a month's salary is divided by: the month's own days, or a fixed 26.
enum PaidDaysBasis {
  CALENDAR
  FIXED_26
}

/// A salary run: HR prepares it, management approves it, accounts pays it; paid runs are locked.
enum PayrollRunStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
}

enum PayslipLineKind {
  EARNING
  DEDUCTION
  EMPLOYER
}

enum StaffLoanKind {
  LOAN
  ADVANCE
}

/// Full and final settlement: worked out, approved, paid.
enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  COMP_OFF
  UNPAID
  /// Attendance extras (v5 item 97): away on company work for the day; counted present, not against a balance
  ON_DUTY
  /// Away on a site visit or tour for one or more days; counted present, not against a balance
  TOUR
}

/// Biometric attendance (v6 item 101): how a device sends its punches
enum BiometricProtocol {
  /// ZKTeco, eSSL and other devices with the ADMS (iclock) push protocol
  ADMS
  /// Any device or middleware that can post JSON with the device's key
  WEBHOOK
  /// Punch files exported from the device or its software, imported by hand
  FILE
}

/// What became of a punch
enum BiometricPunchResult {
  /// Set the person's attendance for the day
  APPLIED
  /// The device user is not matched to an employee or a worker yet
  UNMATCHED
  /// The day's attendance is locked (its DPR is approved)
  LOCKED
  /// A worker punched on a device with no site, or is already marked at another site that day
  SKIPPED
}

/// Attendance extras (v5 item 97): overtime from a check-out waits for the posting's project manager or HR
enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Outbound phone channels for alerts, on top of in-app, push and email.
enum MessageChannel {
  WHATSAPP
  SMS
}

/// Which pre-approved template a WhatsApp or SMS message uses (WhatsApp and DLT both need registered templates).
enum MessageTemplate {
  APPROVAL_REQUEST
  SENT_BACK
  DPR_REMINDER
  APPROVAL_DIGEST
  TEST_DUE
  BILLS_DUE
  INVITE
  TEST
  MORNING_BRIEF
}

/// SKIPPED: the channel is not set up on this server, so nothing left it (the row shows what would have gone).
enum OutboundMessageStatus {
  SENT
  FAILED
  SKIPPED
}

enum RiskKind {
  DELAY
  RISK
}

enum RiskCategory {
  LAND
  DESIGN
  CLIENT
  MATERIAL
  LABOUR
  EQUIPMENT
  WEATHER
  FINANCE
  STATUTORY
  SAFETY
  UTILITY
  OTHER
}

enum RiskStatus {
  OPEN
  MONITORING
  CLOSED
}

/// Who a delay is attributable to (decides whether an extension of time can be claimed).
enum DelayParty {
  CLIENT
  CONTRACTOR
  THIRD_PARTY
  FORCE_MAJEURE
}

enum PasswordTokenPurpose {
  INVITE
  RESET
}

/// Where an approved RA bill is with the client: prepared and approved (NOT_SENT), sent, certified, paid.
enum BillStage {
  NOT_SENT
  SENT
  CERTIFIED
  PAID
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

// ---------- Tenancy, users, roles ----------

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// An admin asked for the company and all its data to be erased (cancellable until deletionScheduledFor)
  deletionRequestedAt     DateTime?
  deletionRequestedByName String?
  deletionScheduledFor    DateTime? @db.Date

  /// Suspended by Nirmaan staff (platform admin): nobody can sign in until it is lifted
  suspendedAt                DateTime?
  suspendedReason            String?
  /// An admin let Nirmaan support open the company read-only until this time
  supportAccessUntil         DateTime?
  supportAccessGrantedByName String?

  /// Subscription (v3 item 34). Last day of the free trial; set when billing is on (at sign-up, or by the daily job)
  trialEndsAt        DateTime? @db.Date
  /// Last day paid for
  paidUntil          DateTime? @db.Date
  /// Who the subscription invoices are made out to
  billingName        String?
  billingGstin       String?
  billingAddress     String?
  /// GST state code of the place of supply
  billingStateCode   String?
  /// The last billing reminder sent, so each is sent once (e.g. "TRIAL:2026-11-13:7")
  billingRemindedFor String?

  /// Ask Nirmaan (AI item 67): switched on by an admin; off until then
  aiEnabled           Boolean     @default(false)
  /// Rupees per calendar month for the company's AI use; null = the server's AI_DEFAULT_MONTHLY_CAP_INR
  aiMonthlyCapInr     Int?
  /// Roles besides admins that may use Ask Nirmaan (AI item 77); empty = all staff
  aiRoles             String[]    @default([])
  /// Payment requests (v5 item 90): accounts may pay a bill only against an approved payment request. Off for companies
  /// made before item 90, on for new sign-ups.
  paymentsNeedRequest Boolean     @default(false)
  /// Module switches (v6 item 117): the switchable modules (SWITCHABLE_MODULES in @erp/shared) an admin turned off.
  /// Their data stays; turning one on again brings it back.
  modulesOff          String[]    @default([])
  /// The plan's module set, set from the Nirmaan console; null = every module
  moduleTier          ModuleTier?

