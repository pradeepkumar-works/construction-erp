  updatedAt      DateTime        @updatedAt
  lines          MixDesignLine[]
  orders         RmcOrder[]
  batches        RmcBatch[]

  @@unique([organizationId, code])
  @@index([plantId])
}

model MixDesignLine {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  mixDesignId    String
  mixDesign      MixDesign    @relation(fields: [mixDesignId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  /// Per cubic metre of concrete, in the item's unit
  quantity       Decimal      @db.Decimal(18, 3)
  sortOrder      Int          @default(0)

  @@index([mixDesignId])
}

/// A customer's quote and then order for concrete from a plant, or an own site supplied from it.
model RmcOrder {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  /// RMC-2026-0001
  orderNo        String
  plantId        String
  plant          Project        @relation("RmcOrderPlant", fields: [plantId], references: [id], onDelete: Cascade)
  date           DateTime       @db.Date
  status         RmcOrderStatus @default(QUOTED)
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  /// An own site the plant supplies (no GST bill)
  projectId      String?
  project        Project?       @relation("RmcOrderSite", fields: [projectId], references: [id], onDelete: SetNull)
  site           String?
  mixDesignId    String
  mixDesign      MixDesign      @relation(fields: [mixDesignId], references: [id])
  quantity       Decimal        @db.Decimal(18, 3)
  rate           Decimal        @db.Decimal(18, 2)
  pumpRate       Decimal?       @db.Decimal(18, 2)
  pourDate       DateTime?      @db.Date
  validUntil     DateTime?      @db.Date
  notes          String?
  confirmedAt    DateTime?
  createdById    String
  createdBy      User           @relation("RmcOrderCreator", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  batches        RmcBatch[]
  invoices       RmcInvoice[]

  @@unique([organizationId, orderNo])
  @@index([plantId, status])
}

/// One truck of concrete: the batch made at the plant and its delivery challan. Dispatching it issues the materials
/// from the plant's stock (`stockEntryId`).
model RmcBatch {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  /// DC-2026-0001, also the challan number
  batchNo        String
  plantId        String
  plant          Project        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  orderId        String
  order          RmcOrder       @relation(fields: [orderId], references: [id])
  mixDesignId    String
  mixDesign      MixDesign      @relation(fields: [mixDesignId], references: [id])
  date           DateTime       @db.Date
  dispatchedAt   DateTime
  quantity       Decimal        @db.Decimal(18, 3)
  truck          String?
  driver         String?
  pumped         Boolean        @default(false)
  slumpMm        Int?
  status         RmcBatchStatus @default(DISPATCHED)
  deliveredAt    DateTime?
  receivedBy     String?
  note           String?
  stockEntryId   String?        @unique
  stockEntry     StockEntry?    @relation(fields: [stockEntryId], references: [id], onDelete: SetNull)
  invoiceId      String?
  invoice        RmcInvoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User           @relation("RmcBatchCreator", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  lines          RmcBatchLine[]
  cubeTest       QualityTest?

  @@unique([organizationId, batchNo])
  @@index([plantId, date])
  @@index([orderId])
}

model RmcBatchLine {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  batchId        String
  batch          RmcBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  designQty      Decimal      @db.Decimal(18, 3)
  actualQty      Decimal      @db.Decimal(18, 3)

  @@index([batchId])
}

/// A GST bill to a customer for delivered challans.
model RmcInvoice {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  /// RINV-2026-0001
  invoiceNo      String
  plantId        String
  plant          Project          @relation(fields: [plantId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  orderId        String?
  order          RmcOrder?        @relation(fields: [orderId], references: [id])
  date           DateTime         @db.Date
  status         RmcInvoiceStatus @default(ISSUED)
  quantity       Decimal          @db.Decimal(18, 3)
  concrete       Decimal          @db.Decimal(18, 2)
  pumping        Decimal          @db.Decimal(18, 2)
  taxable        Decimal          @db.Decimal(18, 2)
  cgst           Decimal          @db.Decimal(18, 2)
  sgst           Decimal          @db.Decimal(18, 2)
  igst           Decimal          @db.Decimal(18, 2)
  total          Decimal          @db.Decimal(18, 2)
  cancelledAt    DateTime?
  cancelNote     String?
  tallyExportId  String?
  tallyExport    TallyExport?     @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)
