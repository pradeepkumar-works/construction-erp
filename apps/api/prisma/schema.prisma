// ---------- Projects ----------

model Project {
  id                    String         @id @default(uuid())
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id])
  aiBriefs              AiBrief[]
  documentPages         DocumentPage[]
  photoChecks           PhotoCheck[]
  /// Site photo checks (AI item 76): the safety officer switched the photo flags off for this project; captions still show
  photoFlagsOff         Boolean        @default(false)
  /// Kit every worker at the project must have (PPE register); new projects start with the standard three
  ppeRequired           PpeKind[]      @default([HELMET, SAFETY_SHOES, REFLECTIVE_JACKET])
  code                  String
  name                  String
  type                  ProjectType
  status                ProjectStatus  @default(PLANNED)
  clientName            String?
  consultantName        String?
  location              String?
  /// Road or pipeline length the sector view draws, in metres from the start (chainage 0+000 = 0)
  chainageStart         Int?
  chainageEnd           Int?
  /// Building floors in order, bottom up; progress and measurements pick one
  floors                String[]       @default([])
  /// Water supply: villages / habitations served; progress and measurements pick one
  villages              String[]       @default([])
  workOrderNo           String?
  description           String?
  startDate             DateTime?      @db.Date
  endDate               DateTime?      @db.Date
  contractValue         Decimal?       @db.Decimal(18, 2)
  projectManagerId      String?
  projectManager        User?          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  /// Client from the client master; `clientName` keeps a copy of its name (and stays free text without one)
  clientId              String?
  client                Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // ----- Contract terms (what RA bills are built on) -----
  agreementNo           String?
  agreementDate         DateTime?      @db.Date
  /// Retention money deducted from each bill, % of the work value; released after the defect liability period
  retentionPct          Decimal        @default(0) @db.Decimal(5, 2)
  /// Security deposit deducted from each bill, % of the work value
  securityDepositPct    Decimal        @default(0) @db.Decimal(5, 2)
  /// Mobilisation advance paid by the client, recovered from bills
  mobilisationAdvance   Decimal        @default(0) @db.Decimal(18, 2)
  /// Advance recovered from each bill, % of the work value, until all of it is recovered
  advanceRecoveryPct    Decimal        @default(0) @db.Decimal(5, 2)
  defectLiabilityMonths Int?
  /// The contract has a price variation (escalation) clause
  priceVariation        Boolean        @default(false)
  /// Price variation: the date the base indices are taken at (usually the month before the bid was due)
  pvBaseDate            DateTime?      @db.Date
  /// Liquidated damages for late completion: % of the contract value per day, week or month past the revised completion date
  ldRatePct             Decimal        @default(0) @db.Decimal(6, 3)
  ldPeriod              LdPeriod       @default(WEEK)
  /// Liquidated damages are capped at this % of the contract value
  ldCapPct              Decimal        @default(10) @db.Decimal(5, 2)
  /// GST charged on bills, % of the work value
  gstRate               Decimal        @default(18) @db.Decimal(5, 2)
  /// Income-tax TDS the client deducts (section 194C), % of the work value
  tdsPct                Decimal        @default(0) @db.Decimal(5, 2)
  /// GST TDS a government client deducts, % of the work value
  gstTdsPct             Decimal        @default(0) @db.Decimal(5, 2)
  /// Building and other construction workers' welfare cess, % of the work value
  labourCessPct         Decimal        @default(0) @db.Decimal(5, 2)
  /// Days the client takes to pay a bill once it is sent; the cash-flow forecast assumes 30 when not set
  clientPaymentDays     Int?
  /// When the schedule baseline was last frozen (activity planned dates and milestone due dates copied to their baseline)
  baselineAt            DateTime?
  baselineById          String?
  baselineBy            User?          @relation("ProjectBaselineBy", fields: [baselineById], references: [id])
  baselineNote          String?
  /// Estimate (v5 item 92): overheads and profit added to the cost of each BOQ item's resources for its built-up rate, %
  estimateOverheadPct   Decimal        @default(5) @db.Decimal(5, 2)
  estimateProfitPct     Decimal        @default(10) @db.Decimal(5, 2)
  /// Attendance extras (v5 item 97): where the site is, for GPS check-in; a check-in further than the radius is flagged
  siteLat               Decimal?       @db.Decimal(9, 6)
  siteLng               Decimal?       @db.Decimal(9, 6)
  siteRadiusM           Int?
  /// Refuse a check-in from outside the radius (or without a position) instead of only flagging it
  siteCheckInStrict     Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  members            ProjectMember[]
  boqItems           BoqItem[]
  activities         Activity[]
  milestones         Milestone[]
  activityLinks      ActivityLink[]
  workers            Worker[]
  workerAttendance   WorkerAttendance[]
  imprests           Imprest[]
  complianceDocs     ComplianceDoc[]
  handover           ProjectHandover?
  defects            Defect[]
  closeoutItems      CloseoutItem[]
  progressEntries    ProgressEntry[]
  dailyReports       DailyReport[]
  materialRequests   MaterialRequest[]
  notifications      Notification[]
  attendanceSheets   AttendanceSheet[]
  stockEntries       StockEntry[]             @relation("StockEntryProject")
  transfersIn        StockEntry[]             @relation("StockTransferTo")
  stockTxns          StockTxn[]
  stockMinLevels     StockMinLevel[]
  materialNorms      MaterialNorm[]
  boqResources       BoqResource[]
  excessRecoveries   ExcessMaterialRecovery[]
  equipment          Equipment[]
  machineryLogs      MachineryLog[]
  expenses           Expense[]
  risks              Risk[]
  measurements       MeasurementSheet[]
  raBills            RaBill[]
  receipts           Receipt[]
  vendorPayments     VendorPayment[]
  paymentRequests    PaymentRequest[]
  fundRequestsRaised PaymentRequest[]         @relation("FundRequestRaisedAt")
  quotations         Quotation[]
  purchaseOrders     PurchaseOrder[]
  vendorBills        VendorBill[]
  debitNotes         DebitNote[]
  workOrders         WorkOrder[]
  scEnquiries        SubcontractEnquiry[]
  subcontractBills   SubcontractBill[]
  inspections        Inspection[]
  qualityTests       QualityTest[]
  ncrs               Ncr[]
  documents          Document[]
  drawingMarkups     DrawingMarkup[]
  transmittals       Transmittal[]
  letters            Letter[]
  staff              Employee[]
  employeeEventsFrom EmployeeEvent[]          @relation("EmployeeEventFrom")
  employeeEventsTo   EmployeeEvent[]          @relation("EmployeeEventTo")
  payrollRuns        PayrollRun[]
  biometricDevices   BiometricDevice[]
  bookVouchers       BookVoucher[]
  bookLines          BookLine[]
  mixDesigns         MixDesign[]
  rmcOrdersAtPlant   RmcOrder[]               @relation("RmcOrderPlant")
  rmcOrdersForSite   RmcOrder[]               @relation("RmcOrderSite")
  rmcBatches         RmcBatch[]
  rmcInvoices        RmcInvoice[]
  staffAttendance    StaffAttendance[]
  holidays           Holiday[]
  variations         Variation[]
  budget             ProjectBudget?
  /// The tender this project was won from (v6 item 110)
  tender             Tender?
  safetyIncidents    SafetyIncident[]
  toolboxTalks       ToolboxTalk[]
  ppeIssues          PpeIssue[]
  rfis               Rfi[]
  workPermits        WorkPermit[]
  maintenanceJobs    MaintenanceJob[]

  pvComponents      PriceVariationComponent[]
  meetings          Meeting[]
  meetingActions    MeetingAction[]
  materialApprovals MaterialApproval[]
  comments          Comment[]
  approvedMakes     ApprovedMake[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([projectManagerId])
}

/// A client (employer) the organisation builds for: a government department or a private owner.
model Client {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  /// Department, division or circle that issues the work orders, e.g. "Roads Division, Khordha"
  department     String?
  gstin          String?
  pan            String?
  billingAddress String?
  /// GST state code (first two digits of the GSTIN, or set by hand)
  stateCode      String?
  contactPerson  String?
  email          String?
  phone          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projects    Project[]
  rmcOrders   RmcOrder[]
  rmcInvoices RmcInvoice[]
  rmcReceipts RmcReceipt[]
  tenders     Tender[]

  @@unique([organizationId, name])
}

/// Vendor master: suppliers, hire agencies, subcontractors, labour contractors and service providers.
/// Expenses, machines and GRNs link to a vendor and keep a copy of its name.
model Vendor {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  name            String
  kinds           VendorKind[]
  gstin           String?
  pan             String?
  /// GST state code (first two digits of the GSTIN, or set by hand)
  stateCode       String?
  address         String?
  contactPerson   String?
  email           String?
  phone           String?
  bankAccountName String?
  bankAccountNo   String?
  bankIfsc        String?
  bankName        String?
  msmeCategory    MsmeCategory?
  /// Udyam registration number, UDYAM-XX-00-0000000
  udyamNo         String?
  remarks         String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  expenses          Expense[]
  equipment         Equipment[]
  stockEntries      StockEntry[]
  quotations        Quotation[]
  purchaseOrders    PurchaseOrder[]
  vendorBills       VendorBill[]
  debitNotes        DebitNote[]
  workOrders        WorkOrder[]
  scQuotes          SubcontractQuote[]
  attendance        AttendanceLine[]
  workers           Worker[]
  payments          VendorPayment[]
  paymentRequests   PaymentRequest[]
  enquiryTokens     EnquiryToken[]
  portalLogins      User[]                  @relation("VendorPortalLogins")
  dispatches        SupplierDispatch[]
  invoices          SupplierInvoice[]
  changeRequests    SupplierChangeRequest[]
  equipmentLoans    EquipmentLoan[]
  materialApprovals MaterialApproval[]

  @@unique([organizationId, name])
}

/// A vendor's quotation for an approved material request: a rate per request line. The comparative statement puts
/// the quotations of one request side by side.
model Quotation {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  /// The vendor's own quotation number
  quoteRef          String?
  quoteDate         DateTime        @db.Date
  validUntil        DateTime?       @db.Date
  deliveryDays      Int?
  paymentTerms      String?
  freight           Decimal         @default(0) @db.Decimal(18, 2)
  remarks           String?
  /// Typed by the supplier on the enquiry link (v5 item 95), not entered by us
  fromSupplier      Boolean         @default(false)
  createdById       String
  createdBy         User            @relation("QuotationCreator", fields: [createdById], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lines          QuotationLine[]
  purchaseOrders PurchaseOrder[]
  enquiryTokens  EnquiryToken[]

  @@unique([materialRequestId, vendorId])
  @@index([organizationId])
}

model QuotationLine {
  id                    String              @id @default(uuid())
  quotationId           String
  quotation             Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  materialRequestItemId String
  materialRequestItem   MaterialRequestItem @relation(fields: [materialRequestItemId], references: [id], onDelete: Cascade)
  /// Rate per unit before GST
  rate                  Decimal             @db.Decimal(18, 2)
  gstRate               Decimal             @default(0) @db.Decimal(5, 2)
  remarks               String?

  @@unique([quotationId, materialRequestItemId])
}

/// Purchase order to a vendor, approved through the approval matrix (submission type PURCHASE_ORDER). GRNs receive
/// against its lines and vendor bills are matched to it.
model PurchaseOrder {
  id                   String           @id @default(uuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id])
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId             String
  vendor               Vendor           @relation(fields: [vendorId], references: [id])
  /// PO-<year>-0001 per organisation
  poNo                 String
  poDate               DateTime         @db.Date
  materialRequestId    String?
  materialRequest      MaterialRequest? @relation(fields: [materialRequestId], references: [id], onDelete: SetNull)
  quotationId          String?
  quotation            Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  deliveryBy           DateTime?        @db.Date
  deliveryAddress      String?
  paymentTerms         String?
  /// Days from the vendor's invoice to payment; micro and small enterprises are capped at 45
  paymentDays          Int?
  freight              Decimal          @default(0) @db.Decimal(18, 2)
  /// Sum of line amounts (quantity × rate)
  subtotal             Decimal          @default(0) @db.Decimal(18, 2)
  gstAmount            Decimal          @default(0) @db.Decimal(18, 2)
  /// subtotal + freight + GST
  total                Decimal          @default(0) @db.Decimal(18, 2)
  remarks              String?
  /// Short-closed: no more GRNs or bills against it
  closedAt             DateTime?
  closeNote            String?
  /// The supplier accepted it on the supplier portal (v6 item 105), with their remark
  supplierAcceptedAt   DateTime?
  supplierAcceptedById String?
  supplierAcceptedBy   User?            @relation("PoSupplierAccepter", fields: [supplierAcceptedById], references: [id], onDelete: SetNull)
  supplierNote         String?
  status               SubmissionStatus @default(DRAFT)
  submittedById        String
  submittedBy          User             @relation("PoSubmitter", fields: [submittedById], references: [id])
  submittedAt          DateTime?
  reviewedById         String?
  reviewedBy           User?            @relation("PoReviewer", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  lines            PurchaseOrderLine[]
  stockEntries     StockEntry[]
  vendorBills      VendorBill[]
  attachments      Attachment[]
  paymentRequests  PaymentRequest[]
  advances         VendorPayment[]
  dispatches       SupplierDispatch[]
  supplierInvoices SupplierInvoice[]

  @@unique([organizationId, poNo])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([organizationId, poDate])
}

model PurchaseOrderLine {
  id                    String               @id @default(uuid())
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  /// The material request line it orders, when raised from a request
  materialRequestItemId String?
  materialRequestItem   MaterialRequestItem? @relation(fields: [materialRequestItemId], references: [id], onDelete: SetNull)
  itemName              String
  specification         String?
  /// The make (brand) ordered, checked against the project's approved makes (v6 item 113)
  make                  String?
  unit                  String
  quantity              Decimal              @db.Decimal(18, 3)
  rate                  Decimal              @db.Decimal(18, 2)
  gstRate               Decimal              @default(0) @db.Decimal(5, 2)
  amount                Decimal              @db.Decimal(18, 2)
  gstAmount             Decimal              @db.Decimal(18, 2)
  sortOrder             Int                  @default(0)

  stockTxns     StockTxn[]
  billLines     VendorBillLine[]
  dispatchLines SupplierDispatchLine[]

  @@index([purchaseOrderId])
}

/// A vendor's invoice against a purchase order, matched three ways: rates to the PO, quantities to what GRNs received.
/// Approved through the approval matrix (submission type VENDOR_BILL); paid in payables.
model VendorBill {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  /// PO (against a purchase order, matched three ways), HIRE (a hired machine's month from its logs), SERVICE (closed
  /// job cards), OTHER (transport, testing, consultancy against an expense category) (v5 item 91)
  kind            VendorBillKind   @default(PO)
  /// PO bills only
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  /// HIRE: the hired machine and the month billed (its first day)
  equipmentId     String?
  equipment       Equipment?       @relation(fields: [equipmentId], references: [id])
  hireMonth       DateTime?        @db.Date
  /// HIRE: diesel we issued to a machine the owner should fuel, recovered on the bill at fuelRate a litre
  fuelLitres      Decimal          @default(0) @db.Decimal(18, 3)
  fuelRate        Decimal          @default(0) @db.Decimal(18, 2)
  fuelRecovery    Decimal          @default(0) @db.Decimal(18, 2)
  /// OTHER: the cost head
  expenseCategory ExpenseCategory?
  /// Debit notes against the bill that are not cancelled; what is payable drops by them
  debitNoteAmount Decimal          @default(0) @db.Decimal(18, 2)
  /// VB-<year>-0001 per organisation
  billNo          String
  /// The vendor's invoice number and date
  invoiceNo       String
  invoiceDate     DateTime         @db.Date
  /// When payment falls due: invoice date + the PO's payment days (45 at most for micro and small enterprises)
  dueDate         DateTime         @db.Date
  freight         Decimal          @default(0) @db.Decimal(18, 2)
  subtotal        Decimal          @default(0) @db.Decimal(18, 2)
  gstAmount       Decimal          @default(0) @db.Decimal(18, 2)
  total           Decimal          @default(0) @db.Decimal(18, 2)
  /// Advance paid on the PO and taken off this bill (v5 item 90); what is payable is total less this
  advanceAdjusted Decimal          @default(0) @db.Decimal(18, 2)
  /// Settled by payments so far (paid + deducted at payment), kept in step by payables
  paidAmount      Decimal          @default(0) @db.Decimal(18, 2)
  /// The day the last payment settled it in full; null while anything is outstanding
  paidDate        DateTime?        @db.Date
  /// Three-way match: no exceptions
  matched         Boolean          @default(true)
  /// What does not match (quantity over received, rate over PO, ...), one line each
  exceptions      String[]
  remarks         String?
  status          SubmissionStatus @default(DRAFT)
  submittedById   String
  submittedBy     User             @relation("VendorBillSubmitter", fields: [submittedById], references: [id])
  submittedAt     DateTime?
  reviewedById    String?
  reviewedBy      User?            @relation("VendorBillReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?
  /// Set once the voucher is in a Tally export; undoing the export clears it
  tallyExportId   String?
  tallyExport     TallyExport?     @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lines           VendorBillLine[]
  attachments     Attachment[]
  payments        VendorPayment[]
  paymentRequests PaymentRequest[]
  debitNotes      DebitNote[]
  machineryLogs   MachineryLog[]
  maintenanceJobs MaintenanceJob[]

  @@unique([organizationId, billNo])
  @@unique([vendorId, invoiceNo])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([tallyExportId])
  @@index([organizationId, invoiceDate])
  @@index([equipmentId, hireMonth])
}

model VendorBillLine {
  id                  String             @id @default(uuid())
  billId              String
  bill                VendorBill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  /// PO bills: the PO line billed; other bills describe the line themselves
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  description         String?
  unit                String?
  quantity            Decimal            @db.Decimal(18, 3)
  rate                Decimal            @db.Decimal(18, 2)
  gstRate             Decimal            @default(0) @db.Decimal(5, 2)
  amount              Decimal            @db.Decimal(18, 2)
  gstAmount           Decimal            @db.Decimal(18, 2)
  sortOrder           Int                @default(0)

  @@index([purchaseOrderLineId])
}

enum VendorBillKind {
  PO
  HIRE
  SERVICE
  OTHER
}

/// Who fuels a hired machine
enum HireFuelBy {
  OWNER
  COMPANY
}

/// How a machine's fuel norm is measured (v5 item 93): litres per working hour, or km per litre for vehicles
enum FuelNormUnit {
  LITRES_PER_HOUR
  KM_PER_LITRE
}

enum EquipmentPartKind {
  TYRE
  BATTERY
}

enum DebitNoteReason {
  SHORTAGE
  EXCESS
  REJECTED
  RETURNED
  RATE_DIFFERENCE
  OTHER
}

/// What a rate-analysis resource is besides material (v5 item 92); materials are MaterialNorm rows
enum BoqResourceKind {
  /// A trade (matches LabourRate.category), in man-days per BOQ unit
  LABOUR
  /// An equipment category (matches Equipment.category), in machine hours per BOQ unit
  EQUIPMENT
}

/// Why stock was adjusted (v5 item 92); everything but OPENING is a loss or gain the wastage report counts
enum StockAdjustmentReason {
  OPENING
  WASTAGE
  DAMAGE
  THEFT
  COUNT_DIFFERENCE
  OTHER
}

/// What we take off a vendor's or subcontractor's approved bill (v5 item 91): DN-<year>-0001, against exactly one bill.
/// The bill's payable drops by its total, input GST is reversed in the GST registers, and Tally gets a debit note.
model DebitNote {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor           @relation(fields: [vendorId], references: [id])
  noteNo            String
  date              DateTime         @db.Date
  reason            DebitNoteReason
  vendorBillId      String?
  vendorBill        VendorBill?      @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  subcontractBillId String?
  subcontractBill   SubcontractBill? @relation(fields: [subcontractBillId], references: [id], onDelete: Cascade)
  /// The GRN rejected at QA/QC or the return to the supplier it came from
  stockEntryId      String?
  stockEntry        StockEntry?      @relation(fields: [stockEntryId], references: [id], onDelete: SetNull)
  subtotal          Decimal          @db.Decimal(18, 2)
  gstAmount         Decimal          @db.Decimal(18, 2)
  total             Decimal          @db.Decimal(18, 2)
  remarks           String?
  createdById       String
  createdBy         User             @relation("DebitNoteCreator", fields: [createdById], references: [id])
  /// A cancelled note no longer reduces the bill
  cancelledAt       DateTime?
  cancelledById     String?
  cancelledBy       User?            @relation("DebitNoteCanceller", fields: [cancelledById], references: [id])
  cancelNote        String?
  tallyExportId     String?
  tallyExport       TallyExport?     @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  lines DebitNoteLine[]

  @@unique([organizationId, noteNo])
  @@index([organizationId, date])
  @@index([vendorBillId])
  @@index([subcontractBillId])
  @@index([stockEntryId])
  @@index([tallyExportId])
}

model DebitNoteLine {
  id          String    @id @default(uuid())
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  description String
  /// With a quantity and rate, or a lump sum (amount alone)
  quantity    Decimal?  @db.Decimal(18, 3)
  unit        String?
  rate        Decimal?  @db.Decimal(18, 2)
  amount      Decimal   @db.Decimal(18, 2)
  gstRate     Decimal   @default(0) @db.Decimal(5, 2)
  gstAmount   Decimal   @default(0) @db.Decimal(18, 2)
  sortOrder   Int       @default(0)

  @@index([debitNoteId])
}

/// Work order to a subcontractor or labour contractor (v3 item 22): rates per BOQ item or for its own items, with the
/// retention, advance and TDS their bills are made with. Approved through the approval matrix (submission type WORK_ORDER).
model WorkOrder {
  id                   String           @id @default(uuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id])
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId             String
  vendor               Vendor           @relation(fields: [vendorId], references: [id])
  /// WO-<year>-0001 per organisation
  woNo                 String
  woDate               DateTime         @db.Date
  /// What the work order is for, e.g. "Brickwork and plaster, Block A"
  title                String
  startDate            DateTime?        @db.Date
  endDate              DateTime?        @db.Date
  /// GST the subcontractor charges on their bills (0 when they are not registered)
  gstRate              Decimal          @default(0) @db.Decimal(5, 2)
  retentionPct         Decimal          @default(0) @db.Decimal(5, 2)
  /// Mobilisation advance paid to them, recovered from their bills at advanceRecoveryPct
  advanceAmount        Decimal          @default(0) @db.Decimal(18, 2)
  advanceRecoveryPct   Decimal          @default(0) @db.Decimal(5, 2)
  /// Income-tax TDS on their bills (section 194C: 1% for an individual or HUF, 2% otherwise)
  tdsPct               Decimal          @default(0) @db.Decimal(5, 2)
  /// Days from their bill to payment; micro and small enterprises are capped at 45
  paymentDays          Int?
  /// Sum of line amounts (quantity × rate), before GST
  value                Decimal          @default(0) @db.Decimal(18, 2)
  terms                String?
  remarks              String?
  /// Closed: no more measurements, issues or bills against it
  closedAt             DateTime?
  closeNote            String?
  /// The subcontractor accepted it on the supplier portal (v6 item 105), with their remark
  supplierAcceptedAt   DateTime?
  supplierAcceptedById String?
  supplierAcceptedBy   User?            @relation("WoSupplierAccepter", fields: [supplierAcceptedById], references: [id], onDelete: SetNull)
  supplierNote         String?
  status               SubmissionStatus @default(DRAFT)
  submittedById        String
  submittedBy          User             @relation("WorkOrderSubmitter", fields: [submittedById], references: [id])
  submittedAt          DateTime?
  reviewedById         String?
  reviewedBy           User?            @relation("WorkOrderReviewer", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  lines            WorkOrderLine[]
  bills            SubcontractBill[]
  measurements     MeasurementSheet[]
  issues           StockEntry[]
  attachments      Attachment[]
  paymentRequests  PaymentRequest[]
  advances         VendorPayment[]
  excessRecoveries ExcessMaterialRecovery[]
  supplierInvoices SupplierInvoice[]
  scEnquiry        SubcontractEnquiry?

  @@unique([organizationId, woNo])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([vendorId])
  @@index([organizationId, woDate])
}

/// One item of a work order: a BOQ item of the project (measured in the measurement book) or the work order's own item
/// (quantity entered on each bill).
model WorkOrderLine {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  boqItemId   String?
  boqItem     BoqItem?  @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  description String
  unit        String
  quantity    Decimal   @db.Decimal(18, 3)
  rate        Decimal   @db.Decimal(18, 2)
  amount      Decimal   @db.Decimal(18, 2)
  sortOrder   Int       @default(0)

  billLines SubcontractBillLine[]

  @@unique([workOrderId, boqItemId])
  @@index([boqItemId])
}

/// Running bill N of a subcontractor under a work order: measured work (or quantities entered for the work order's own
/// items) at the work order rates, GST, and the recoveries: retention, advance, TDS, material issued to them. Approved
/// through the approval matrix (submission type SUBCONTRACT_BILL); paid in payables.
model SubcontractBill {
  id                    String           @id @default(uuid())
  organizationId        String
  organization          Organization     @relation(fields: [organizationId], references: [id])
  projectId             String
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workOrderId           String
  workOrder             WorkOrder        @relation(fields: [workOrderId], references: [id])
  /// 1, 2, 3 ... per work order
  billNo                Int
  isFinal               Boolean          @default(false)
  billDate              DateTime         @db.Date
  /// Approved measurements and material issues up to this day, not taken by an earlier bill
  measuredUpTo          DateTime         @db.Date
  /// The subcontractor's own invoice number, when they give one
  invoiceNo             String?
  /// Bill date + the work order's payment days (45 at most for micro and small enterprises)
  dueDate               DateTime         @db.Date
  grossPrevious         Decimal          @db.Decimal(18, 2)
  grossAmount           Decimal          @db.Decimal(18, 2)
  grossUpto             Decimal          @db.Decimal(18, 2)
  gstRate               Decimal          @db.Decimal(5, 2)
  gstAmount             Decimal          @db.Decimal(18, 2)
  retentionPct          Decimal          @db.Decimal(5, 2)
  advanceRecoveryPct    Decimal          @db.Decimal(5, 2)
  tdsPct                Decimal          @db.Decimal(5, 2)
  retentionAmount       Decimal          @db.Decimal(18, 2)
  advanceRecoveryAmount Decimal          @db.Decimal(18, 2)
  tdsAmount             Decimal          @db.Decimal(18, 2)
  /// Material issued to them from stock, at the item's rate
  materialRecovery      Decimal          @db.Decimal(18, 2)
  /// Material used beyond the norm and its wastage, recovered from the reconciliation (v5 item 92)
  excessRecovery        Decimal          @default(0) @db.Decimal(18, 2)
  otherDeduction        Decimal          @default(0) @db.Decimal(18, 2)
  otherDeductionNote    String?
  totalDeductions       Decimal          @db.Decimal(18, 2)
  /// gross + GST - deductions
  netPayable            Decimal          @db.Decimal(18, 2)
  /// Debit notes against the bill that are not cancelled; what is payable drops by them (v5 item 91)
  debitNoteAmount       Decimal          @default(0) @db.Decimal(18, 2)
  /// Settled by payments so far (paid + deducted at payment), kept in step by payables
  paidAmount            Decimal          @default(0) @db.Decimal(18, 2)
  /// The day the last payment settled it in full; null while anything is outstanding
  paidDate              DateTime?        @db.Date
  remarks               String?
  status                SubmissionStatus @default(DRAFT)
  submittedById         String
  submittedBy           User             @relation("SubBillSubmitter", fields: [submittedById], references: [id])
  submittedAt           DateTime?
  reviewedById          String?
  reviewedBy            User?            @relation("SubBillReviewer", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  reviewNote            String?
  /// Set once the voucher is in a Tally export; undoing the export clears it
  tallyExportId         String?
  tallyExport           TallyExport?     @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  lines            SubcontractBillLine[]
  materials        SubcontractBillMaterial[]
  measurements     MeasurementSheet[]
  issues           StockEntry[]
  attachments      Attachment[]
  payments         VendorPayment[]
  paymentRequests  PaymentRequest[]
  debitNotes       DebitNote[]
  excessRecoveries ExcessMaterialRecovery[]

  @@unique([workOrderId, billNo])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([tallyExportId])
  @@index([organizationId, billDate])
}

/// One work order item on a subcontractor bill: quantity up to the previous bill, in this bill and up to date.
model SubcontractBillLine {
  id              String          @id @default(uuid())
  billId          String
  bill            SubcontractBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  workOrderLineId String
  workOrderLine   WorkOrderLine   @relation(fields: [workOrderLineId], references: [id], onDelete: Restrict)
  rate            Decimal         @db.Decimal(18, 2)
  prevQty         Decimal         @db.Decimal(18, 3)
  thisQty         Decimal         @db.Decimal(18, 3)
  uptoQty         Decimal         @db.Decimal(18, 3)
  amount          Decimal         @db.Decimal(18, 2)
  sortOrder       Int             @default(0)

  @@unique([billId, workOrderLineId])
  @@index([workOrderLineId])
}

/// Material issued to the subcontractor and recovered in a bill: quantity of one item at its rate when the bill was made.
model SubcontractBillMaterial {
  id       String          @id @default(uuid())
  billId   String
  bill     SubcontractBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item            @relation(fields: [itemId], references: [id])
  quantity Decimal         @db.Decimal(18, 3)
  rate     Decimal         @db.Decimal(18, 2)
  amount   Decimal         @db.Decimal(18, 2)

  @@unique([billId, itemId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------- Planning: BOQ and activities ----------

model BoqItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemNo         String
  description    String
  unit           String
  rate           Decimal      @db.Decimal(18, 2)
  originalQty    Decimal      @db.Decimal(18, 3)
  revisedQty     Decimal?     @db.Decimal(18, 3)
  /// Budgeted cost per unit (our cost, not the client's rate): the item's planned margin and its share of the budget
  budgetRate     Decimal?     @db.Decimal(18, 2)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  activities        Activity[]
  measurements      MeasurementSheet[]
  billItems         RaBillItem[]
  workOrderLines    WorkOrderLine[]
  scEnquiryItems    SubcontractEnquiryItem[]
  variationLines    VariationLine[]
  materialNorms     MaterialNorm[]
  resources         BoqResource[]
  rfis              Rfi[]
  materialApprovals MaterialApproval[]

  @@unique([projectId, itemNo])
  @@index([organizationId])
}

model Activity {
  id                  String             @id @default(uuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id])
  projectId           String
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId           String?
  boqItem             BoqItem?           @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  name                String
  unit                String
  plannedQty          Decimal            @db.Decimal(18, 3)
  plannedStart        DateTime?          @db.Date
  plannedEnd          DateTime?          @db.Date
  /// Planned dates when the project's baseline was frozen; null for an activity added after it
  baselineStart       DateTime?          @db.Date
  baselineEnd         DateTime?          @db.Date
  responsibleId       String?
  responsible         User?              @relation("ActivityResponsible", fields: [responsibleId], references: [id])
  /// Checklist a new inspection of this activity starts from
  checklistTemplateId String?
  checklistTemplate   ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  /// Hold point: progress is approved only after a passed inspection (at the same location, when the entry gives one)
  holdPoint           Boolean            @default(false)
  sortOrder           Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  progressEntries  ProgressEntry[]
  stockEntries     StockEntry[]
  machineryLogs    MachineryLog[]
  expenses         Expense[]
  risks            Risk[]
  inspections      Inspection[]
  qualityTests     QualityTest[]
  ncrs             Ncr[]
  workerDays       WorkerAttendance[]
  successorLinks   ActivityLink[]     @relation("LinkPredecessor")
  predecessorLinks ActivityLink[]     @relation("LinkSuccessor")

  @@index([projectId])
  @@index([organizationId])
}

enum ActivityLinkType {
  FS
  SS
  FF
  SF
}

/// The successor waits on the predecessor (v6 item 114): finish to start, start to start, finish to finish or start to
/// finish, with a lag in calendar days (negative for a lead). Both activities are of the same project.
model ActivityLink {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorId  String
  predecessor    Activity         @relation("LinkPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId    String
  successor      Activity         @relation("LinkSuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  type           ActivityLinkType @default(FS)
  lagDays        Int              @default(0)
  createdAt      DateTime         @default(now())

  @@unique([predecessorId, successorId])
  @@index([projectId])
  @@index([successorId])
  @@index([organizationId])
}

/// A key date of a project (contract milestones, handing over a stretch or a floor). Shown as a diamond on the Gantt;
/// achieved once someone records the date it was reached.
model Milestone {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  dueDate        DateTime     @db.Date
  /// Due date when the project's baseline was frozen
  baselineDate   DateTime?    @db.Date
  achievedOn     DateTime?    @db.Date
  note           String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([projectId])
  @@index([organizationId])
}

/// One line of an organisation's standard activity list for a project type. Applied when a project is created
/// (or later from the Activities tab); an organisation without rows for a type uses the built-in list in packages/shared.
model ActivityTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectType    ProjectType
  name           String
  unit           String
  /// Planned start in days from the project start
  startDay       Int
  durationDays   Int
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, projectType, name])
  @@index([organizationId, projectType])
}

// ---------- Site submissions (all share the same approval lifecycle) ----------

model ProgressEntry {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId     String
  activity       Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  quantity       Decimal          @db.Decimal(18, 3)
  remarks        String?
  location       String?
  /// Structured location for the sector views (v4 item 41): chainage in metres, a floor of the project, a village
  chainageFrom   Int?
  chainageTo     Int?
  floor          String?
  village        String?
  manpowerCount  Int?
  machineryUsed  String?
  status         SubmissionStatus @default(DRAFT)
  submittedById  String
  submittedBy    User             @relation("ProgressSubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("ProgressReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments Attachment[]

  @@index([projectId, status])
  @@index([activityId, status])
  @@index([organizationId, status])
  @@index([organizationId, date])
  @@index([projectId, date])
}

model DailyReport {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date               DateTime         @db.Date
  weather            Weather?
  siteCondition      String?
  /// [{ category: string, count: number }]
  manpower           Json             @default("[]")
  /// [{ name: string, hours: number }]
  machinery          Json             @default("[]")
  materialReceived   String?
  workExecuted       String
  testsConducted     String?
  safetyObservations String?
  issues             String?
  nextDayPlan        String?
  status             SubmissionStatus @default(DRAFT)
  submittedById      String
  submittedBy        User             @relation("DprSubmitter", fields: [submittedById], references: [id])
  submittedAt        DateTime?
  reviewedById       String?
  reviewedBy         User?            @relation("DprReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  attachments Attachment[]

  @@index([projectId, date])
  @@index([organizationId, status])
  @@index([organizationId, date])
}

model MaterialRequest {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestNo      String
  requiredDate   DateTime         @db.Date
  priority       MaterialPriority @default(NORMAL)
  remarks        String?
  status         SubmissionStatus @default(DRAFT)
  submittedById  String
  submittedBy    User             @relation("MrSubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("MrReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items          MaterialRequestItem[]
  attachments    Attachment[]
  stockEntries   StockEntry[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  enquiries      Enquiry[]

  @@unique([organizationId, requestNo])
  @@index([projectId, status])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model MaterialRequestItem {
  id            String          @id @default(uuid())
  requestId     String
  request       MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemName      String
  specification String?
  unit          String
  quantity      Decimal         @db.Decimal(18, 3)
  sortOrder     Int             @default(0)

  stockTxns      StockTxn[]
  quotationLines QuotationLine[]
  poLines        PurchaseOrderLine[]
  covers         MaterialRequestCover[]
}

/// Part of a request line met from stock instead of buying it (v5 item 95): an issue from the request's own site, or a
/// transfer from another site. It goes with its store entry: deleting the entry deletes it.
model MaterialRequestCover {
  id                    String              @id @default(uuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id])
  materialRequestItemId String
  materialRequestItem   MaterialRequestItem @relation(fields: [materialRequestItemId], references: [id], onDelete: Cascade)
  stockEntryId          String
  stockEntry            StockEntry          @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  quantity              Decimal             @db.Decimal(18, 3)
  createdAt             DateTime            @default(now())

  @@index([materialRequestItemId])
  @@index([stockEntryId])
  @@index([organizationId])
}

/// Prices asked from vendors for an approved material request (v5 item 95). Each vendor gets its own one-time link.
model Enquiry {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  /// Last day to quote; the links stop working after it
  closesOn          DateTime        @db.Date
  message           String?
  createdById       String
  createdBy         User            @relation("EnquiryCreator", fields: [createdById], references: [id])
  createdAt         DateTime        @default(now())

  tokens EnquiryToken[]

  @@index([materialRequestId])
  @@index([organizationId])
}

/// One vendor's link on an enquiry. The raw token only exists in the link; the table keeps its SHA-256 (like
/// PasswordToken). The supplier's answer becomes their quotation on the request.
model EnquiryToken {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  enquiryId      String
  enquiry        Enquiry      @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  email          String?
  tokenHash      String       @unique
  expiresAt      DateTime
  emailedAt      DateTime?
  emailError     String?
  openedAt       DateTime?
  respondedAt    DateTime?
  quotationId    String?
  quotation      Quotation?   @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  @@unique([enquiryId, vendorId])
  @@index([vendorId])
  @@index([organizationId])
}

// ---------- Attendance (daily register, not an approval submission) ----------

/// Workers present on one project on one day, recorded by the site supervisor. One sheet per project per day.
/// The day's DPR takes its manpower from here; the sheet locks once that DPR is approved.
model AttendanceSheet {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  remarks        String?
  /// Sum of the lines' counts, kept in step on every save so lists can sort and total without a join.
  totalWorkers   Int          @default(0)
  recordedById   String
  recordedBy     User         @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  updatedById    String?
  updatedBy      User?        @relation("AttendanceUpdater", fields: [updatedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines AttendanceLine[]

  @@unique([projectId, date])
  @@index([organizationId, date])
}

/// Head count of one trade (category) from one contractor on the sheet's day.
model AttendanceLine {
  id         String          @id @default(uuid())
  sheetId    String
  sheet      AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  /// Labour contractor, or "Departmental" for the company's own workers
  contractor String
  /// The labour contractor in the vendor master, linked by name (null for departmental workers or a name not in it)
  vendorId   String?
  vendor     Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Trade, e.g. Mason, Helper (MANPOWER_CATEGORIES in shared; free text allowed)
  category   String
  count      Int
  sortOrder  Int             @default(0)

  @@index([sheetId])
  @@index([vendorId])
}

// ---------- Attachments and audit ----------

// ---------- Stock ----------

/// Material master per organisation. Receipts create items from the material request lines (same name and unit).
model Item {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  unit           String
  category       String?
  /// Standard rate per unit; values issues in the project cost view
  rate           Decimal?     @db.Decimal(18, 2)
  /// Diesel, petrol and the like (v5 item 93): issued to machines and counted in the daily fuel position
  isFuel         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  txns              StockTxn[]
  minLevels         StockMinLevel[]
  recoveries        SubcontractBillMaterial[]
  norms             MaterialNorm[]
  excessRecoveries  ExcessMaterialRecovery[]
  mixDesignLines    MixDesignLine[]
  rmcBatchLines     RmcBatchLine[]
  tenderLines       TenderItemLine[]
  materialApprovals MaterialApproval[]
  approvedMakes     ApprovedMake[]

  @@unique([organizationId, name, unit])
}

/// Units of measure the company uses (v4 item 48). Units stay free text on items and lines; this list suggests them
/// so the same unit is written the same way.
model Unit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// As written on items and lines, e.g. Cum, MT, Bag
  code           String
  /// e.g. Cubic metre
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
}

/// One document in the store register: a GRN, an issue slip or a stock adjustment. Its lines are StockTxn rows.
model StockEntry {
  id                 String                 @id @default(uuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id])
  projectId          String
  project            Project                @relation("StockEntryProject", fields: [projectId], references: [id], onDelete: Cascade)
  type               StockEntryType
  /// GRN-2026-0001, ISS-2026-0001, ADJ-2026-0001 (TRO, TRI, RTV, RFS for transfers and returns), numbered per organisation and type
  entryNo            String
  date               DateTime               @db.Date
  /// Receipts: the approved material request this GRN is against
  materialRequestId  String?
  materialRequest    MaterialRequest?       @relation(fields: [materialRequestId], references: [id])
  /// Receipts: the approved purchase order this GRN is against
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id])
  /// Receipts: the supplier's dispatch note it was filled from (v6 item 105)
  supplierDispatchId String?                @unique
  supplierDispatch   SupplierDispatch?      @relation(fields: [supplierDispatchId], references: [id], onDelete: SetNull)
  supplier           String?
  vendorId           String?
  vendor             Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  challanNo          String?
  vehicleNo          String?
  /// Issues: who took the material (contractor, gang or person)
  issuedTo           String?
  /// Issues: the activity the material is for
  activityId         String?
  activity           Activity?              @relation(fields: [activityId], references: [id], onDelete: SetNull)
  /// Issues: the subcontractor's work order the material went to; recovered in their next bill
  workOrderId        String?
  workOrder          WorkOrder?             @relation(fields: [workOrderId], references: [id])
  /// Issues against a work order: the subcontractor bill that recovered it
  subcontractBillId  String?
  subcontractBill    SubcontractBill?       @relation(fields: [subcontractBillId], references: [id], onDelete: SetNull)
  /// Transfers out: the project the material is going to
  toProjectId        String?
  toProject          Project?               @relation("StockTransferTo", fields: [toProjectId], references: [id], onDelete: SetNull)
  /// Transfers in: the transfer out it receives (one receipt per transfer)
  transferOutId      String?                @unique
  transferOut        StockEntry?            @relation("StockTransfer", fields: [transferOutId], references: [id], onDelete: SetNull)
  transferIn         StockEntry?            @relation("StockTransfer")
  remarks            String?
  /// Adjustments: why (v5 item 92); null on adjustments made before reasons were asked
  adjustmentReason   StockAdjustmentReason?
  /// Issues: spares for this maintenance job
  maintenanceJobId   String?
  maintenanceJob     MaintenanceJob?        @relation(fields: [maintenanceJobId], references: [id], onDelete: SetNull)
  /// Fuel issues (v5 item 93): the machine the fuel went into, and its hour meter or odometer then
  equipmentId        String?
  equipment          Equipment?             @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  meterReading       Decimal?               @db.Decimal(18, 2)
  /// Receipts: QA/QC's check of the material (null = not checked yet)
  qcStatus           GrnQcStatus?
  qcAt               DateTime?
  qcById             String?
  qcBy               User?                  @relation("GrnQcBy", fields: [qcById], references: [id], onDelete: SetNull)
  qcNote             String?
  createdById        String
  createdBy          User                   @relation(fields: [createdById], references: [id])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  lines       StockTxn[]
  debitNotes  DebitNote[]
  attachments Attachment[]
  parts       EquipmentPart[]
  covers      MaterialRequestCover[]
  rmcBatch    RmcBatch?

  @@unique([organizationId, entryNo])
  @@index([projectId, date])
  @@index([equipmentId, date])
  @@index([organizationId, type, date])
  @@index([toProjectId])
}

/// Stock movement of one item in one project. Quantity is signed: receipts positive, issues negative.
/// The balance of an item in a project is the sum of its rows.
model StockTxn {
  id                    String               @id @default(uuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id])
  projectId             String
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entryId               String
  entry                 StockEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item                 @relation(fields: [itemId], references: [id])
  /// Copy of the entry's type so balances can be summed by kind without a join
  type                  StockEntryType
  date                  DateTime             @db.Date
  quantity              Decimal              @db.Decimal(18, 3)
  /// Receipts: the material request line this quantity was received against
  materialRequestItemId String?
  materialRequestItem   MaterialRequestItem? @relation(fields: [materialRequestItemId], references: [id])
  /// Receipts against a PO: the PO line received
  purchaseOrderLineId   String?
  purchaseOrderLine     PurchaseOrderLine?   @relation(fields: [purchaseOrderLineId], references: [id])
  /// Receipts: quantity QA/QC rejected (to go back to the supplier)
  rejectedQty           Decimal?             @db.Decimal(18, 3)
  sortOrder             Int                  @default(0)

  @@index([projectId, itemId])
  @@index([entryId])
  @@index([materialRequestItemId])
  @@index([purchaseOrderLineId])
}

/// Minimum stock of an item at a project. Falling below it raises a low-stock alert.
model StockMinLevel {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  minQty         Decimal      @db.Decimal(18, 3)
  updatedById    String
  updatedBy      User         @relation(fields: [updatedById], references: [id])
  updatedAt      DateTime     @updatedAt

  @@unique([projectId, itemId])
}

/// Material reconciliation norm: how much of a store item one unit of a BOQ item should use (8.2 bags of cement per
/// cum of M25, say), with the wastage the project allows. Approved progress × norm is the theoretical consumption that
/// net issues to site are checked against.
model MaterialNorm {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId      String
  boqItem        BoqItem      @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Item units per unit of the BOQ item; six places, as norms such as 0.0012 MT of steel per kg are small
  qtyPerUnit     Decimal      @db.Decimal(18, 6)
  /// Allowed wastage over the theoretical quantity, in %
  wastagePct     Decimal      @default(0) @db.Decimal(5, 2)
  note           String?
  updatedById    String
  updatedBy      User         @relation(fields: [updatedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([boqItemId, itemId])
  @@index([projectId])
  @@index([organizationId])
}

/// Rate analysis (v5 item 92): the labour and machine hours one unit of a BOQ item takes, next to its material norms.
/// The estimate prices them at LabourRate and the company's equipment rates for the item's built-up rate.
model BoqResource {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId      String
  boqItem        BoqItem         @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  kind           BoqResourceKind
  /// The trade (Mason, Helper) or the equipment category (Concreting, Compaction), as the rates are kept
  name           String
  /// Man-days or machine hours per unit of the BOQ item
  qtyPerUnit     Decimal         @db.Decimal(18, 6)
  note           String?
  updatedById    String
  updatedBy      User            @relation(fields: [updatedById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([boqItemId, kind, name])
  @@index([projectId])
  @@index([organizationId])
}

/// Material a subcontractor used beyond the norm and its wastage, to be taken off their next running bill (v5 item 92).
/// Raised from the reconciliation's subcontractor view; the next bill prepared or re-saved on the work order takes it.
model ExcessMaterialRecovery {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workOrderId       String
  workOrder         WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item             @relation(fields: [itemId], references: [id])
  quantity          Decimal          @db.Decimal(18, 3)
  rate              Decimal          @db.Decimal(18, 2)
  amount            Decimal          @db.Decimal(18, 2)
  note              String?
  /// The bill that takes it off; null until a bill on the work order is prepared or re-saved
  subcontractBillId String?
  subcontractBill   SubcontractBill? @relation(fields: [subcontractBillId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User             @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())

  @@index([workOrderId])
  @@index([subcontractBillId])
  @@index([organizationId])
}

/// A machine or vehicle: owned by the company or hired. `projectId` is where it is deployed now (null = yard / unassigned).
model Equipment {
  id                   String             @id @default(uuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id])
  code                 String
  name                 String
  category             String?
  ownership            EquipmentOwnership @default(OWNED)
  /// Hire agency for hired machines
  supplier             String?
  vendorId             String?
  vendor               Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  registrationNo       String?
  rate                 Decimal?           @db.Decimal(18, 2)
  rateUnit             EquipmentRateUnit  @default(HOUR)
  /// Hire terms of a hired machine (v5 item 91): hours paid for a month even if it worked less, who fuels it, and
  /// whether the owner's operator comes with it
  hireMinHours         Decimal?           @db.Decimal(18, 2)
  hireFuelBy           HireFuelBy?
  hireOperator         Boolean?
  projectId            String?
  project              Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isActive             Boolean            @default(true)
  /// Service every so many working hours and / or days (v4 item 42); the last service resets both
  serviceIntervalHours Decimal?           @db.Decimal(18, 2)
  serviceIntervalDays  Int?
  lastServiceDate      DateTime?          @db.Date
  lastServiceMeter     Decimal?           @db.Decimal(18, 2)
  /// Fuel norm (v5 item 93): litres an hour, or km a litre for vehicles, and how far the average may stray (%)
  fuelNorm             Decimal?           @db.Decimal(18, 3)
  fuelNormUnit         FuelNormUnit?
  fuelTolerancePct     Decimal?           @db.Decimal(5, 2)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  logs            MachineryLog[]
  fuelIssues      StockEntry[]
  parts           EquipmentPart[]
  maintenanceJobs MaintenanceJob[]
  documents       EquipmentDocument[]
  drivers         Driver[]
  vendorBills     VendorBill[]
  loans           EquipmentLoan[]

  @@unique([organizationId, code])
  @@index([organizationId, projectId])
}

/// A tyre or battery on a machine (v5 item 93): fitted with the meter then, removed with the meter and why. Its life is
/// the meter run between the two (hours or km), or up to the machine's latest reading while still on.
model EquipmentPart {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  equipmentId      String
  equipment        Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  kind             EquipmentPartKind
  /// e.g. Front left, Rear right outer, Battery 1
  position         String?
  make             String?
  serialNo         String?
  fittedOn         DateTime          @db.Date
  fittedMeter      Decimal?          @db.Decimal(18, 2)
  removedOn        DateTime?         @db.Date
  removedMeter     Decimal?          @db.Decimal(18, 2)
  removalReason    String?
  cost             Decimal?          @db.Decimal(18, 2)
  /// Fitted on this job card, or issued from the store on this entry
  maintenanceJobId String?
  maintenanceJob   MaintenanceJob?   @relation(fields: [maintenanceJobId], references: [id], onDelete: SetNull)
  stockEntryId     String?
  stockEntry       StockEntry?       @relation(fields: [stockEntryId], references: [id], onDelete: SetNull)
  note             String?
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([equipmentId, kind])
  @@index([organizationId])
}

/// One machine's day at one project: hours worked / idle / breakdown, diesel and hour-meter. Goes through approval.
model MachineryLog {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipmentId    String
  equipment      Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  hoursWorked    Decimal          @db.Decimal(18, 2)
  idleHours      Decimal          @default(0) @db.Decimal(18, 2)
  breakdownHours Decimal          @default(0) @db.Decimal(18, 2)
  dieselLitres   Decimal?         @db.Decimal(18, 3)
  meterStart     Decimal?         @db.Decimal(18, 2)
  meterEnd       Decimal?         @db.Decimal(18, 2)
  operatorName   String?
  activityId     String?
  activity       Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  workDone       String?
  breakdownNote  String?
  remarks        String?
  status         SubmissionStatus @default(DRAFT)
  submittedById  String
  submittedBy    User             @relation("MachinerySubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("MachineryReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  /// The hire bill that billed this approved log (v5 item 91)
  vendorBillId   String?
  vendorBill     VendorBill?      @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments Attachment[]

  @@index([projectId, status])
  @@index([equipmentId, date])
  @@index([organizationId, status])
  @@index([organizationId, date])
  @@index([vendorBillId])
}

/// A site expense paid at the project (bill with GST), approved like other submissions. Approved expenses are project cost.
model Expense {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// EXP-<year>-0001 per organisation
  expenseNo      String
  date           DateTime         @db.Date
  category       ExpenseCategory
  description    String
  vendor         String?
  vendorGstin    String?
  vendorId       String?
  vendorRef      Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  billNo         String?
  /// Taxable value
  amount         Decimal          @db.Decimal(18, 2)
  gstRate        Decimal          @default(0) @db.Decimal(5, 2)
  gstAmount      Decimal          @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal          @db.Decimal(18, 2)
  paymentMode    PaymentMode      @default(CASH)
  activityId     String?
  activity       Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  remarks        String?
  status         SubmissionStatus @default(DRAFT)
  submittedById  String
  submittedBy    User             @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  /// Set once the voucher is in a Tally export; undoing the export clears it
  tallyExportId  String?
  tallyExport    TallyExport?     @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments Attachment[]

  @@unique([organizationId, expenseNo])
  @@index([projectId, status])
  @@index([organizationId, status])
  @@index([projectId, date])
  @@index([tallyExportId])
  @@index([organizationId, date])
}

/// Delay and risk register entry. Not an approval submission: it stays open, is reviewed and closed.
/// A DELAY records days lost and who caused them (for extension-of-time claims); a RISK is scored probability × impact.
model Risk {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// RISK-<year>-0001 per organisation
  riskNo           String
  kind             RiskKind
  category         RiskCategory
  title            String
  description      String?
  activityId       String?
  activity         Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  /// Who is following it up
  ownerId          String?
  owner            User?        @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// 1 (very low) to 5 (very high)
  probability      Int
  impact           Int
  /// probability × impact, stored for sorting and the heat map
  score            Int
  mitigation       String?
  /// Target date for the mitigation / next review
  dueDate          DateTime?    @db.Date
  status           RiskStatus   @default(OPEN)
  /// Delay only: when work was held up and when it resumed (null while it is still holding work up)
  delayStart       DateTime?    @db.Date
  delayEnd         DateTime?    @db.Date
  /// Delay only: days lost as agreed; computed from the dates when not given
  daysLost         Int?
  responsibleParty DelayParty?
  /// An extension of time has been claimed from the client for this delay
  eotClaimed       Boolean      @default(false)
  /// Days of extension the client granted for this delay (adds to the project's completion date)
  eotGrantedDays   Int?
  closedAt         DateTime?
  closureNote      String?
  raisedById       String
  raisedBy         User         @relation("RiskRaiser", fields: [raisedById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  attachments Attachment[]
  letters     Letter[]
  rfis        Rfi[]

  @@unique([organizationId, riskNo])
  @@index([projectId, status])
  @@index([organizationId, status])
}

/// A measurement book (MB) entry: one BOQ item measured at one location on one day, as dimension lines.
/// Approved sheets roll up into the BOQ item's measured (billable) quantity.
model MeasurementSheet {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId         String
  boqItem           BoqItem          @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  /// MB-<year>-0001 per organisation
  mbNo              String
  date              DateTime         @db.Date
  /// Chainage, grid, floor, zone
  location          String
  /// Structured location for the sector views (v4 item 41): chainage in metres, a floor of the project, a village
  chainageFrom      Int?
  chainageTo        Int?
  floor             String?
  village           String?
  remarks           String?
  /// Sum of the lines (deductions negative), in the BOQ item's unit
  totalQty          Decimal          @db.Decimal(18, 3)
  status            SubmissionStatus @default(DRAFT)
  submittedById     String
  submittedBy       User             @relation("MeasurementSubmitter", fields: [submittedById], references: [id])
  submittedAt       DateTime?
  reviewedById      String?
  reviewedBy        User?            @relation("MeasurementReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNote        String?
  /// The RA bill this measurement was billed in (set when a bill takes it; it cannot go into another bill)
  raBillId          String?
  raBill            RaBill?          @relation(fields: [raBillId], references: [id], onDelete: SetNull)
  /// Work done by a subcontractor under this work order (the same measurement also goes to the client's RA bill)
  workOrderId       String?
  workOrder         WorkOrder?       @relation(fields: [workOrderId], references: [id])
  /// The subcontractor bill this measurement was paid in
  subcontractBillId String?
  subcontractBill   SubcontractBill? @relation(fields: [subcontractBillId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  lines       MeasurementLine[]
  attachments Attachment[]

  @@unique([organizationId, mbNo])
  @@index([projectId, status])
  @@index([boqItemId, status])
  @@index([organizationId, status])
  @@index([workOrderId])
  @@index([organizationId, date])
}

/// One row of a measurement: nos × length × breadth × depth (blank dimensions count as 1); a deduction is negative.
model MeasurementLine {
  id          String           @id @default(uuid())
  sheetId     String
  sheet       MeasurementSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  description String
  nos         Decimal?         @db.Decimal(18, 3)
  length      Decimal?         @db.Decimal(18, 3)
  breadth     Decimal?         @db.Decimal(18, 3)
  depth       Decimal?         @db.Decimal(18, 3)
  deduct      Boolean          @default(false)
  quantity    Decimal          @db.Decimal(18, 3)
  sortOrder   Int              @default(0)

  @@index([sheetId])
}

/// Running account (RA) bill N of a project to its client, built from approved measurements (v3 item 18).
/// A submission like the others (six status columns, approval matrix); once approved it is sent, certified, paid.
/// Amounts are on the claimed quantities until the client certifies, then on the certified ones (claimed* keep the claim).
model RaBill {
  id                    String           @id @default(uuid())
  organizationId        String
  organization          Organization     @relation(fields: [organizationId], references: [id])
  projectId             String
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 ... per project
  billNo                Int
  isFinal               Boolean          @default(false)
  billDate              DateTime         @db.Date
  /// Approved measurements dated up to this day and not in an earlier bill are billed
  measuredUpTo          DateTime         @db.Date
  remarks               String?
  /// Value of work up to the previous bill / in this bill (taxable) / up to date
  grossPrevious         Decimal          @db.Decimal(18, 2)
  grossAmount           Decimal          @db.Decimal(18, 2)
  grossUpto             Decimal          @db.Decimal(18, 2)
  gstRate               Decimal          @db.Decimal(5, 2)
  gstAmount             Decimal          @db.Decimal(18, 2)
  // Contract percentages taken when the bill was prepared, and the deductions they give
  retentionPct          Decimal          @db.Decimal(5, 2)
  securityDepositPct    Decimal          @db.Decimal(5, 2)
  advanceRecoveryPct    Decimal          @db.Decimal(5, 2)
  tdsPct                Decimal          @db.Decimal(5, 2)
  gstTdsPct             Decimal          @db.Decimal(5, 2)
  labourCessPct         Decimal          @db.Decimal(5, 2)
  retentionAmount       Decimal          @db.Decimal(18, 2)
  securityDepositAmount Decimal          @db.Decimal(18, 2)
  advanceRecoveryAmount Decimal          @db.Decimal(18, 2)
  tdsAmount             Decimal          @db.Decimal(18, 2)
  gstTdsAmount          Decimal          @db.Decimal(18, 2)
  labourCessAmount      Decimal          @db.Decimal(18, 2)
  otherDeduction        Decimal          @default(0) @db.Decimal(18, 2)
  otherDeductionNote    String?
  totalDeductions       Decimal          @db.Decimal(18, 2)
  /// gross + GST - deductions
  netPayable            Decimal          @db.Decimal(18, 2)
  /// Price variation on this bill's work value (negative when the indices fell); in the GST and deduction base
  pvAmount              Decimal          @default(0) @db.Decimal(18, 2)
  /// The month the current indices are for, and any note on where they came from
  pvIndexMonth          DateTime?        @db.Date
  pvNote                String?
  /// What was claimed, kept when the client certifies a different amount
  claimedGross          Decimal?         @db.Decimal(18, 2)
  claimedNet            Decimal?         @db.Decimal(18, 2)
  stage                 BillStage        @default(NOT_SENT)
  sentDate              DateTime?        @db.Date
  certifiedDate         DateTime?        @db.Date
  /// The client's certificate / measurement check reference
  certificateNo         String?
  paidDate              DateTime?        @db.Date
  status                SubmissionStatus @default(DRAFT)
  submittedById         String
  submittedBy           User             @relation("BillSubmitter", fields: [submittedById], references: [id])
  submittedAt           DateTime?
  reviewedById          String?
  reviewedBy            User?            @relation("BillReviewer", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  reviewNote            String?
  /// Set once the voucher is in a Tally export; undoing the export clears it
  tallyExportId         String?
  tallyExport           TallyExport?     @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  items        RaBillItem[]
  pvLines      RaBillPvLine[]
  measurements MeasurementSheet[]
  attachments  Attachment[]
  receipts     Receipt[]

  @@unique([projectId, billNo])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([tallyExportId])
  @@index([organizationId, billDate])
}

/// One BOQ item on an RA bill: quantity up to the previous bill, in this bill and up to date, at the BOQ rate.
model RaBillItem {
  id           String   @id @default(uuid())
  billId       String
  bill         RaBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  boqItemId    String
  boqItem      BoqItem  @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  /// BOQ quantity (revised, else original) and rate when the bill was prepared
  boqQty       Decimal  @db.Decimal(18, 3)
  rate         Decimal  @db.Decimal(18, 2)
  prevQty      Decimal  @db.Decimal(18, 3)
  /// Claimed in this bill (up to date measured - previous bills)
  thisQty      Decimal  @db.Decimal(18, 3)
  uptoQty      Decimal  @db.Decimal(18, 3)
  /// This bill's quantity as the client certified it (null until certified)
  certifiedQty Decimal? @db.Decimal(18, 3)
  /// (certifiedQty ?? thisQty) × rate
  amount       Decimal  @db.Decimal(18, 2)
  sortOrder    Int      @default(0)

  @@unique([billId, boqItemId])
  @@index([boqItemId])
}

/// One component of a contract's price variation formula (v4 item 50): its share of the work value and the index it
/// follows (e.g. Cement 15% on the RBI WPI for cement). The rest of the work value is fixed.
model PriceVariationComponent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  /// % of the work value that moves with this index
  sharePct       Decimal      @db.Decimal(5, 2)
  /// Index on the contract's base date
  baseIndex      Decimal      @db.Decimal(12, 3)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([projectId])
}

/// One component of the price variation on an RA bill, copied from the contract with this bill's index:
/// amount = work value × share % × (current − base) / base.
model RaBillPvLine {
  id           String  @id @default(uuid())
  billId       String
  bill         RaBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  name         String
  sharePct     Decimal @db.Decimal(5, 2)
  baseIndex    Decimal @db.Decimal(12, 3)
  currentIndex Decimal @db.Decimal(12, 3)
  amount       Decimal @db.Decimal(18, 2)
  sortOrder    Int     @default(0)

  @@index([billId])
}

/// What a receipt is for: a bill, or the release of retention or security deposit the client held
enum ReceiptKind {
  BILL
  RETENTION_RELEASE
  DEPOSIT_RELEASE
}

/// Money received from the client, with the deductions it actually made (v3 item 19)
model Receipt {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  projectId             String
  project               Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind                  ReceiptKind  @default(BILL)
  /// The bill paid (kind BILL only)
  billId                String?
  bill                  RaBill?      @relation(fields: [billId], references: [id], onDelete: Restrict)
  receiptDate           DateTime     @db.Date
  /// Credited to the bank
  amount                Decimal      @db.Decimal(18, 2)
  mode                  PaymentMode  @default(BANK)
  /// UTR, cheque or advice number
  reference             String?
  // Deducted by the client on this payment (kind BILL)
  tdsAmount             Decimal      @default(0) @db.Decimal(18, 2)
  gstTdsAmount          Decimal      @default(0) @db.Decimal(18, 2)
  retentionAmount       Decimal      @default(0) @db.Decimal(18, 2)
  securityDepositAmount Decimal      @default(0) @db.Decimal(18, 2)
  advanceRecoveryAmount Decimal      @default(0) @db.Decimal(18, 2)
  labourCessAmount      Decimal      @default(0) @db.Decimal(18, 2)
  otherDeduction        Decimal      @default(0) @db.Decimal(18, 2)
  otherDeductionNote    String?
  remarks               String?
  createdById           String
  createdBy             User         @relation("ReceiptCreator", fields: [createdById], references: [id])
  /// Set once the voucher is in a Tally export; undoing the export clears it
  tallyExportId         String?
  tallyExport           TallyExport? @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([organizationId, receiptDate])
  @@index([projectId])
  @@index([billId])
  @@index([tallyExportId])
}

/// Money paid to a vendor or subcontractor against an approved bill (payables, v3 item 23). A bill is paid once its
/// payments (amount paid plus what was deducted at payment) settle what it says is payable.
model VendorPayment {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId           String
  vendor             Vendor           @relation(fields: [vendorId], references: [id])
  /// One of the two bills, or (an advance, v5 item 90) the purchase order or work order it is paid against
  vendorBillId       String?
  vendorBill         VendorBill?      @relation(fields: [vendorBillId], references: [id], onDelete: Restrict)
  subcontractBillId  String?
  subcontractBill    SubcontractBill? @relation(fields: [subcontractBillId], references: [id], onDelete: Restrict)
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  workOrderId        String?
  workOrder          WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  /// The approved payment request it draws on
  paymentRequestId   String?
  paymentRequest     PaymentRequest?  @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  paymentDate        DateTime         @db.Date
  /// Paid out of the bank (or cash)
  amount             Decimal          @db.Decimal(18, 2)
  mode               PaymentMode      @default(BANK)
  /// UTR, cheque or voucher number
  reference          String?
  /// TDS deducted at payment (vendor bills: section 194Q or 194C); a subcontractor bill's TDS is already in its net payable
  tdsAmount          Decimal          @default(0) @db.Decimal(18, 2)
  otherDeduction     Decimal          @default(0) @db.Decimal(18, 2)
  otherDeductionNote String?
  remarks            String?
  createdById        String
  createdBy          User             @relation("VendorPaymentCreator", fields: [createdById], references: [id])
  /// Set once the voucher is in a Tally export; undoing the export clears it
  tallyExportId      String?
  tallyExport        TallyExport?     @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([organizationId, paymentDate])
  @@index([projectId])
  @@index([vendorId])
  @@index([vendorBillId])
  @@index([subcontractBillId])
  @@index([purchaseOrderId])
  @@index([workOrderId])
  @@index([paymentRequestId])
  @@index([tallyExportId])
}

/// What a payment request is for (v5 item 90).
enum PaymentRequestKind {
  BILL
  PO_ADVANCE
  WO_ADVANCE
  /// A site asks head office for money (v6 item 107): released into the site's imprest or paid to a party on account
  FUND_REQUEST
}

/// What a site's fund request is for (v6 item 107).
enum FundPurpose {
  WAGES
  LOCAL_PURCHASE
  PETTY_CONTRACTOR
  SITE_RUNNING
  OTHER
}

/// A request to release money (v5 item 90): pay an approved vendor or subcontractor bill, or an advance against a
/// purchase order or work order. Approved through the approval matrix (submission type PAYMENT_REQUEST) before accounts
/// pays; payments draw on it up to its amount.
model PaymentRequest {
  id                String             @id @default(uuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  /// The site the money is for (its approvers decide; its cost)
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The party paid; a fund request released into an imprest has none
  vendorId          String?
  vendor            Vendor?            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// Fund requests (v6 item 107): what for, the imprest it tops up (else the party is paid on account), and the site
  /// that asked when it asks on behalf of another
  purpose           FundPurpose?
  imprestId         String?
  imprest           Imprest?           @relation(fields: [imprestId], references: [id], onDelete: NoAction)
  raisedAtProjectId String?
  raisedAtProject   Project?           @relation("FundRequestRaisedAt", fields: [raisedAtProjectId], references: [id], onDelete: SetNull)
  /// PR-<year>-0001 per organisation
  requestNo         String
  kind              PaymentRequestKind
  /// Exactly one, by kind: a bill (BILL), the purchase order (PO_ADVANCE) or the work order (WO_ADVANCE)
  vendorBillId      String?
  vendorBill        VendorBill?        @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  subcontractBillId String?
  subcontractBill   SubcontractBill?   @relation(fields: [subcontractBillId], references: [id], onDelete: Cascade)
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  workOrderId       String?
  workOrder         WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  amount            Decimal            @db.Decimal(18, 2)
  /// How it should be paid (bank, UPI, cash)
  mode              PaymentMode        @default(BANK)
  neededBy          DateTime?          @db.Date
  reason            String?
  /// Settled by payments drawing on it, kept in step by payables
  paidAmount        Decimal            @default(0) @db.Decimal(18, 2)
  /// The day the last payment settled it in full
  paidDate          DateTime?          @db.Date
  status            SubmissionStatus   @default(DRAFT)
  submittedById     String
  submittedBy       User               @relation("PayRequestSubmitter", fields: [submittedById], references: [id])
  submittedAt       DateTime?
  reviewedById      String?
  reviewedBy        User?              @relation("PayRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  payments    VendorPayment[]
  /// Fund requests released into an imprest
  releases    ImprestEntry[]
  attachments Attachment[]

  @@unique([organizationId, requestNo])
  @@index([imprestId])
  @@index([raisedAtProjectId])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([vendorBillId])
  @@index([subcontractBillId])
  @@index([purchaseOrderId])
  @@index([workOrderId])
}

model Attachment {
  id                 String             @id @default(uuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id])
  fileName           String
  mimeType           String
  size               Int
  /// Storage key: absolute URL (object storage), "db:<id>" (stored in `data`), or relative path served under /uploads
  storagePath        String
  /// File bytes when stored in the database (serverless hosts without a disk or object store)
  data               Bytes?
  uploadedById       String
  uploadedBy         User               @relation(fields: [uploadedById], references: [id])
  progressEntryId    String?
  progressEntry      ProgressEntry?     @relation(fields: [progressEntryId], references: [id], onDelete: Cascade)
  dailyReportId      String?
  dailyReport        DailyReport?       @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  materialRequestId  String?
  materialRequest    MaterialRequest?   @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  stockEntryId       String?
  stockEntry         StockEntry?        @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  machineryLogId     String?
  machineryLog       MachineryLog?      @relation(fields: [machineryLogId], references: [id], onDelete: Cascade)
  expenseId          String?
  expense            Expense?           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  measurementId      String?
  measurement        MeasurementSheet?  @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  riskId             String?
  risk               Risk?              @relation(fields: [riskId], references: [id], onDelete: Cascade)
  raBillId           String?
  raBill             RaBill?            @relation(fields: [raBillId], references: [id], onDelete: Cascade)
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendorBillId       String?
  vendorBill         VendorBill?        @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  workOrderId        String?
  workOrder          WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  subcontractBillId  String?
  subcontractBill    SubcontractBill?   @relation(fields: [subcontractBillId], references: [id], onDelete: Cascade)
  inspectionId       String?
  inspection         Inspection?        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  qualityTestId      String?
  qualityTest        QualityTest?       @relation(fields: [qualityTestId], references: [id], onDelete: Cascade)
  ncrId              String?
  ncr                Ncr?               @relation(fields: [ncrId], references: [id], onDelete: Cascade)
  revisionId         String?
  revision           DocumentRevision?  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  drawingMarkups     DrawingMarkup[]
  letterId           String?
  letter             Letter?            @relation(fields: [letterId], references: [id], onDelete: Cascade)
  variationId        String?
  variation          Variation?         @relation(fields: [variationId], references: [id], onDelete: Cascade)
  safetyIncidentId   String?
  safetyIncident     SafetyIncident?    @relation(fields: [safetyIncidentId], references: [id], onDelete: Cascade)
  toolboxTalkId      String?
  toolboxTalk        ToolboxTalk?       @relation(fields: [toolboxTalkId], references: [id], onDelete: Cascade)
  workPermitId       String?
  workPermit         WorkPermit?        @relation(fields: [workPermitId], references: [id], onDelete: Cascade)
  maintenanceJobId   String?
  maintenanceJob     MaintenanceJob?    @relation(fields: [maintenanceJobId], references: [id], onDelete: Cascade)
  equipmentDocId     String?
  equipmentDoc       EquipmentDocument? @relation(fields: [equipmentDocId], references: [id], onDelete: Cascade)
  complianceDocId    String?
  complianceDoc      ComplianceDoc?     @relation(fields: [complianceDocId], references: [id], onDelete: Cascade)
  tenderId           String?
  tender             Tender?            @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  defectId           String?
  defect             Defect?            @relation(fields: [defectId], references: [id], onDelete: Cascade)
  handoverId         String?
  handover           ProjectHandover?   @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  rfiId              String?
  rfi                Rfi?               @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  paymentRequestId   String?
  paymentRequest     PaymentRequest?    @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  /// An employee's documents (v6 item 99): ID, certificates, signed letters
  employeeId         String?
  employee           Employee?          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// A supplier's invoice sent on the supplier portal (v6 item 105)
  supplierInvoiceId  String?
  supplierInvoice    SupplierInvoice?   @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  /// A material or sample approval request's catalogue, test certificates and photos (v6 item 113)
  materialApprovalId String?
  materialApproval   MaterialApproval?  @relation(fields: [materialApprovalId], references: [id], onDelete: Cascade)
  /// When the PDF's text was read into DocumentPage (Ask the contract); null = not yet
  textIndexedAt      DateTime?
  /// Pages with text found; 0 for a scanned PDF or one that could not be read
  textPages          Int?
  /// Why the PDF could not be read, when it could not (shown on its page view); null when it was read
  textError          String?
  createdAt          DateTime           @default(now())

  pages      DocumentPage[]
  photoCheck PhotoCheck?

  @@index([organizationId])
  // Every record lists its files: one index per parent column (item 83).
  @@index([progressEntryId])
  @@index([dailyReportId])
  @@index([materialRequestId])
  @@index([stockEntryId])
  @@index([machineryLogId])
  @@index([expenseId])
  @@index([measurementId])
  @@index([riskId])
  @@index([raBillId])
  @@index([purchaseOrderId])
  @@index([vendorBillId])
  @@index([workOrderId])
  @@index([subcontractBillId])
  @@index([inspectionId])
  @@index([qualityTestId])
  @@index([ncrId])
  @@index([revisionId])
  @@index([materialApprovalId])
  @@index([letterId])
  @@index([variationId])
  @@index([safetyIncidentId])
  @@index([toolboxTalkId])
  @@index([workPermitId])
  @@index([maintenanceJobId])
  @@index([equipmentDocId])
  @@index([complianceDocId])
  @@index([tenderId])
  @@index([defectId])
  @@index([handoverId])
  @@index([rfiId])
  @@index([paymentRequestId])
  @@index([employeeId])
  @@index([supplierInvoiceId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     String
  entityId       String
  action         String
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id])
  note           String?
  createdAt      DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

// ---------- Notifications ----------

/// In-app notification for one user. Push and email are delivery channels for the same row.
model Notification {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  body           String
  projectId      String?
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Submission type (PROGRESS | DPR | MATERIAL_REQUEST) when the notification points at an entry
  entityType     String?
  entityId       String?
  readAt         DateTime?
  /// When the Expo push was handed to the push service (null = not pushed / no device)
  pushedAt       DateTime?
  /// When the email for this notification was handed to the email provider
  emailedAt      DateTime?
  /// Scheduled jobs set e.g. "DPR_REMINDER:<projectId>:<date>" so a re-run never notifies twice
  dedupeKey      String?
  createdAt      DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([organizationId, type, createdAt])
}

/// One-time set-password link (invite or reset). Only a SHA-256 of the token is stored.
model PasswordToken {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        PasswordTokenPurpose
  tokenHash      String               @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime             @default(now())

  @@index([userId])
  @@index([organizationId])
}

/// One WhatsApp or SMS message handed (or not) to the provider. Kept as the company's message log.
model OutboundMessage {
  id             String                @id @default(uuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The in-app notification this message carries, when there is one
  notificationId String?
  channel        MessageChannel
  template       MessageTemplate
  /// Number in international form without "+", e.g. 919876543210
  to             String
  /// The text as the recipient reads it
  body           String
  status         OutboundMessageStatus
  /// The provider's message id when sent
  providerRef    String?
  error          String?
  createdAt      DateTime              @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
}

/// Expo push token of one device of one user. A user may have several devices.
model PushToken {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String       @unique
  platform   PushPlatform
  deviceName String?
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  @@index([userId])
}

// ---------- Cost ----------

/// Daily wage per trade (attendance category), used to value attendance in the project cost view.
model LabourRate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// Matches AttendanceLine.category (case-insensitive)
  category       String
  dailyRate      Decimal      @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, category])
}

/// How vouchers go to Tally: the company to import into, its GST state and the Tally ledger for each Nirmaan
/// account (clients, vendors, expense categories and the fixed ledgers), where it differs from the default name.
model TallyConfig {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The company name as it is in Tally (SVCURRENTCOMPANY); empty imports into the open company
  companyName    String?
  /// Two-digit GST state code of the registration the bills are raised from (CGST + SGST within it, IGST outside)
  stateCode      String?
  /// Projects as Tally cost centres on income and expense lines
  costCentres    Boolean      @default(true)
  /// { "<ledger key>": "<Tally ledger name>" } for the ledgers renamed from their default
  ledgers        Json         @default("{}")
  updatedAt      DateTime     @updatedAt
}

/// One download of vouchers for Tally. Its vouchers point at it so none goes twice; deleting it releases them.
model TallyExport {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  /// Vouchers dated on or before this day that were not yet exported
  upTo             DateTime          @db.Date
  fromDate         DateTime?         @db.Date
  voucherCount     Int
  /// { "SALES": 2, "RECEIPT": 1, ... }
  counts           Json
  xml              String
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id])
  createdAt        DateTime          @default(now())
  raBills          RaBill[]
  receipts         Receipt[]
  vendorBills      VendorBill[]
  debitNotes       DebitNote[]
  subcontractBills SubcontractBill[]
  vendorPayments   VendorPayment[]
  expenses         Expense[]
  payrollRuns      PayrollRun[]      @relation("PayrollRunTally")
  payrollPayments  PayrollRun[]      @relation("PayrollRunPaymentTally")
  staffLoans       StaffLoan[]
  rmcInvoices      RmcInvoice[]
  rmcReceipts      RmcReceipt[]
  equipmentLoans   EquipmentLoan[]
  loanEmis         LoanEmi[]

  @@index([organizationId, createdAt])
}

// ---------- Quality ----------

/// A standard inspection checklist ("Reinforcement before concreting"): the points an inspector checks.
model ChecklistTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  items          String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  activities Activity[]

  @@unique([organizationId, name])
}

/// Inspection request from site for an activity at a location, passed or failed by QA/QC against a checklist.
/// A submission: SUBMITTED = requested, APPROVED = passed, REJECTED = failed, CHANGES_REQUESTED = re-inspect after rectification.
model Inspection {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId     String
  activity       Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  /// INS-2026-0001
  inspectionNo   String
  /// The date the work is ready for inspection
  date           DateTime         @db.Date
  location       String
  remarks        String?
  /// Name of the checklist the points were copied from
  checklistName  String?
  /// [{ item, result: PASS | FAIL | NA | null, remark }], copied from the template when requested and filled in by the inspector
  checklist      Json             @default("[]")
  status         SubmissionStatus @default(DRAFT)
  submittedById  String
  submittedBy    User             @relation("InspectionRequester", fields: [submittedById], references: [id])
  submittedAt    DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("InspectionInspector", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  /// The client's engineer or consultant who attended the inspection (client portal), with their remarks
  witnessedById  String?
  witnessedBy    User?            @relation("InspectionWitness", fields: [witnessedById], references: [id])
  witnessedAt    DateTime?
  witnessNote    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments Attachment[]
  ncrs        Ncr[]

  @@unique([organizationId, inspectionNo])
  @@index([projectId, status])
  @@index([activityId, status])
  @@index([organizationId, status])
  @@index([organizationId, date])
}

/// A quality test: a sample taken on a date, the specification and its readings (cubes at 7 and 28 days).
/// The result is decided by the last reading: against specMin / specMax when given, else as recorded.
model QualityTest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId     String?
  activity       Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  /// TST-2026-0001
  testNo         String
  kind           TestKind
  /// e.g. "M25 cubes, GF slab bays 1 to 4"
  title          String
  location       String?
  sampledOn      DateTime     @db.Date
  /// As written in the contract, e.g. "Not less than 25 N/mm2 at 28 days"
  specification  String?
  unit           String?
  specMin        Decimal?     @db.Decimal(18, 3)
  specMax        Decimal?     @db.Decimal(18, 3)
  result         TestResult   @default(PENDING)
  remarks        String?
  createdById    String
  createdBy      User         @relation("TestCreator", fields: [createdById], references: [id])
  /// Cubes taken from an RMC truck (v6 item 104)
  rmcBatchId     String?      @unique
  rmcBatch       RmcBatch?    @relation(fields: [rmcBatchId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  readings    QualityTestReading[]
  attachments Attachment[]
  ncrs        Ncr[]

  @@unique([organizationId, testNo])
  @@index([projectId, result])
  @@index([organizationId, kind])
}

/// One reading of a test: "7 days", "28 days" or "Result", due on a date, with the value once tested.
model QualityTestReading {
  id        String      @id @default(uuid())
  testId    String
  test      QualityTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  label     String
  dueOn     DateTime?   @db.Date
  value     Decimal?    @db.Decimal(18, 3)
  testedOn  DateTime?   @db.Date
  remarks   String?
  sortOrder Int         @default(0)

  @@index([testId])
  @@index([dueOn])
}

/// Non-conformance report: what is wrong, then site's cause and corrective action, then QA/QC's closure.
model Ncr {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId       String?
  activity         Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  inspectionId     String?
  inspection       Inspection?  @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  qualityTestId    String?
  qualityTest      QualityTest? @relation(fields: [qualityTestId], references: [id], onDelete: SetNull)
  /// NCR-2026-0001
  ncrNo            String
  raisedOn         DateTime     @db.Date
  title            String
  description      String
  location         String?
  severity         NcrSeverity  @default(MINOR)
  status           NcrStatus    @default(OPEN)
  raisedById       String
  raisedBy         User         @relation("NcrRaiser", fields: [raisedById], references: [id])
  /// Who is to rectify it
  actionById       String?
  actionBy         User?        @relation("NcrActionBy", fields: [actionById], references: [id])
  dueDate          DateTime?    @db.Date
  cause            String?
  correctiveAction String?
  preventiveAction String?
  actionAt         DateTime?
  closedById       String?
  closedBy         User?        @relation("NcrCloser", fields: [closedById], references: [id])
  closedAt         DateTime?
  closureNote      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  attachments    Attachment[]
  meetingActions MeetingAction[]

  @@unique([organizationId, ncrNo])
  @@index([projectId, status])
  @@index([organizationId, status])
}

/// A drawing or document in the project's register; its revisions carry the files and status.
model Document {
  id                String             @id @default(uuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The drawing or document number as issued, e.g. "STR-GA-101"; unique within the project
  docNo             String
  title             String
  kind              DocumentKind       @default(DRAWING)
  discipline        DocumentDiscipline @default(GENERAL)
  remarks           String?
  /// The revision in force: the latest issued (kept in step by the service; filters and sorts by it)
  currentRevisionId String?            @unique
  currentRevision   DocumentRevision?  @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User               @relation("DocumentCreator", fields: [createdById], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  revisions DocumentRevision[] @relation("DocumentRevisions")
  rfis      Rfi[]
  markups   DrawingMarkup[]

  @@unique([projectId, docNo])
  @@index([organizationId, kind])
}

/// One revision of a document. The latest one added is the current revision; earlier ones are superseded.
model DocumentRevision {
  id           String         @id @default(uuid())
  documentId   String
  document     Document       @relation("DocumentRevisions", fields: [documentId], references: [id], onDelete: Cascade)
  /// "R0", "A", "P2": as printed on the title block
  revision     String
  issuedOn     DateTime       @db.Date
  status       RevisionStatus
  /// Architect, consultant or client who issued it
  receivedFrom String?
  remarks      String?
  issuedById   String
  issuedBy     User           @relation("RevisionIssuer", fields: [issuedById], references: [id])
  createdAt    DateTime       @default(now())

  attachments  Attachment[]
  transmittals TransmittalItem[]
  currentOf    Document?         @relation("CurrentRevision")
  markups      DrawingMarkup[]

  @@unique([documentId, revision])
  @@index([documentId, createdAt])
}

/// A mark on a drawing (item 109): a comment pin, cloud, box, arrow, text or freehand line on one page of a revision's
/// file. Points are normalised to the page (0 to 1). Open marks are carried onto later revisions until resolved.
model DrawingMarkup {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// M1, M2… within the document
  markupNo       Int
  revisionId     String
  revision       DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  attachmentId   String
  attachment     Attachment       @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  page           Int              @default(1)
  kind           MarkupKind
  /// [[x, y], …] from 0 to 1 of the page's width and height
  points         Json
  color          MarkupColor      @default(RED)
  /// The comment, or the words of a TEXT mark
  note           String?
  status         MarkupStatus     @default(OPEN)
  resolvedNote   String?
  resolvedById   String?
  resolvedBy     User?            @relation("MarkupResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  /// An RFI raised from this mark
  rfiId          String?
  rfi            Rfi?             @relation(fields: [rfiId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User             @relation("MarkupCreator", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([documentId, markupNo])
  @@index([organizationId, status])
  @@index([revisionId])
  @@index([attachmentId])
}

/// A numbered cover sheet listing the revisions sent to someone, and their acknowledgement.
model Transmittal {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// TRN-2026-0001 per organisation
  transmittalNo  String
  toParty        String
  attention      String?
  purpose        TransmittalPurpose
  sentOn         DateTime           @db.Date
  remarks        String?
  /// Received and signed for
  acknowledgedOn DateTime?          @db.Date
  acknowledgedBy String?
  sentById       String
  sentBy         User               @relation("TransmittalSender", fields: [sentById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items TransmittalItem[]

  @@unique([organizationId, transmittalNo])
  @@index([projectId, sentOn])
}

model TransmittalItem {
  id            String           @id @default(uuid())
  transmittalId String
  transmittal   Transmittal      @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  revisionId    String
  revision      DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  copies        Int              @default(1)
  sortOrder     Int              @default(0)

  @@unique([transmittalId, revisionId])
  @@index([revisionId])
}

/// Correspondence in and out, numbered IN- / OUT-<year>-0001 per organisation. A letter can answer another
/// and can be linked to a delay in the risk register (notices, extension of time claims).
model Letter {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  direction      LetterDirection
  letterNo       String
  /// The other side's reference number
  theirRef       String?
  letterDate     DateTime        @db.Date
  /// Received from (IN) or addressed to (OUT)
  party          String
  subject        String
  summary        String?
  /// IN only: when a reply is due
  replyBy        DateTime?       @db.Date
  inReplyToId    String?
  inReplyTo      Letter?         @relation("LetterReply", fields: [inReplyToId], references: [id], onDelete: SetNull)
  replies        Letter[]        @relation("LetterReply")
  riskId         String?
  risk           Risk?           @relation(fields: [riskId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User            @relation("LetterRecorder", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  attachments Attachment[]

  @@unique([organizationId, letterNo])
  @@index([projectId, letterDate])
  @@index([riskId])
}

/// The company's own staff (not contractor labour), with or without a login. Posted at one site at a time.
model Employee {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// EMP-001 or the company's own code; unique per organisation
  employeeCode   String
  fullName       String
  designation    String
  department     String?
  phone          String?
  /// Their login, when they have one (self check-in and leave from the app)
  userId         String?      @unique
  user           User?        @relation("EmployeeLogin", fields: [userId], references: [id], onDelete: SetNull)
  /// The site they are posted at; null = head office
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  joinedOn       DateTime?    @db.Date
  leftOn         DateTime?    @db.Date
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// HR records (v6 item 99). Personal details: shown to staff admins, payroll and the person themselves
  dateOfBirth        DateTime?       @db.Date
  gender             Gender?
  fatherOrSpouseName String?
  email              String?
  address            String?
  bloodGroup         String?
  emergencyContact   String?
  emergencyPhone     String?
  /// Statutory numbers; for Aadhaar only the last four digits are kept
  pan                String?
  aadhaarLast4       String?
  uan                String?
  pfNumber           String?
  esiNumber          String?
  /// Salary account
  bankName           String?
  bankAccountNo      String?
  bankIfsc           String?
  /// Terms of employment
  employmentType     EmploymentType?
  grade              String?
  reportingToId      String?
  reportingTo        Employee?       @relation("ReportsTo", fields: [reportingToId], references: [id], onDelete: SetNull)
  reports            Employee[]      @relation("ReportsTo")
  probationEndsOn    DateTime?       @db.Date
  confirmedOn        DateTime?       @db.Date
  /// Days of notice either side gives
  noticeDays         Int?
  /// Cost to company a year, from the latest increment (payroll's salary structure, item 100, starts from it)
  ctcAnnual          Decimal?        @db.Decimal(18, 2)
  /// Why they left (resignation, termination, retirement), with the exit event
  exitReason         String?

  attendance       StaffAttendance[]
  leave            LeaveRequest[]
  events           EmployeeEvent[]
  attachments      Attachment[]
  salaryStructures SalaryStructure[]
  loans            StaffLoan[]
  payslips         Payslip[]
  settlement       FinalSettlement?
  biometricUsers   BiometricUser[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, projectId])
}

enum WorkerSkill {
  UNSKILLED
  SEMI_SKILLED
  SKILLED
  HIGHLY_SKILLED
}

enum WorkerIdType {
  AADHAAR
  VOTER_ID
  DRIVING_LICENCE
  PAN
  OTHER
}

/// A named worker of a labour contractor (or departmental) at site (v4 item 44). Not an employee: no PF, ESI or
/// payroll. The wage is what the contractor is paid per man-day for them, for checking the contractor's bill.
model Worker {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  /// W-0001, unique per organisation
  workerNo       String
  name           String
  fatherName     String?
  phone          String?
  /// Labour contractor as on the head-count sheet, or "Departmental"
  contractor     String
  vendorId       String?
  vendor         Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Trade, e.g. Mason, Helper (same names as the head-count sheet)
  trade          String
  skill          WorkerSkill   @default(UNSKILLED)
  idType         WorkerIdType?
  /// For Aadhaar only the last four digits are kept (XXXX-XXXX-1234)
  idNumber       String?
  dailyWage      Decimal       @db.Decimal(18, 2)
  /// Paid per overtime hour; when empty, the daily wage / 8
  otRate         Decimal?      @db.Decimal(18, 2)
  /// The project they work at now; the roll call lists them there
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  joinedOn       DateTime?     @db.Date
  leftOn         DateTime?     @db.Date
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attendance     WorkerAttendance[]
  biometricUsers BiometricUser[]
  ppeIssues      PpeIssue[]

  @@unique([organizationId, workerNo])
  @@index([organizationId, projectId])
}

/// One named worker's day at a project: present, half day or absent, in and out, overtime, and the activity worked on.
/// Saving a roll call also sets the head-count sheet's rows for the contractors and trades it covers.
model WorkerAttendance {
  id                String                @id @default(uuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id])
  workerId          String
  worker            Worker                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date              DateTime              @db.Date
  status            StaffAttendanceStatus
  /// HH:mm, site local time
  inTime            String?
  outTime           String?
  otHours           Decimal?              @db.Decimal(4, 1)
  activityId        String?
  activity          Activity?             @relation(fields: [activityId], references: [id], onDelete: SetNull)
  note              String?
  /// Biometric attendance (v6 item 101): the device whose punches set in and out
  biometricDeviceId String?
  biometricDevice   BiometricDevice?      @relation(fields: [biometricDeviceId], references: [id], onDelete: SetNull)
  markedById        String
  markedBy          User                  @relation("WorkerAttendanceMarker", fields: [markedById], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([workerId, date])
  @@index([projectId, date])
  @@index([organizationId, date])
}

/// One employee's day: marked by the site in-charge or by themselves (check in / check out).
/// HR records (v6 item 99): joining, confirmation, transfer, promotion, increment, warning and exit, each with its letter.
/// Recording one updates the employee (posting, designation, CTC, confirmation, last working day).
model EmployeeEvent {
  id              String            @id @default(uuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id])
  employeeId      String
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type            EmployeeEventType
  /// The day it takes effect; for an exit, the last working day
  effectiveDate   DateTime          @db.Date
  /// HR-<year>-0001, the letter's reference
  letterNo        String
  fromProjectId   String?
  fromProject     Project?          @relation("EmployeeEventFrom", fields: [fromProjectId], references: [id], onDelete: SetNull)
  toProjectId     String?
  toProject       Project?          @relation("EmployeeEventTo", fields: [toProjectId], references: [id], onDelete: SetNull)
  /// Head office on either side of a transfer when the project is empty
  fromDesignation String?
  toDesignation   String?
  fromDepartment  String?
  toDepartment    String?
  fromCtc         Decimal?          @db.Decimal(18, 2)
  toCtc           Decimal?          @db.Decimal(18, 2)
  /// Resignation: the day it was handed in; days of notice served
  noticeGivenOn   DateTime?         @db.Date
  /// Reason, the warning's matter, or anything the letter should say
  note            String?
  createdById     String
  createdBy       User              @relation("EmployeeEventCreator", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@unique([organizationId, letterNo])
  @@index([organizationId, type, effectiveDate])
  @@index([employeeId, effectiveDate])
}

model StaffAttendance {
  id                  String                @id @default(uuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id])
  employeeId          String
  employee            Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                DateTime              @db.Date
  /// Where they worked that day (their posting unless marked elsewhere)
  projectId           String?
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status              StaffAttendanceStatus
  checkIn             DateTime?
  checkOut            DateTime?
  overtimeHours       Decimal?              @db.Decimal(4, 1)
  /// Attendance extras (v5 item 97): where the phone or browser was at check-in, and whether that was inside the site's radius
  checkInLat          Decimal?              @db.Decimal(9, 6)
  checkInLng          Decimal?              @db.Decimal(9, 6)
  checkInAccuracyM    Int?
  checkInDistanceM    Int?
  checkInInside       Boolean?
  /// Overtime waits for a decision; payroll pays approved overtime only
  overtimeStatus      OvertimeStatus?
  overtimeDecidedById String?
  overtimeDecidedBy   User?                 @relation("StaffOvertimeDecider", fields: [overtimeDecidedById], references: [id])
  overtimeDecidedAt   DateTime?
  overtimeNote        String?
  note                String?
  /// Biometric attendance (v6 item 101): the device whose punches set check-in and check-out
  biometricDeviceId   String?
  biometricDevice     BiometricDevice?      @relation(fields: [biometricDeviceId], references: [id], onDelete: SetNull)
  markedById          String
  markedBy            User                  @relation("StaffAttendanceMarker", fields: [markedById], references: [id])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([projectId, date])
}

model LeaveRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           LeaveType
  fromDate       DateTime     @db.Date
  toDate         DateTime     @db.Date
  /// A single half day
  halfDay        Boolean      @default(false)
  /// Working days taken: weekly offs (Sunday) and the site's holidays are not counted
  days           Decimal      @db.Decimal(4, 1)
  reason         String
  status         LeaveStatus  @default(PENDING)
  appliedById    String
  appliedBy      User         @relation("LeaveApplicant", fields: [appliedById], references: [id])
  decidedById    String?
  decidedBy      User?        @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([employeeId, fromDate])
}

/// A holiday for every site (projectId null) or one site.
model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  name           String
  createdAt      DateTime     @default(now())

  @@index([organizationId, date])
}

enum BillingPaymentStatus {
  CREATED
  PAID
}

/// One payment for the subscription: a Razorpay order, and once paid, the GST invoice for it.
model BillingPayment {
  id                String               @id @default(uuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id])
  status            BillingPaymentStatus @default(CREATED)
  razorpayOrderId   String               @unique
  razorpayPaymentId String?              @unique
  /// PROJECT or USER: what units counts
  unit              String
  units             Int
  /// 1 or 12
  months            Int
  chargedMonths     Int
  /// Price per unit per month, before GST
  rate              Decimal              @db.Decimal(18, 2)
  taxable           Decimal              @db.Decimal(18, 2)
  cgst              Decimal              @db.Decimal(18, 2)
  sgst              Decimal              @db.Decimal(18, 2)
  igst              Decimal              @db.Decimal(18, 2)
  total             Decimal              @db.Decimal(18, 2)
  buyerName         String
  buyerGstin        String?
  buyerAddress      String?
  buyerStateCode    String
  sellerStateCode   String
  createdById       String
  createdByEmail    String
  createdAt         DateTime             @default(now())
  /// Set when paid
  paidAt            DateTime?
  invoiceNo         String?              @unique
  invoiceDate       DateTime?            @db.Date
  periodFrom        DateTime?            @db.Date
  periodTo          DateTime?            @db.Date

  @@index([organizationId, createdAt])
}

// ----- Variations (v4 item 37) -----

/// Where a variation stands with the client. Only an approved variation changes the BOQ and the contract value.
enum VariationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum VariationCause {
  CLIENT_INSTRUCTION
  DESIGN_CHANGE
  SITE_CONDITION
  QUANTITY_DEVIATION
  OTHER
}

/// A change to the contract claimed from the client: extra items and quantity changes, with the client's decision.
model Variation {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Numbered per project: V-1, V-2, ...
  varNo          Int
  title          String
  cause          VariationCause
  description    String?
  status         VariationStatus @default(DRAFT)
  /// Sum of the lines: quantity × rate as claimed
  claimedAmount  Decimal         @db.Decimal(18, 2)
  /// Sum of the lines as the client approved them (set on approval)
  approvedAmount Decimal?        @db.Decimal(18, 2)
  /// Sent to the client: date and our letter reference
  submittedDate  DateTime?       @db.Date
  submittedRef   String?
  /// Client's decision: date, their order or letter reference, and a note
  decidedDate    DateTime?       @db.Date
  clientRef      String?
  decisionNote   String?
  createdById    String
  createdBy      User            @relation("VariationCreator", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  lines          VariationLine[]
  attachments    Attachment[]
  rfis           Rfi[]
  meetingActions MeetingAction[]

  @@unique([projectId, varNo])
  @@index([organizationId, status])
}

/// One item of a variation: a quantity change on an existing BOQ item, or a new (extra) item.
model VariationLine {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  variationId    String
  variation      Variation    @relation(fields: [variationId], references: [id], onDelete: Cascade)
  /// The existing BOQ item changed; for a new item, the BOQ item created when the variation is approved
  boqItemId      String?
  boqItem        BoqItem?     @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  isNewItem      Boolean      @default(false)
  itemNo         String
  description    String
  unit           String
  /// Quantity added (negative: omitted); a new item's whole quantity
  qty            Decimal      @db.Decimal(18, 3)
  /// BOQ rate for an existing item; the proposed rate for a new item
  rate           Decimal      @db.Decimal(18, 2)
  /// As the client approved it (set on approval)
  approvedQty    Decimal?     @db.Decimal(18, 3)
  approvedRate   Decimal?     @db.Decimal(18, 2)
  sortOrder      Int          @default(0)

  @@index([variationId])
  @@index([boqItemId])
  @@index([organizationId])
}

/// A project's cost budget by cost head (the heads of the cost view). One per project.
model ProjectBudget {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String       @unique
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses       Decimal      @default(0) @db.Decimal(18, 2)
  material       Decimal      @default(0) @db.Decimal(18, 2)
  machinery      Decimal      @default(0) @db.Decimal(18, 2)
  labour         Decimal      @default(0) @db.Decimal(18, 2)
  subcontract    Decimal      @default(0) @db.Decimal(18, 2)
  notes          String?
  updatedById    String
  updatedBy      User         @relation("BudgetUpdater", fields: [updatedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

/// What happened. A near miss hurt no one; the rest are graded by the worst outcome.
enum SafetyIncidentType {
  NEAR_MISS
  FIRST_AID
  MEDICAL_TREATMENT
  LOST_TIME
  PROPERTY_DAMAGE
  FATALITY
}

enum SafetyIncidentStatus {
  OPEN
  CLOSED
}

/// Work that needs a written permit before it starts.
enum WorkPermitType {
  HOT_WORK
  WORK_AT_HEIGHT
  EXCAVATION
  CONFINED_SPACE
  ELECTRICAL
  LIFTING
  OTHER
}

/// REQUESTED by site, ISSUED (work may start) or REJECTED by a safety officer or approver, CLOSED when the work is done.
enum WorkPermitStatus {
  REQUESTED
  ISSUED
  REJECTED
  CLOSED
}

enum PpeKind {
  HELMET
  SAFETY_SHOES
  REFLECTIVE_JACKET
  GLOVES
  SAFETY_HARNESS
  GOGGLES
  EAR_PROTECTION
  DUST_MASK
  GUMBOOTS
}

enum RfiStatus {
  OPEN
  ANSWERED
  CLOSED
  WITHDRAWN
}

enum RfiPriority {
  NORMAL
  URGENT
}

/// A request for information to the client or consultant. OPEN until answered (by the client's engineer in their
/// portal, or recorded by staff from a letter), CLOSED once acted on, or WITHDRAWN. Raised with the phone's id, so a
/// retried send from the outbox makes no second RFI.
model Rfi {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// RFI-<year>-0001 per organisation
  rfiNo          String
  subject        String
  question       String
  /// What we suggest, so the client can just agree
  proposal       String?
  location       String?
  priority       RfiPriority  @default(NORMAL)
  status         RfiStatus    @default(OPEN)
  /// Addressed to, as written: the client's engineer or the consultant
  toParty        String
  raisedOn       DateTime     @db.Date
  replyBy        DateTime     @db.Date
  documentId     String?
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  boqItemId      String?
  boqItem        BoqItem?     @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  costImpact     Boolean      @default(false)
  timeImpact     Boolean      @default(false)
  answer         String?
  answeredOn     DateTime?    @db.Date
  /// The client's engineer or consultant who answered in the portal
  answeredById   String?
  answeredBy     User?        @relation("RfiAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  /// Who answered, as recorded by staff from a letter or mail
  answeredByName String?
  answerRef      String?
  closedOn       DateTime?    @db.Date
  closeNote      String?
  closedById     String?
  closedBy       User?        @relation("RfiCloser", fields: [closedById], references: [id], onDelete: SetNull)
  variationId    String?
  variation      Variation?   @relation(fields: [variationId], references: [id], onDelete: SetNull)
  riskId         String?
  risk           Risk?        @relation(fields: [riskId], references: [id], onDelete: SetNull)
  raisedById     String
  raisedBy       User         @relation("RfiRaiser", fields: [raisedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attachments    Attachment[]
  markups        DrawingMarkup[]
  meetingActions MeetingAction[]

  @@unique([organizationId, rfiNo])
  @@index([projectId, status])
  @@index([organizationId, status])
}

enum PpeIssueStatus {
  ISSUED
  RETURNED
  REPLACED
  LOST
}

/// One item of PPE handed to a named worker at a project. ISSUED while they have it; returning it, losing it or
/// issuing the same kind to them again (REPLACED) closes it. Issues made together share a batchId, the phone's id for
/// the batch, so a send that is retried from the outbox is never issued twice.
model PpeIssue {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId       String
  worker         Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  kind           PpeKind
  size           String?
  issuedOn       DateTime       @db.Date
  /// Issued on + the kind's usual life; past it the item is due for replacement
  replaceBy      DateTime?      @db.Date
  status         PpeIssueStatus @default(ISSUED)
  batchId        String?
  closedOn       DateTime?      @db.Date
  closeNote      String?
  /// To be recovered from the labour contractor (lost, or kept when the worker left)
  recoverable    Boolean        @default(false)
  note           String?
  issuedById     String
  issuedBy       User           @relation("PpeIssuer", fields: [issuedById], references: [id])
  closedById     String?
  closedBy       User?          @relation("PpeCloser", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([batchId, workerId, kind])
  @@index([projectId, status])
  @@index([workerId, status])
  @@index([organizationId])
}

/// Incident and near-miss register per project (v4 item 40). Not an approval submission: an entry stays open
/// until the safety officer or an approver closes it with the root cause and the corrective action.
model SafetyIncident {
  id               String               @id @default(uuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id])
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// INC-<year>-0001 per organisation
  incidentNo       String
  type             SafetyIncidentType
  date             DateTime             @db.Date
  /// Time of day, HH:mm
  time             String?
  location         String
  description      String
  /// People hurt (0 for a near miss or property damage)
  injuredCount     Int                  @default(0)
  injuredNames     String?
  /// Whose workers were involved (labour contractor or subcontractor)
  contractor       String?
  immediateAction  String?
  rootCause        String?
  correctiveAction String?
  /// Lost time injury: days the injured person was off work
  daysLost         Int?
  status           SafetyIncidentStatus @default(OPEN)
  closedAt         DateTime?
  closedById       String?
  closedBy         User?                @relation("IncidentCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closureNote      String?
  reportedById     String
  reportedBy       User                 @relation("IncidentReporter", fields: [reportedById], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  attachments Attachment[]

  @@unique([organizationId, incidentNo])
  @@index([projectId, date])
}

/// A toolbox talk held at site: topic, who gave it and who attended (a photo of the signed sheet as attachment).
model ToolboxTalk {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// TBT-<year>-0001 per organisation
  talkNo          String
  date            DateTime     @db.Date
  topic           String
  conductedBy     String
  contractor      String?
  attendeeCount   Int
  attendees       String?
  durationMinutes Int?
  notes           String?
  recordedById    String
  recordedBy      User         @relation("ToolboxTalkRecorder", fields: [recordedById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  attachments Attachment[]

  @@unique([organizationId, talkNo])
  @@index([projectId, date])
}

/// Permit to work for risky work, valid between two times. Expired = ISSUED and past validTo (not stored).
model WorkPermit {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// PTW-<year>-0001 per organisation
  permitNo       String
  type           WorkPermitType
  location       String
  /// The work to be done
  description    String
  contractor     String?
  workerCount    Int?
  workers        String?
  validFrom      DateTime
  validTo        DateTime
  /// Precautions ticked from the standard list for the type, plus any added
  precautions    String[]         @default([])
  status         WorkPermitStatus @default(REQUESTED)
  requestedById  String
  requestedBy    User             @relation("PermitRequester", fields: [requestedById], references: [id])
  issuedById     String?
  issuedBy       User?            @relation("PermitIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt       DateTime?
  /// Conditions on issue, or the reason for rejection
  issueNote      String?
  closedById     String?
  closedBy       User?            @relation("PermitCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt       DateTime?
  closeNote      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments Attachment[]

  @@unique([organizationId, permitNo])
  @@index([projectId, status])
}

/// Scheduled service or breakdown repair of a machine (v4 item 42).
enum MaintenanceKind {
  SERVICE
  BREAKDOWN
}

enum MaintenanceStatus {
  OPEN
  CLOSED
}

/// A machine or vehicle document with an expiry date.
enum EquipmentDocType {
  INSURANCE
  FITNESS
  PERMIT
  PUC
  ROAD_TAX
  REGISTRATION
  OTHER
}

/// A maintenance job card: a service when due, or a breakdown reported from site, closed with the work done and its cost.
model MaintenanceJob {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  equipmentId    String
  equipment      Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  /// Where the machine was; null for one in the yard
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// MNT-<year>-0001 per organisation
  jobNo          String
  kind           MaintenanceKind
  status         MaintenanceStatus @default(OPEN)
  date           DateTime          @db.Date
  meterReading   Decimal?          @db.Decimal(18, 2)
  description    String
  /// Workshop or mechanic doing the job
  workshop       String?
  workDone       String?
  closedDate     DateTime?         @db.Date
  downtimeHours  Decimal?          @db.Decimal(18, 2)
  labourCost     Decimal           @default(0) @db.Decimal(18, 2)
  /// Parts bought outside (spares from the store are stock issues linked to the job)
  partsCost      Decimal           @default(0) @db.Decimal(18, 2)
  /// The workshop's service bill for the job (v5 item 91)
  vendorBillId   String?
  vendorBill     VendorBill?       @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  reportedById   String
  reportedBy     User              @relation("MaintenanceReporter", fields: [reportedById], references: [id])
  closedById     String?
  closedBy       User?             @relation("MaintenanceCloser", fields: [closedById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  spareIssues StockEntry[]
  attachments Attachment[]
  parts       EquipmentPart[]

  @@unique([organizationId, jobNo])
  @@index([organizationId, status])
  @@index([equipmentId, date])
  @@index([projectId])
  @@index([vendorBillId])
}

/// Insurance, fitness, permit, PUC, road tax or registration of a machine or vehicle, with its validity.
model EquipmentDocument {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  equipmentId    String
  equipment      Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type           EquipmentDocType
  number         String?
  issuer         String?
  validFrom      DateTime?        @db.Date
  validTo        DateTime         @db.Date
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments Attachment[]

  @@index([organizationId, validTo])
  @@index([equipmentId])
}

/// A driver or operator with a licence, optionally assigned to a machine.
model Driver {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  phone          String?
  licenceNo      String?
  /// Licence class, e.g. HMV, LMV, crane operator
  licenceClass   String?
  licenceValidTo DateTime?    @db.Date
  equipmentId    String?
  equipment      Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
}

/// Cash advanced to the site, or handed back by the site in-charge
enum ImprestEntryKind {
  ADVANCE
  RETURN
}

/// A top-up is asked for (REQUESTED), then paid or turned down; returns and direct advances are PAID at once
enum ImprestEntryStatus {
  REQUESTED
  PAID
  REJECTED
}

/// Site imprest (v4 item 45): a petty cash float held by one person at one project. Their cash site expenses spend it.
model Imprest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  holderId       String
  holder         User         @relation("ImprestHolder", fields: [holderId], references: [id])
  /// The float: what the cash in hand is topped back up to
  floatAmount    Decimal      @db.Decimal(18, 2)
  /// Cash expenses from this day on count against the float
  openedOn       DateTime     @db.Date
  closedOn       DateTime?    @db.Date
  isActive       Boolean      @default(true)
  note           String?
  createdById    String
  createdBy      User         @relation("ImprestOpener", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  entries      ImprestEntry[]
  fundRequests PaymentRequest[]

  @@unique([projectId, holderId])
  @@index([organizationId, isActive])
  @@index([holderId])
}

model ImprestEntry {
  id               String             @id @default(uuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id])
  imprestId        String
  imprest          Imprest            @relation(fields: [imprestId], references: [id], onDelete: Cascade)
  kind             ImprestEntryKind
  status           ImprestEntryStatus
  amount           Decimal            @db.Decimal(18, 2)
  /// Asked for on (a request), else paid or returned on
  date             DateTime           @db.Date
  reason           String?
  paidOn           DateTime?          @db.Date
  paymentMode      PaymentMode?
  /// Cheque, UTR or voucher number
  reference        String?
  requestedById    String?
  requestedBy      User?              @relation("ImprestRequester", fields: [requestedById], references: [id])
  decidedById      String?
  decidedBy        User?              @relation("ImprestDecider", fields: [decidedById], references: [id])
  decidedAt        DateTime?
  decisionNote     String?
  /// The fund request it releases (v6 item 107)
  paymentRequestId String?
  paymentRequest   PaymentRequest?    @relation(fields: [paymentRequestId], references: [id], onDelete: NoAction)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([imprestId, status])
  @@index([paymentRequestId])
  @@index([organizationId, status])
}

/// What a register entry is (v4 item 46).
enum ComplianceDocKind {
  BANK_GUARANTEE
  EMD
  INSURANCE
  LICENCE
}

/// ACTIVE until it is renewed (a newer entry replaces it), released (returned, refunded, cancelled or surrendered)
/// or invoked (a guarantee encashed, an EMD forfeited).
enum ComplianceDocStatus {
  ACTIVE
  RENEWED
  RELEASED
  INVOKED
}

/// Guarantees, EMD, insurance policies and licences (v4 item 46), company-wide or for one project, with expiry
/// reminders. Renewing one adds a new entry that points back at the one it replaces.
model ComplianceDoc {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  kind           ComplianceDocKind
  /// e.g. Performance guarantee, Contractor's all risk, Labour licence
  category       String?
  /// Guarantee, receipt, policy or licence number
  reference      String
  /// Bank, insurer or licensing authority
  issuer         String?
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id])
  /// In whose favour: the client for a guarantee, the tendering office for an EMD
  beneficiary    String?
  /// Guarantee or EMD amount, or the sum insured
  amount         Decimal?            @db.Decimal(18, 2)
  /// Margin money (fixed deposit or cash) the bank holds against a guarantee
  margin         Decimal?            @db.Decimal(18, 2)
  issuedOn       DateTime?           @db.Date
  expiresOn      DateTime?           @db.Date
  /// Last day the beneficiary can claim under a guarantee (often some months after it expires)
  claimUntil     DateTime?           @db.Date
  status         ComplianceDocStatus @default(ACTIVE)
  closedOn       DateTime?           @db.Date
  closeNote      String?
  renewedFromId  String?             @unique
  renewedFrom    ComplianceDoc?      @relation("ComplianceRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedBy      ComplianceDoc?      @relation("ComplianceRenewal")
  note           String?
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  attachments Attachment[]
  /// The tender this EMD was paid for (v6 item 110)
  tender      Tender?      @relation("TenderEmd")

  @@index([organizationId, status, expiresOn])
  @@index([projectId])
}

/// Handover and defects (v4 item 47). SNAG = found before handover (punch list); DEFECT = reported in the defect
/// liability period.
enum DefectPhase {
  SNAG
  DEFECT
}

enum DefectPriority {
  LOW
  MEDIUM
  HIGH
}

/// OPEN = to be put right, FIXED = the site says it is done, CLOSED = checked and accepted (a reopen sends it back
/// to OPEN).
enum DefectStatus {
  OPEN
  FIXED
  CLOSED
}

/// The project's completion: the completion (taking-over) certificate and the defect liability period it starts.
model ProjectHandover {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  projectId       String       @unique
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Date of completion the certificate states; the defect liability period runs from it
  completedOn     DateTime     @db.Date
  certificateNo   String?
  certificateDate DateTime?    @db.Date
  /// Who certified it, e.g. the client's Executive Engineer
  certifiedBy     String?
  dlpMonths       Int
  dlpEndsOn       DateTime     @db.Date
  note            String?
  recordedById    String
  recordedBy      User         @relation(fields: [recordedById], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  attachments Attachment[]

  @@index([organizationId, dlpEndsOn])
}

/// A snag before handover or a defect in the defect liability period, put right by the site and closed once checked.
model Defect {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// SNG-2026-0001 or DEF-2026-0001
  defectNo       String
  phase          DefectPhase
  title          String
  description    String?
  location       String?
  /// Trade or kind of work, e.g. Plaster, Plumbing, Road marking
  trade          String?
  priority       DefectPriority @default(MEDIUM)
  status         DefectStatus   @default(OPEN)
  reportedOn     DateTime       @db.Date
  /// Who found it when not one of us, e.g. the client's engineer on a joint walk-through
  reportedByName String?
  reportedById   String
  reportedBy     User           @relation("DefectReporter", fields: [reportedById], references: [id])
  assignedToId   String?
  assignedTo     User?          @relation("DefectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  /// Subcontractor who is to put it right, when not our own team
  contractor     String?
  dueDate        DateTime?      @db.Date
  fixedOn        DateTime?      @db.Date
  fixNote        String?
  /// What putting it right cost (defects in the liability period are at the contractor's cost)
  cost           Decimal?       @db.Decimal(18, 2)
  fixedById      String?
  fixedBy        User?          @relation("DefectFixer", fields: [fixedById], references: [id], onDelete: SetNull)
  closedAt       DateTime?
  closedById     String?
  closedBy       User?          @relation("DefectCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closeNote      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  attachments Attachment[]

  @@unique([organizationId, defectNo])
  @@index([projectId, status])
}

/// One line of a project's close-out checklist (as-built drawings, final bill, retention release, ...).
model CloseoutItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// DOCUMENTS, COMMERCIAL, SITE or STATUTORY
  category       String
  title          String
  sortOrder      Int          @default(0)
  doneOn         DateTime?    @db.Date
  doneById       String?
  doneBy         User?        @relation(fields: [doneById], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([projectId, sortOrder])
}

/// A list's filters, sort and columns saved under a name (UI roadmap item 55). Personal unless shared with the company.
model SavedView {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which list: SAVED_VIEW_LISTS in @erp/shared (dpr, progress, material-requests, purchase-orders, bills, machinery, expenses, …, the masters: projects, clients, vendors, users, and risks, variations)
  list           String
  name           String
  shared         Boolean      @default(false)
  /// SavedViewState: { filters: Record<string, string>, columns?: string[] }
  state          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, list])
  @@index([userId])
}

/// An Ask Nirmaan conversation (AI item 67), kept for the user and the company's admins.
model AiThread {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  messages       AiMessage[]

  @@index([organizationId, userId, updatedAt])
}

/// One question or answer. Answers carry the records they cited, what the model was paid for, and the user's rating.
model AiMessage {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  threadId         String
  thread           AiThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// user | assistant
  role             String
  text             String
  /// The page the question was asked from (AiPageContext)
  page             Json?
  /// AiCitationDto[]
  citations        Json?
  /// Figures in the answer that did not match the records read
  unverified       Json?
  /// Tools called, in order, with their inputs (for admins and the evaluation)
  toolCalls        Json?
  /// Forms the answer filled in for the user to check and save (AiDraftDto[], AI item 71)
  drafts           Json?
  model            String?
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  /// Estimated cost in paise at list prices
  costPaise        Int          @default(0)
  durationMs       Int?
  /// 1 helpful, -1 not helpful
  feedback         Int?
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([threadId, createdAt])
}

/// An approver looked at a bill check's flag and accepted it, with a note (AI item 69).
model BillCheckAcceptance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// vendor-bill | subcontract-bill | expense | ra-bill (CHECK_KINDS)
  kind           String
  billId         String
  /// The flag's key, which carries its figures, so a changed bill is checked afresh
  checkKey       String
  note           String
  acceptedById   String
  acceptedBy     User         @relation("BillCheckAcceptedBy", fields: [acceptedById], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([kind, billId, checkKey])
  @@index([organizationId])
}

/// The model's one-line summary of a bill's checks, written once per set of open flags.
model BillCheckSummary {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  kind           String
  billId         String
  /// The open flags' keys it was written for, hashed
  fingerprint    String
  text           String
  model          String?
  /// What it cost, counted in the company's monthly Ask Nirmaan allowance
  costPaise      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([kind, billId, fingerprint])
  @@index([organizationId, createdAt])
}

/// One invoice, challan or drawing read by the model to fill a form (AI item 70). Only what it cost is kept: the pages
/// and what was read go back to the form, and nothing is saved until the user saves it.
model AiDocumentRead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  /// invoice | challan | drawing (DOC_READ_KINDS)
  kind           String
  pages          Int
  model          String
  /// Counted in the company's monthly Ask Nirmaan allowance
  costPaise      Int          @default(0)
  ms             Int
  /// The reply could be read as fields
  ok             Boolean
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// An early warning dismissed with a reason (AI item 73), for the whole company. The key carries the figures the
/// warning fired on, so it comes back when they move on.
model WarningDismissal {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  warningKey     String
  reason         String
  dismissedById  String
  dismissedBy    User         @relation("WarningDismissedBy", fields: [dismissedById], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([organizationId, warningKey])
}

/// Written by Ask Nirmaan in the overnight batch (AI item 74): a user's morning brief (MORNING, for `date`) or a
/// project's weekly narrative for the client's report (WEEK, `date` = the week's Monday). `key` is
/// MORNING:<userId>:<date> or WEEK:<projectId>:<monday>, so a re-run writes nothing twice.
model AiBrief {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// MORNING | WEEK
  kind           String
  key            String
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  date           DateTime     @db.Date
  /// [{ text, href }] for a brief, [{ text }] for a narrative
  lines          Json
  /// The model's text passed the grounding check; false = the rules' own draft
  byAssistant    Boolean
  /// Figures the model wrote that the records do not contain (why its text was not used)
  unverified     Json?
  model          String?
  /// Counted in the company's monthly Ask Nirmaan allowance
  costPaise      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, key])
  @@index([organizationId, createdAt])
}

/// One page of a PDF filed with a document revision or a letter, as text (Ask the contract, AI item 75). `search` is a
/// generated tsvector (english) with a GIN index, made in the migration; Postgres full-text search, no vector database.
model DocumentPage {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachmentId   String
  attachment     Attachment               @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  /// 1-based
  page           Int
  text           String
  search         Unsupported("tsvector")?
  createdAt      DateTime                 @default(now())

  @@unique([attachmentId, page])
  @@index([search], type: Gin)
  @@index([organizationId, projectId])
}

/// Site photo checks (AI item 76): what the model saw in one photo, read once and kept. Advisory only.
model PhotoCheck {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachmentId   String       @unique
  attachment     Attachment   @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  /// DONE | SKIPPED | FAILED
  status         String
  caption        String?
  /// [{ key, detail, confidence }], every flag the model gave; the page shows those above the confidence bar
  flags          Json         @default("[]")
  /// A snag's drafted title, description, location and trade, when it was read for the snag form
  draft          Json?
  reason         String?
  model          String?
  /// Counted in the company's monthly Ask Nirmaan allowance
  costPaise      Int          @default(0)
  ms             Int?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([projectId])
}

/**
 * ---------- Payroll (v6 item 100) ----------
 */

/// The company's payroll rules: PF, ESI, professional tax state, paid days and overtime rate.
model PayrollSettings {
  organizationId     String        @id
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pfEmployeePct      Decimal       @default(12) @db.Decimal(5, 2)
  pfEmployerPct      Decimal       @default(12) @db.Decimal(5, 2)
  /// Of the employer's share, this much goes to the pension scheme (EPS), on wages up to the ceiling
  epsPct             Decimal       @default(8.33) @db.Decimal(5, 2)
  pfWageCeiling      Decimal       @default(15000) @db.Decimal(18, 2)
  /// PF on wages up to the ceiling only (the usual), or on the full basic and DA
  pfCapAtCeiling     Boolean       @default(true)
  esiEmployeePct     Decimal       @default(0.75) @db.Decimal(5, 2)
  esiEmployerPct     Decimal       @default(3.25) @db.Decimal(5, 2)
  /// ESI applies while the monthly gross is at most this
  esiGrossCeiling    Decimal       @default(21000) @db.Decimal(18, 2)
  /// Professional tax slabs by state (code from GST_STATES), null = none
  ptState            String?       @default("21")
  paidDaysBasis      PaidDaysBasis @default(CALENDAR)
  /// Overtime pay: (basic + DA) / 26 / 8 an hour, times this
  overtimeMultiplier Decimal       @default(2) @db.Decimal(4, 2)
  /// The company account salaries are paid from, for the bank file
  debitAccountNo     String?
  debitBankName      String?
  updatedAt          DateTime      @updatedAt
}

/// An employee's salary from a date: monthly earnings and what is deducted. The latest one on or before a month is used.
model SalaryStructure {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom      DateTime     @db.Date
  basic              Decimal      @db.Decimal(18, 2)
  da                 Decimal      @default(0) @db.Decimal(18, 2)
  hra                Decimal      @default(0) @db.Decimal(18, 2)
  conveyance         Decimal      @default(0) @db.Decimal(18, 2)
  special            Decimal      @default(0) @db.Decimal(18, 2)
  otherEarnings      Decimal      @default(0) @db.Decimal(18, 2)
  pf                 Boolean      @default(true)
  /// ESI when the gross is under the ceiling; off to leave it out
  esi                Boolean      @default(true)
  pt                 Boolean      @default(true)
  taxRegime          TaxRegime    @default(NEW)
  /// Old regime: deductions declared for the year (80C, 80D, home loan interest...)
  declaredDeductions Decimal      @default(0) @db.Decimal(18, 2)
  /// Other income or salary from an earlier employer this year, for TDS
  otherIncome        Decimal      @default(0) @db.Decimal(18, 2)
  note               String?
  createdById        String
  createdBy          User         @relation("SalaryStructureCreator", fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())

  payslips Payslip[]

  @@unique([employeeId, effectiveFrom])
  @@index([organizationId])
}

/// Money lent to an employee (loan) or paid ahead (advance), recovered from salary a month at a time.
model StaffLoan {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind           StaffLoanKind
  issuedOn       DateTime      @db.Date
  amount         Decimal       @db.Decimal(18, 2)
  /// Taken from each month's salary until recovered
  emi            Decimal       @db.Decimal(18, 2)
  /// First month recovered, YYYY-MM
  startMonth     String
  note           String?
  createdById    String
  createdBy      User          @relation("StaffLoanCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  /// The Tally export that took the money given (v6 item 102)
  tallyExportId  String?
  tallyExport    TallyExport?  @relation(fields: [tallyExportId], references: [id], onDelete: SetNull)

  lines PayslipLine[]

  @@index([organizationId, employeeId])
}

/// A month's salary run, for the company or one site.
model PayrollRun {
  id                   String           @id @default(uuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id])
  /// SAL-2026-10, with -<project code> for a site's run
  runNo                String
  month                String
  projectId            String?
  project              Project?         @relation(fields: [projectId], references: [id])
  status               PayrollRunStatus @default(DRAFT)
  gross                Decimal          @default(0) @db.Decimal(18, 2)
  deductions           Decimal          @default(0) @db.Decimal(18, 2)
  net                  Decimal          @default(0) @db.Decimal(18, 2)
  employerCost         Decimal          @default(0) @db.Decimal(18, 2)
  preparedById         String
  preparedBy           User             @relation("PayrollPreparer", fields: [preparedById], references: [id])
  submittedAt          DateTime?
  approvedById         String?
  approvedBy           User?            @relation("PayrollApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  /// Sent back with a note
  reviewNote           String?
  paidById             String?
  paidBy               User?            @relation("PayrollPayer", fields: [paidById], references: [id])
  paidOn               DateTime?        @db.Date
  paymentRef           String?
  /// The Tally export that took the salary journal, and the one that took the payment (v6 item 102)
  tallyExportId        String?
  tallyExport          TallyExport?     @relation("PayrollRunTally", fields: [tallyExportId], references: [id], onDelete: SetNull)
  tallyPaymentExportId String?
  tallyPaymentExport   TallyExport?     @relation("PayrollRunPaymentTally", fields: [tallyPaymentExportId], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  payslips Payslip[]

  @@unique([organizationId, runNo])
  @@index([organizationId, month])
}

/// One employee's salary for a run, with who they were then (name, bank, UAN) so it stays as paid.
model Payslip {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  runId          String
  run            PayrollRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  structureId    String?
  structure      SalaryStructure? @relation(fields: [structureId], references: [id], onDelete: SetNull)
  employeeCode   String
  employeeName   String
  designation    String
  projectName    String?
  pan            String?
  uan            String?
  esiNumber      String?
  bankName       String?
  bankAccountNo  String?
  bankIfsc       String?
  /// Days of the month (or 26), days paid, loss of pay
  monthDays      Decimal          @db.Decimal(5, 1)
  paidDays       Decimal          @db.Decimal(5, 1)
  lopDays        Decimal          @db.Decimal(5, 1)
  overtimeHours  Decimal          @default(0) @db.Decimal(6, 2)
  gross          Decimal          @db.Decimal(18, 2)
  deductions     Decimal          @db.Decimal(18, 2)
  net            Decimal          @db.Decimal(18, 2)
  /// Employer PF (EPF and EPS) and ESI, on top of gross
  employerCost   Decimal          @db.Decimal(18, 2)
  /// PF wages (basic + DA earned, capped) and ESI wages, for the returns
  pfWages        Decimal          @default(0) @db.Decimal(18, 2)
  esiWages       Decimal          @default(0) @db.Decimal(18, 2)
  createdAt      DateTime         @default(now())

  lines PayslipLine[]

  @@unique([runId, employeeId])
  @@index([organizationId, employeeId])
}

/// A line of a payslip: an earning, a deduction or the employer's contribution. Manual lines (arrears, bonus, other
/// deductions) are kept when the payslip is worked out again.
model PayslipLine {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  payslipId      String
  payslip        Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  kind           PayslipLineKind
  /// BASIC, DA, HRA, CONVEYANCE, SPECIAL, OTHER, OVERTIME, ARREARS, BONUS, PF, ESI, PT, TDS, LOAN, ADVANCE,
  /// OTHER_DEDUCTION, PF_EMPLOYER, EPS_EMPLOYER, ESI_EMPLOYER
  code           String
  label          String
  amount         Decimal         @db.Decimal(18, 2)
  manual         Boolean         @default(false)
  loanId         String?
  loan           StaffLoan?      @relation(fields: [loanId], references: [id], onDelete: SetNull)
  sortOrder      Int             @default(0)

  @@index([payslipId])
  @@index([loanId])
}

/// Full and final settlement of someone who has left: the last month's salary, leave encashed, gratuity, notice pay
/// and what they owe, worked out once and approved.
model FinalSettlement {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  employeeId      String           @unique
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  settlementNo    String
  lastWorkingDay  DateTime         @db.Date
  status          SettlementStatus @default(DRAFT)
  /// Salary for days of the last month not paid in a run
  salaryDays      Decimal          @default(0) @db.Decimal(5, 1)
  salary          Decimal          @default(0) @db.Decimal(18, 2)
  leaveDays       Decimal          @default(0) @db.Decimal(6, 1)
  leaveEncashment Decimal          @default(0) @db.Decimal(18, 2)
  serviceYears    Decimal          @default(0) @db.Decimal(5, 2)
  gratuity        Decimal          @default(0) @db.Decimal(18, 2)
  /// Notice days not served, recovered at a day's gross
  noticeShortDays Int              @default(0)
  noticeRecovery  Decimal          @default(0) @db.Decimal(18, 2)
  loanRecovery    Decimal          @default(0) @db.Decimal(18, 2)
  otherEarnings   Decimal          @default(0) @db.Decimal(18, 2)
  otherDeductions Decimal          @default(0) @db.Decimal(18, 2)
  net             Decimal          @default(0) @db.Decimal(18, 2)
  note            String?
  preparedById    String
  preparedBy      User             @relation("SettlementPreparer", fields: [preparedById], references: [id])
  approvedById    String?
  approvedBy      User?            @relation("SettlementApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  paidOn          DateTime?        @db.Date
  paymentRef      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, settlementNo])
}

/// Biometric attendance (v6 item 101): a fingerprint or face device at a site or office. ADMS devices are known by their
/// serial number (unique across companies, as the device sends nothing else); a webhook device posts with its key.
model BiometricDevice {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  name           String
  /// Make and model as the company knows it, e.g. ZKTeco K40, eSSL X990
  model          String?
  protocol       BiometricProtocol
  serialNo       String?           @unique
  /// For WEBHOOK: the key sent in the X-Device-Key header
  apiKey         String?           @unique
  /// The site it stands at: workers punching on it are marked there; staff are marked there too
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Minutes the device clock is ahead of UTC (India 330)
  utcOffsetMin   Int               @default(330)
  isActive       Boolean           @default(true)
  lastSeenAt     DateTime?
  lastPunchAt    DateTime?
  createdById    String
  createdBy      User              @relation("BiometricDeviceCreator", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  punches          BiometricPunch[]
  staffAttendance  StaffAttendance[]
  workerAttendance WorkerAttendance[]

  @@index([organizationId])
}

/// A user number on the company's devices (the same number on every device it is enrolled on), matched to one employee or
/// one worker.
model BiometricUser {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  pin            String
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workerId       String?
  worker         Worker?      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, pin])
}

/// One punch as the device sent it. The same punch sent twice is kept once.
model BiometricPunch {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  deviceId       String
  device         BiometricDevice      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  pin            String
  punchedAt      DateTime
  /// The day it counts for, in the device's time zone
  date           DateTime             @db.Date
  /// HH:mm on the device's clock
  time           String
  result         BiometricPunchResult
  note           String?
  createdAt      DateTime             @default(now())

  @@unique([deviceId, pin, punchedAt])
  @@index([organizationId, date])
  @@index([organizationId, pin, date])
}

// ---------- Books of account (v6 item 102) ----------

enum AccountGroup {
  CAPITAL_ACCOUNT
  RESERVES_SURPLUS
  LOANS_LIABILITY
  SECURED_LOANS
  UNSECURED_LOANS
  CURRENT_LIABILITIES
  DUTIES_TAXES
  PROVISIONS
  SUNDRY_CREDITORS
  FIXED_ASSETS
  INVESTMENTS
  CURRENT_ASSETS
  BANK_ACCOUNTS
  CASH_IN_HAND
  DEPOSITS_ASSET
  LOANS_ADVANCES_ASSET
  STOCK_IN_HAND
  SUNDRY_DEBTORS
  SALES_ACCOUNTS
  DIRECT_INCOMES
  INDIRECT_INCOMES
  PURCHASE_ACCOUNTS
  DIRECT_EXPENSES
  INDIRECT_EXPENSES
  SUSPENSE
}

enum BookVoucherType {
  JOURNAL
  PAYMENT
  RECEIPT
  CONTRA
  SALES
  PURCHASE
  DEBIT_NOTE
  CREDIT_NOTE
}

enum BookVoucherStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// An account in the chart of accounts. The posting service makes one for each ledger key a module posts to (the same
/// keys and names as the Tally export); accounts add their own (key ACCOUNT:<id>).
model LedgerAccount {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  /// PURCHASE, VENDOR:<id>, CLIENT:<id>, EXPENSE:<category>, ACCOUNT:<id> …
  key            String
  name           String
  code           String?
  group          AccountGroup
  isSystem       Boolean             @default(false)
  isActive       Boolean             @default(true)
  description    String?
  /// Where the statements show it, when not its group's line (v6 item 103)
  statementLine  StatementLine?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          BookLine[]
  statementLines BankStatementLine[]

  @@unique([organizationId, key])
  @@unique([organizationId, name])
}

/// A voucher in the books: posted from a module's record (source and sourceId, always approved), or made by hand by
/// accounts (source MANUAL) and approved by management before it counts.
model BookVoucher {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  voucherNo      String
  type           BookVoucherType
  date           DateTime          @db.Date
  /// MANUAL, or the posting kind (SALES, RECEIPT, PURCHASE, SUBCONTRACT, PAYMENT, EXPENSE, DEBIT_NOTE, SALARY, SALARY_PAYMENT)
  source         String
  sourceId       String?
  reference      String?
  party          String?
  narration      String
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id])
  amount         Decimal           @db.Decimal(18, 2)
  status         BookVoucherStatus @default(DRAFT)
  /// What a posted voucher was built from, so the next posting run changes only what moved
  hash           String?
  preparedById   String?
  preparedBy     User?             @relation("BookVoucherPreparer", fields: [preparedById], references: [id])
  submittedAt    DateTime?
  approvedById   String?
  approvedBy     User?             @relation("BookVoucherApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  reviewNote     String?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  lines          BookLine[]

  @@unique([organizationId, source, sourceId])
  @@index([organizationId, date])
  @@index([organizationId, status])
}

/// A debit or a credit to an account, with the project as cost centre.
model BookLine {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  voucherId      String
  voucher        BookVoucher        @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId      String
  account        LedgerAccount      @relation(fields: [accountId], references: [id])
  projectId      String?
  project        Project?           @relation(fields: [projectId], references: [id])
  debit          Decimal            @default(0) @db.Decimal(18, 2)
  credit         Decimal            @default(0) @db.Decimal(18, 2)
  narration      String?
  sortOrder      Int                @default(0)
  statementLine  BankStatementLine?

  @@index([accountId])
  @@index([voucherId])
  @@index([organizationId, projectId])
}

/// When the posting service last brought the books up to date.
model BooksState {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id])
  lastPostedAt   DateTime?
  /// Records that could not be posted, with why: [{ source, sourceId, date, number, party, reason }]
  held           Json         @default("[]")
  /// The day the books begin: module records before it are in the opening balances instead (v6 item 103)
  booksFrom      DateTime?    @db.Date
  /// Nothing posts, changes or is cancelled on or before this day
  lockedUpTo     DateTime?    @db.Date
}

enum StatementLine {
  REVENUE
  OTHER_INCOME
  MATERIALS
  INVENTORY_CHANGE
  CONSTRUCTION
  EMPLOYEE
  FINANCE
  DEPRECIATION
  OTHER_EXPENSES
  TAX
  SHARE_CAPITAL
  RESERVES
  LONG_BORROWINGS
  SHORT_BORROWINGS
  TRADE_PAYABLES
  OTHER_CURRENT_LIABILITIES
  SHORT_PROVISIONS
  PPE
  CWIP
  INVESTMENTS
  LONG_LOANS
  INVENTORIES
  TRADE_RECEIVABLES
  CASH
  SHORT_LOANS
  OTHER_CURRENT_ASSETS
}

/// A line of a bank account's statement, imported from the bank's file and matched to a line of the bank book
/// (v6 item 103, bank reconciliation).
model BankStatementLine {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  description    String
  reference      String?
  withdrawal     Decimal       @default(0) @db.Decimal(18, 2)
  deposit        Decimal       @default(0) @db.Decimal(18, 2)
  balance        Decimal?      @db.Decimal(18, 2)
  /// Its place in the bank's file, so lines of one day keep the bank's order
  seq            Int           @default(0)
  /// The row's date, amounts, balance and words, so importing the same file twice adds nothing
  fingerprint    String
  bookLineId     String?       @unique
  bookLine       BookLine?     @relation(fields: [bookLineId], references: [id], onDelete: SetNull)
  /// AUTO or HAND
  matchedBy      String?
  matchedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@unique([organizationId, accountId, fingerprint])
  @@index([organizationId, accountId, date])
}

enum MixDesignStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum RmcOrderStatus {
  QUOTED
  CONFIRMED
  CLOSED
  CANCELLED
}

enum RmcBatchStatus {
  DISPATCHED
  DELIVERED
  REJECTED
}

enum RmcInvoiceStatus {
  ISSUED
  CANCELLED
}

/// What goes into a cubic metre of a grade at a plant (v6 item 104), approved by quality before it is batched.
model MixDesign {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Project         @relation(fields: [plantId], references: [id], onDelete: Cascade)
  /// M25-OPC-01
  code           String
  grade          String
  description    String?
  slumpMm        Int?
  status         MixDesignStatus @default(DRAFT)
  approvedById   String?
  approvedBy     User?           @relation("MixDesignApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdById    String
  createdBy      User            @relation("MixDesignCreator", fields: [createdById], references: [id])
