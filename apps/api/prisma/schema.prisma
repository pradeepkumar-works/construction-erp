  payrollPaid           PayrollRun[]               @relation("PayrollPayer")
  settlementsPrepared   FinalSettlement[]          @relation("SettlementPreparer")
  biometricDevices      BiometricDevice[]          @relation("BiometricDeviceCreator")
  vouchersPrepared      BookVoucher[]              @relation("BookVoucherPreparer")
  vouchersApproved      BookVoucher[]              @relation("BookVoucherApprover")
  settlementsApproved   FinalSettlement[]          @relation("SettlementApprover")
  staffMarked           StaffAttendance[]          @relation("StaffAttendanceMarker")
  overtimeDecided       StaffAttendance[]          @relation("StaffOvertimeDecider")
  workerDaysMarked      WorkerAttendance[]         @relation("WorkerAttendanceMarker")
  imprestsHeld          Imprest[]                  @relation("ImprestHolder")
  imprestsOpened        Imprest[]                  @relation("ImprestOpener")
  imprestRequests       ImprestEntry[]             @relation("ImprestRequester")
  imprestDecisions      ImprestEntry[]             @relation("ImprestDecider")
  complianceDocs        ComplianceDoc[]
  handoversRecorded     ProjectHandover[]
  defectsReported       Defect[]                   @relation("DefectReporter")
  defectsAssigned       Defect[]                   @relation("DefectAssignee")
  defectsFixed          Defect[]                   @relation("DefectFixer")
  defectsClosed         Defect[]                   @relation("DefectCloser")
  closeoutItemsDone     CloseoutItem[]
  leaveDecided          LeaveRequest[]             @relation("LeaveDecider")
  leaveApplied          LeaveRequest[]             @relation("LeaveApplicant")
  raisedRisks           Risk[]                     @relation("RiskRaiser")
  ownedRisks            Risk[]                     @relation("RiskOwner")
  mixDesignsApproved    MixDesign[]                @relation("MixDesignApprover")
  mixDesignsCreated     MixDesign[]                @relation("MixDesignCreator")
  rmcOrdersCreated      RmcOrder[]                 @relation("RmcOrderCreator")
  rmcBatchesCreated     RmcBatch[]                 @relation("RmcBatchCreator")
  rmcInvoicesCreated    RmcInvoice[]               @relation("RmcInvoiceCreator")
  rmcReceiptsCreated    RmcReceipt[]               @relation("RmcReceiptCreator")
  dispatchesCreated     SupplierDispatch[]         @relation("SupplierDispatchCreator")
  supplierInvoicesSent  SupplierInvoice[]          @relation("SupplierInvoiceSender")
  supplierInvoicesDone  SupplierInvoice[]          @relation("SupplierInvoiceDecider")
  supplierChangesAsked  SupplierChangeRequest[]    @relation("SupplierChangeAsker")
  supplierChangesDone   SupplierChangeRequest[]    @relation("SupplierChangeDecider")
  equipmentLoans        EquipmentLoan[]            @relation("EquipmentLoanCreator")
  loanEmisPaid          LoanEmi[]                  @relation("LoanEmiPayer")
  sorBooksCreated       SorBook[]                  @relation("SorBookCreator")
  scEnquiriesCreated    SubcontractEnquiry[]       @relation("ScEnquiryCreator")
  tendersCreated        Tender[]                   @relation("TenderCreator")
  posAccepted           PurchaseOrder[]            @relation("PoSupplierAccepter")
  wosAccepted           WorkOrder[]                @relation("WoSupplierAccepter")
