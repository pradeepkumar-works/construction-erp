// Construction ERP - MVP data model
// Multi-tenant from day one: every tenant-scoped table carries organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (mirrored as string unions in packages/shared) ----------

enum ProjectType {
  ROAD
  BUILDING
  WATER_SUPPLY
  PLANT
  /// A central store or yard (v6 item 106): holds stock and sends it to sites; no works of its own
  STORE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum MaterialPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// RECEIPT = goods received (GRN) against an approved material request, ISSUE = handed out for use at site,
/// ADJUSTMENT = opening stock or a physical-count correction (either sign).
/// QA/QC's check of material received on a GRN (v4 item 48)
/// How a liquidated damages rate is expressed in the contract (v4 item 50)
enum LdPeriod {
  DAY
  WEEK
  MONTH
}

enum GrnQcStatus {
  ACCEPTED
  PARTLY_ACCEPTED
  REJECTED
}

enum StockEntryType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  /// Sent to another project's store (negative here); received there as TRANSFER_IN
  TRANSFER_OUT
  TRANSFER_IN
  /// Sent back to the supplier (negative)
  RETURN_TO_VENDOR
  /// Issued material that came back to the store unused (positive)
  RETURN_FROM_SITE
}

enum EquipmentOwnership {
