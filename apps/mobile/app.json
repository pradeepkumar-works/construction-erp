{
  "expo": {
    "name": "Nirmaan",
    "slug": "site-app",
    "owner": "pradeepcogitrex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.demo.siteapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFC20E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.demo.siteapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "siteapp",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nirmaan needs access to your photos to attach site pictures to submissions.",
          "cameraPermission": "Nirmaan uses the camera to capture site photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFC20E",
          "defaultChannel": "default"
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1F1E"
    },
    "extra": {
      "eas": {
        "projectId": "88f1b356-d754-47c2-9a27-65bfcbe4a680"
      }
    }
  }
}
